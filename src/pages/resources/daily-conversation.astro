---
// src/pages/resources/streetwise.astro - Clean, Enlarged & Fully Natural Conversations
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Daily Conversations & Phrase Templates — Havie</title>
  <meta name="description" content="Natural phrase templates for ordering food, shopping, getting around, and everyday small talk with Northern and Southern dialects." />

  <!-- CANONICAL URL -->
  <link rel="canonical" href="https://havielearn.com/resources/streetwise" />

  <!-- FAVICON -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts: DM Sans & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #fffaf5;
      --navy: #0f172a;
      --brand-red: #dc2626;
      --orange: #ef7218;
    }

    html {
      scroll-padding-top: 100px;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background-color: var(--cream);
      color: var(--navy);
    }

    .font-brand {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .curved-underline {
      position: relative;
    }
    .curved-underline::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 100%;
      height: 6px;
      border-bottom: 3px solid var(--orange);
      border-radius: 50%;
      transform: rotate(-1.5deg);
    }
  </style>
</head>
<body class="selection:bg-red-600 selection:text-white min-h-screen flex flex-col antialiased relative overflow-x-hidden">

  <!-- BACKGROUND GLOW -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute top-0 right-[15%] w-[450px] h-[450px] bg-gradient-to-br from-amber-400/20 via-red-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute top-40 left-[10%] w-[380px] h-[380px] bg-gradient-to-tr from-amber-200/30 to-transparent rounded-full blur-3xl"></div>
  </div>

  <!-- NAVBAR -->
  <header class="sticky top-0 z-40 bg-[#fffaf5]/90 backdrop-blur-md border-b border-stone-200/80 h-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 h-full flex items-center justify-between">
      
      <!-- LOGO BÊN TRÁI -->
      <a href="/" class="group flex flex-col select-none text-left shrink-0">
        <div class="h-7 sm:h-8 flex items-center">
          <svg class="h-7 sm:h-8 w-auto overflow-visible" viewBox="0 0 175 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 2H6V12H18V2H24V28H18V17H6V28H0V2Z" fill="#dc2626"/>
            <path d="M41 2L52 28H45.5L43.2 22H33.8L31.5 28H25L36 2H41ZM38.5 8.5L35.2 17.5H41.8L38.5 8.5Z" fill="#dc2626"/>
            <path d="M53 2H59.5L67 21L74.5 2H81L70.5 28H63.5L53 2Z" fill="#dc2626"/>
            <path d="M86 2H92V28H86V2Z" fill="#dc2626"/>
            <path d="M98 2H117V7.5H104V12H115V17H104V22.5H117V28H98V2Z" fill="#dc2626"/>
          </svg>
        </div>
        <span class="text-[9.5px] sm:text-[10px] font-bold tracking-[0.22em] sm:tracking-[0.26em] text-stone-400 uppercase mt-1 pl-0.5 leading-none">
          Learn Vietnamese Online
        </span>
      </a>

      <!-- CỤM MENU CHỮ Ở GIỮA -->
      <nav class="hidden md:flex items-center space-x-7 lg:space-x-8 text-base font-bold text-slate-800">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/resources" class="text-red-600 font-brand font-extrabold transition">Resources</a>
        <a href="/student" class="hover:text-red-600 transition">Student Portal</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
      </nav>

      <!-- NÚT BOOK -->
      <div class="hidden md:flex items-center pl-6 shrink-0">
        <button
          type="button"
          class="open-modal-trigger inline-flex items-center justify-center px-5 py-3 text-sm font-extrabold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-lg shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>

      <!-- MOBILE TOGGLE BUTTON -->
      <div class="flex items-center md:hidden">
        <button 
          id="mobileMenuBtn" 
          type="button" 
          aria-label="Toggle Menu"
          class="w-10 h-10 rounded-xl bg-stone-100 hover:bg-stone-200 text-slate-800 flex items-center justify-center font-bold transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobileMenu" class="hidden md:hidden absolute top-20 left-0 w-full bg-[#fffaf5] border-b border-stone-200 shadow-xl px-6 py-5 space-y-4 font-semibold text-slate-800 text-base">
      <a href="/#about" class="mobile-link block hover:text-red-600 transition">About Me</a>
      <a href="/#curriculum" class="mobile-link block hover:text-red-600 transition">Learning Tracks</a>
      <a href="/resources" class="mobile-link block text-red-600 font-bold">Resources</a>
      <a href="/student" class="mobile-link block hover:text-red-600 transition">Student Portal</a>
      <a href="/test" class="mobile-link block hover:text-red-600 transition">Level Test</a>
      <div class="pt-3 border-t border-stone-200">
        <button
          type="button"
          class="open-modal-trigger w-full py-3.5 text-sm font-bold text-white bg-red-600 rounded-xl text-center shadow-md cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="flex-grow py-10 lg:py-14">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 space-y-12">
      
      <!-- HERO HEADER & DIALECT SWITCHER -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-stone-200/80">
        <div class="max-w-2xl space-y-3">
          <span class="text-xs font-extrabold text-orange-600 uppercase tracking-widest bg-amber-50 px-4 py-1.5 rounded-full border border-amber-200 inline-block shadow-2xs font-brand">
            Everyday Life
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-brand pt-1">
            Daily <span class="curved-underline text-orange-600">Conversations.</span>
          </h1>
          <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
            Natural phrase templates for ordering food, shopping, getting around, and everyday small talk with Northern and Southern dialects.
          </p>
        </div>

        <!-- DIALECT SWITCHER -->
        <div class="inline-flex items-center p-1.5 bg-white rounded-2xl border border-stone-200 shadow-xs shrink-0 self-start md:self-auto font-brand">
          <button 
            id="btn-north" 
            onclick="setDialect('north')" 
            class="px-4 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs sm:text-sm transition shadow-xs cursor-pointer"
          >
            🇻🇳 Northern (Hanoi)
          </button>
          <button 
            id="btn-south" 
            onclick="setDialect('south')" 
            class="px-4 py-2.5 rounded-xl text-stone-500 hover:text-slate-900 font-bold text-xs sm:text-sm transition cursor-pointer"
          >
            🇻🇳 Southern (Saigon)
          </button>
        </div>
      </div>

      <!-- CATEGORY TABS & CARDS GRID -->
      <section class="space-y-6">
        <div class="flex items-center gap-3 overflow-x-auto pb-3 scrollbar-none font-brand">
          <button class="cat-filter-btn active px-5 py-3 rounded-2xl text-sm font-bold shrink-0 transition bg-slate-900 text-white cursor-pointer shadow-sm" data-cat="all">All Topics</button>
          <button class="cat-filter-btn px-5 py-3 rounded-2xl text-sm font-bold shrink-0 transition bg-white text-stone-700 border-2 border-stone-200 hover:border-stone-400 cursor-pointer shadow-2xs" data-cat="food">🍜 Ordering Food & Drink</button>
          <button class="cat-filter-btn px-5 py-3 rounded-2xl text-sm font-bold shrink-0 transition bg-white text-stone-700 border-2 border-stone-200 hover:border-stone-400 cursor-pointer shadow-2xs" data-cat="shop">🛍️ Shopping & Prices</button>
          <button class="cat-filter-btn px-5 py-3 rounded-2xl text-sm font-bold shrink-0 transition bg-white text-stone-700 border-2 border-stone-200 hover:border-stone-400 cursor-pointer shadow-2xs" data-cat="transport">🛵 Getting Around</button>
          <button class="cat-filter-btn px-5 py-3 rounded-2xl text-sm font-bold shrink-0 transition bg-white text-stone-700 border-2 border-stone-200 hover:border-stone-400 cursor-pointer shadow-2xs" data-cat="chat">💬 Everyday Small Talk</button>
        </div>

        <!-- Cards Container -->
        <div id="dialogueGrid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Rendered via JS -->
        </div>
      </section>

      <!-- CTA LESSON -->
      <div class="rounded-3xl bg-white p-8 sm:p-10 border border-stone-200/90 shadow-md flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-3 text-center md:text-left max-w-xl">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 text-orange-600 text-sm font-bold tracking-wide border border-orange-100 font-brand">
            <span>🎯 1-on-1 Conversational Coaching</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight font-brand">
            Master Natural Dialogue
          </h2>
          <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
            Practice real-world ordering, market bargaining, and natural small talk through 1-on-1 live roleplay sessions.
          </p>
        </div>
        <div class="shrink-0 w-full md:w-auto text-center font-brand">
          <button
            type="button"
            class="open-modal-trigger inline-flex items-center justify-center px-8 py-4 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-2xl text-base shadow-md transition hover:-translate-y-0.5 cursor-pointer whitespace-nowrap"
          >
            Book Free 25-Min Trial Lesson →
          </button>
        </div>
      </div>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="bg-[#fffaf5] text-stone-600 py-10 border-t border-stone-200/80">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div class="flex items-center justify-center gap-2.5 font-brand">
        <span class="font-black text-slate-900 tracking-wider text-base sm:text-lg">HAVIE</span>
        <span class="text-stone-300">•</span>
        <span class="text-xs sm:text-sm font-medium text-stone-500">Learn Vietnamese with Hang</span>
      </div>
      <div class="flex items-center gap-5 sm:gap-7 font-semibold text-xs sm:text-sm text-stone-700 flex-wrap justify-center font-brand">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/resources" class="hover:text-red-600 transition">Resources</a>
        <a href="/student" class="hover:text-red-600 transition">Student Portal</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        <button type="button" class="open-modal-trigger text-red-600 font-bold hover:underline cursor-pointer">Book Trial</button>
      </div>
    </div>
  </footer>

  <!-- CONSULTATION / BOOKING MODAL -->
  <div id="consultModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-stone-200 space-y-6 text-left">
      
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="text-xs sm:text-sm font-black text-red-600 uppercase tracking-widest bg-red-50 px-3.5 py-1.5 rounded-lg border border-red-200 inline-block font-brand">1-ON-1 LESSONS</span>
          <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-brand mt-1.5">Book 25-Min Trial Lesson</h3>
        </div>
        <button id="closeModalBtn" type="button" class="w-10 h-10 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold flex items-center justify-center text-lg cursor-pointer">
          ✕
        </button>
      </div>

      <form id="consultForm" class="space-y-4 text-sm">
        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Full Name / Tên của bạn *</label>
          <input type="text" id="cName" required placeholder="e.g. Alex Smith" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-800 mb-1.5 text-base">Country / Quốc gia *</label>
            <input type="text" id="cCountry" required placeholder="e.g. Germany, USA" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
          </div>
          <div>
            <label class="block font-bold text-slate-800 mb-1.5 text-base">Phone / SĐT</label>
            <input type="tel" id="cPhone" placeholder="e.g. +49..." class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Email Address *</label>
          <input type="email" id="cEmail" required placeholder="name@example.com" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Learning Goals / Mục tiêu học tập *</label>
          <textarea id="cGoals" rows="3" required placeholder="Current level, target dialect (Hanoi/Saigon), goals..." class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 resize-none text-base"></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-base shadow-md transition cursor-pointer mt-3 font-brand"
        >
          Submit Request to Hang →
        </button>
      </form>

      <div id="successMessage" class="hidden text-center py-6 space-y-3">
        <div class="text-4xl">🎉</div>
        <h4 class="font-black text-slate-900 text-lg font-brand">Request Sent Successfully!</h4>
        <p class="text-stone-600 text-sm leading-relaxed">Thank you! Hang has received your details and goals. She will reach out via email within 24 hours.</p>
        <button id="btnCloseSuccess" type="button" class="px-6 py-3 bg-slate-900 text-white font-bold rounded-xl text-sm cursor-pointer font-brand">
          Close Window
        </button>
      </div>

    </div>
  </div>

  <!-- JAVASCRIPT LOGIC -->
  <script is:inline>
    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });
    }

    // Modal Control Script
    const modal = document.getElementById('consultModal');
    const openTriggers = document.querySelectorAll('.open-modal-trigger');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const consultForm = document.getElementById('consultForm');
    const successMessage = document.getElementById('successMessage');
    const btnCloseSuccess = document.getElementById('btnCloseSuccess');

    openTriggers.forEach(btn => {
      if (btn) {
        btn.addEventListener('click', () => {
          modal.classList.remove('hidden');
          consultForm.classList.remove('hidden');
          successMessage.classList.add('hidden');
          if (mobileMenu) mobileMenu.classList.add('hidden');
        });
      }
    });

    const hideModal = () => {
      modal.classList.add('hidden');
      if (consultForm && successMessage) {
        consultForm.classList.remove('hidden');
        successMessage.classList.add('hidden');
        consultForm.reset();
      }
    };

    if (closeModalBtn) closeModalBtn.addEventListener('click', hideModal);
    if (btnCloseSuccess) closeModalBtn.addEventListener('click', hideModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) hideModal(); });

    // FORM SUBMISSION
    consultForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = consultForm.querySelector('button[type="submit"]');
      if (submitBtn.disabled) return;

      const name = document.getElementById('cName').value;
      const country = document.getElementById('cCountry').value;
      const phone = document.getElementById('cPhone').value;
      const email = document.getElementById('cEmail').value;
      const goals = document.getElementById('cGoals').value;

      const WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbwALyCIFh4XLjpYQCaJxQH3S3krOkcRJERXz9IcAPWpUK3QKOpj583xWw6A31TfgvSDqw/exec'; 
      const payload = { name, country, phone, email, goals };

      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.7';
      submitBtn.style.cursor = 'not-allowed';
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = 'Sending request... ⏳';

      try {
        await fetch(WEB_APP_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: {
            'Content-Type': 'text/plain;charset=utf-8',
          },
          body: JSON.stringify(payload)
        });

        consultForm.classList.add('hidden');
        successMessage.classList.remove('hidden');

      } catch (error) {
        console.error("Error submitting form:", error);
        consultForm.classList.add('hidden');
        successMessage.classList.add('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.style.cursor = 'pointer';
        submitBtn.innerHTML = originalText;
      }
    });

    // ==========================================
    // REVISED NATURAL DIALOGUE DATABASE (100% UNTOUCHED CONTENT)
    // ==========================================
    const dialoguesDatabase = [
      // --- 1. ORDERING FOOD & DRINK ---
      {
        category: "food",
        title: "Ordering Pho",
        prompt: { north: "Em ăn gì?", south: "Em ăn gì?" },
        response: { north: "Cho anh một bát phở bò, không hành nhé.", south: "Cho anh một tô phở bò, không hành nha." },
        translation: "What would you like to eat? ➔ Give me a bowl of beef pho, no green onions please."
      },
      {
        category: "food",
        title: "Ordering Coffee",
        prompt: { north: "Em uống gì?", south: "Em uống gì?" },
        response: { north: "Cho em một cốc cà phê sữa, ít đường nhé.", south: "Cho em một ly cà phê sữa đá, ít đường nha." },
        translation: "What would you like to drink? ➔ Give me an iced milk coffee, less sugar please."
      },
      {
        category: "food",
        title: "Street Snacks",
        prompt: { north: "Mua gì đấy em?", south: "Mua gì đó em?" },
        response: { north: "Cho em hai ổ bánh mì pate, nhiều thịt nhé.", south: "Cho em hai ổ bánh mì pate, nhiều thịt nghen." },
        translation: "What are you buying? ➔ Give me two pate banh mi, extra meat please."
      },
      {
        category: "food",
        title: "Asking for the Bill",
        prompt: { north: "Em ơi, tính tiền nhé.", south: "Em ơi, tính tiền nha." },
        response: { north: "Của chị hết ba mươi nghìn", south: "Của chị hết ba mươi ngàn?" },
        translation: "Check please. ➔ That will be thirty thousand dong."
      },
      {
        category: "food",
        title: "Takeaway Request",
        prompt: { north: "Ăn ở đây hay mang về?", south: "Ăn ở đây hay mang về?" },
        response: { north: "Cho em mang về nhé.", south: "Cho em mang về nha." },
        translation: "Dine in or to go? ➔ Please pack it to go."
      },
      {
        category: "food",
        title: "Asking for Extra Bowl",
        prompt: { north: "Anh/chị cần thêm gì nữa không?", south: "Anh/chị cần thêm gì nữa không?" },
        response: { north: "Cho anh xin thêm một bát con nhé.", south: "Cho anh xin thêm một cái chén nhỏ nha." },
        translation: "Do you need anything else? ➔ Please give me an extra small bowl."
      },
      {
        category: "food",
        title: "Spiciness Preference",
        prompt: { north: "Có ăn được cay không?", south: "Có ăn cay được không?" },
        response: { north: "Cho anh ít ớt thôi nhé.", south: "Cho anh ít ớt thôi nha." },
        translation: "Can you eat spicy food? ➔ Just a little bit of chili for me please."
      },
      {
        category: "food",
        title: "Checking Availability",
        prompt: { north: "Quán còn món này không em?", south: "Quán còn món này không em?" },
        response: { north: "Hết mất rồi anh ạ, gọi món khác nhé.", south: "Hết mất tiêu rồi anh, gọi món khác nha." },
        translation: "Do you still have this dish? ➔ It's sold out, please choose another dish."
      },

      // --- 2. SHOPPING & BARGAINING ---
      {
        category: "shop",
        title: "Asking Prices",
        prompt: { north: "Cái này bao nhiêu tiền?", south: "Cái này bao nhiêu tiền?" },
        response: { north: "Cái này hai trăm nghìn anh ạ.", south: "Cái này hai trăm ngàn nha anh." },
        translation: "How much is this? ➔ This is two hundred thousand dong."
      },
      {
        category: "shop",
        title: "Asking for Color",
        prompt: { north: "Còn màu khác không?", south: "Bên mình còn màu khác không?" },
        response: { north: "Có màu trắng với màu đen anh nhé.", south: "Có màu trắng với màu đen nha anh." },
        translation: "Do you have other colors? ➔ Yes, we have white and black."
      },
      {
        category: "shop",
        title: "Bargaining",
        prompt: { north: "Mua hai cái bớt chút nhé?", south: "Mua hai cái bớt chút nghen?" },
        response: { north: "Bớt cho anh năm mươi nghìn nhé.", south: "Bớt cho anh năm mươi ngàn nha." },
        translation: "If I buy two, can you give a discount? ➔ Let's take off fifty thousand dong."
      },
      {
        category: "shop",
        title: "Looking Around",
        prompt: { north: "Anh cần em tư vấn gì không?", south: "Anh cần em hỗ trợ gì không?" },
        response: { north: "Không, cảm ơn em, anh tự xem nhé.", south: "Không, cảm ơn em, anh tự coi được rồi." },
        translation: "Do you need any assistance? ➔ No thanks, I'm just browsing."
      },
      {
        category: "shop",
        title: "Asking for Payment Methods",
        prompt: { north: "Thanh toán tiền mặt hay chuyển khoản?", south: "Thanh toán tiền mặt hay chuyển khoản anh?" },
        response: { north: "Cho anh chuyển khoản nhé.", south: "Cho anh chuyển khoản nha." },
        translation: "Cash or bank transfer? ➔ I will pay via bank transfer."
      },
      {
        category: "shop",
        title: "Trying Clothes On",
        prompt: { north: "Phòng thử đồ ở đằng kia anh nhé.", south: "Phòng thử đồ ở đằng kia nha anh." },
        response: { north: "Cảm ơn em", south: "Cảm ơn em" },
        translation: "The fitting room is right over there. ➔ Thank you."
      },
      {
        category: "shop",
        title: "Asking for a Bag",
        prompt: { north: "Anh có lấy túi không?", south: "Anh có lấy bịch không?" },
        response: { north: "Có", south: "Có" },
        translation: "Would you like a bag? ➔ Yes, please."
      },
      {
        category: "shop",
        title: "Returning or Exchanging",
        prompt: { north: "Hàng mua rồi có được đổi không em?", south: "Đồ mua rồi có được đổi không em?" },
        response: { north: "Đổi trong vòng ba ngày anh nhé.", south: "Đổi trong vòng ba ngày nha anh." },
        translation: "Can I exchange purchased items? ➔ You can exchange within three days."
      },

      // --- 3. GETTING AROUND & TRANSPORT ---
      {
        category: "transport",
        title: "Taking a Ride",
        prompt: { north: "Anh đi đâu đấy ạ?", south: "Anh đi đâu vậy anh?" },
        response: { north: "Chở anh ra phố đi bộ nhé.", south: "Chở anh ra phố đi bộ nha." },
        translation: "Where are you heading? ➔ Please take me to the walking street."
      },
      {
        category: "transport",
        title: "Asking to Stop",
        prompt: { north: "Đến nơi rồi anh nhé.", south: "Tới nơi rồi nha anh." },
        response: { north: "Cho anh xuống ở đây nhé, cảm ơn em.", south: "Cho anh xuống ở đây nha, cảm ơn em." },
        translation: "We have arrived. ➔ Please let me get off here, thank you."
      },
      {
        category: "transport",
        title: "Asking about Distance",
        prompt: { north: "Từ đây ra đấy có xa không em?", south: "Từ đây ra đó có xa không em?" },
        response: { north: "Khoảng hai cây số thôi anh ạ.", south: "Khoảng hai cây số thôi anh." },
        translation: "Is it far from here? ➔ It's about two kilometers away."
      },
      {
        category: "transport",
        title: "Confirming App Ride",
        prompt: { north: "Anh đặt xe phải không?", south: "Anh đặt xe đúng không?" },
        response: { north: "Đúng rồi em, anh đây.", south: "Đúng rồi em ơi, anh đây nè." },
        translation: "Did you book the ride? ➔ Yes that's me, right here."
      },
      {
        category: "transport",
        title: "Asking to Turn on AC",
        prompt: { north: "Lên xe đi anh.", south: "Lên xe đi anh." },
        response: { north: "Mở điều hòa giúp anh nhé.", south: "Mở máy lạnh giùm anh nha." },
        translation: "Hop in. ➔ Please turn on the AC for me."
      },
      {
        category: "transport",
        title: "Asking for Fare",
        prompt: { north: "Đến nơi rồi anh nhé.", south: "Tới nơi rồi anh ơi." },
        response: { north: "Hết bao nhiêu tiền vậy em?", south: "Hết bao nhiêu tiền vậy em?" },
        translation: "We've arrived. ➔ How much is the fare?"
      },
      {
        category: "transport",
        title: "Waiting for Grab",
        prompt: { north: "Anh đang đứng ở đâu thế?", south: "Anh đang đứng ở đâu vậy?" },
        response: { north: "Anh đang đứng trước cửa hàng tiện lợi nhé.", south: "Anh đang đứng trước cửa hàng tiện lợi nha." },
        translation: "Where are you standing? ➔ I'm standing in front of the convenience store."
      },
      {
        category: "transport",
        title: "Asking about Traffic",
        prompt: { north: "Đường phía trước có bị tắc không em?", south: "Đường phía trước có bị kẹt không em?" },
        response: { north: "Đang hơi tắc một chút ở ngã tư anh ạ.", south: "Đang hơi kẹt xe một chút ở ngã tư anh." },
        translation: "Is the road ahead jammed? ➔ It's a bit congested at the intersection ahead."
      },

      // --- 4. EVERYDAY SMALL TALK ---
      {
        category: "chat",
        title: "Making Plans",
        prompt: { north: "Hôm nào rảnh đi cà phê nhé?", south: "Hôm nào rảnh đi cà phê nghen?" },
        response: { north: "Ừ, cuối tuần này đi nhé!", south: "Ừ, cuối tuần này đi nha!" },
        translation: "Let's grab coffee sometime when you're free? ➔ Sure, let's go this weekend!"
      },
      {
        category: "chat",
        title: "Asking About Work",
        prompt: { north: "Công việc dạo này bận không?", south: "Công việc dạo này bận không?" },
        response: { north: "Anh hơi nhiều việc.", south: "Anh hơi nhiều việc." },
        translation: "Have you been busy with work lately? ➔ I've been quite busy."
      },
      {
        category: "chat",
        title: "Talking About Weather",
        prompt: { north: "Hôm nay trời nóng nhỉ?", south: "Hôm nay trời nóng quá ha?" },
        response: { north: "Ừ, nắng gắt từ sáng đến giờ.", south: "Đúng rồi, oi từ sáng tới giờ." },
        translation: "It's hot today, isn't it? ➔ Yes, it's been scorching since morning."
      },
      {
        category: "chat",
        title: "Asking for Opinions",
        prompt: { north: "Anh thấy món này thế nào?", south: "Anh thấy món này sao?" },
        response: { north: "Anh thấy rất ngon.", south: "Anh thấy rất ngon." },
        translation: "What do you think of this dish? ➔ I think it's very delicious."
      },
      {
        category: "chat",
        title: "Saying Goodbye",
        prompt: { north: "Thế nhé, anh về trước đây.", south: "Thôi nha, anh về trước đây." },
        response: { north: "Ừ, về cẩn thận nhé!", south: "Ừ, về cẩn thận nha!" },
        translation: "Alright, I'm heading home now. ➔ Okay, get home safely!"
      },
      {
        category: "chat",
        title: "Asking for Help",
        prompt: { north: "Giúp anh việc này một tí được không?", south: "Giúp anh việc này một chút được không?" },
        response: { north: "Được chứ, việc gì thế anh?", south: "Được chứ, chuyện gì vậy anh?" },
        translation: "Can you help me with this for a moment? ➔ Sure, what is it?"
      },
      {
        category: "chat",
        title: "Expressing Surprise",
        prompt: { north: "Thật á? Không ngờ luôn.", south: "Thật luôn hả? Bất ngờ ghê." },
        response: { north: "Thật chứ, anh vừa nghe xong.", south: "Thật chứ, anh mới nghe hồi nãy." },
        translation: "Really? I can't believe it. ➔ True, I just heard about it."
      }
    ];

    let currentDialect = 'north';
    let currentCat = 'all';

    function setDialect(d) {
      currentDialect = d;
      document.getElementById('btn-north').className = d === 'north' ? 'px-4 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs sm:text-sm transition shadow-xs cursor-pointer font-brand' : 'px-4 py-2.5 rounded-xl text-stone-500 hover:text-slate-900 font-bold text-xs sm:text-sm transition cursor-pointer font-brand';
      document.getElementById('btn-south').className = d === 'south' ? 'px-4 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs sm:text-sm transition shadow-xs cursor-pointer font-brand' : 'px-4 py-2.5 rounded-xl text-stone-500 hover:text-slate-900 font-bold text-xs sm:text-sm transition cursor-pointer font-brand';
      renderDialogues();
    }

    function renderDialogues() {
      const grid = document.getElementById('dialogueGrid');
      grid.innerHTML = '';

      const filtered = currentCat === 'all' 
        ? dialoguesDatabase 
        : dialoguesDatabase.filter(item => item.category === currentCat);

      filtered.forEach(item => {
        const card = document.createElement('div');
        card.className = 'bg-white rounded-3xl p-6 sm:p-7 border border-stone-200/90 shadow-2xs space-y-4 flex flex-col justify-between hover:border-stone-400 transition';

        let catLabel = "Food & Drink";
        let catStyle = "bg-amber-50 text-amber-800 border-amber-200";
        if (item.category === "shop") { catLabel = "Shopping"; catStyle = "bg-purple-50 text-purple-800 border-purple-200"; }
        else if (item.category === "transport") { catLabel = "Transport"; catStyle = "bg-emerald-50 text-emerald-800 border-emerald-200"; }
        else if (item.category === "chat") { catLabel = "Small Talk"; catStyle = "bg-blue-50 text-blue-800 border-blue-200"; }

        card.innerHTML = `
          <div class="space-y-3.5">
            <div class="flex items-center justify-between pb-3 border-b border-stone-100">
              <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-md border ${catStyle}">
                ${catLabel}
              </span>
              <span class="text-xs font-semibold text-stone-400">${item.title}</span>
            </div>

            <div>
              <span class="text-[10px] font-bold text-stone-400 uppercase tracking-wider block">Prompt:</span>
              <div class="text-base sm:text-lg font-semibold text-slate-900 mt-1 not-italic">“${item.prompt[currentDialect]}”</div>
            </div>

            <div class="p-4 sm:p-5 rounded-2xl bg-[#fffaf5] border border-stone-200/80 space-y-1.5">
              <span class="text-[10px] font-bold text-orange-600 uppercase tracking-wider block">Natural Response:</span>
              <div class="text-lg sm:text-xl font-bold text-slate-900 not-italic">“${item.response[currentDialect]}”</div>
              <div class="text-xs sm:text-sm text-stone-500 font-normal mt-1.5 not-italic">“${item.translation}”</div>
            </div>
          </div>
        `;

        grid.appendChild(card);
      });
    }

    document.querySelectorAll('.cat-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.cat-filter-btn').forEach(b => {
          b.classList.remove('active', 'bg-slate-900', 'text-white');
          b.classList.add('bg-white', 'text-stone-700', 'border-2', 'border-stone-200');
        });
        btn.classList.add('active', 'bg-slate-900', 'text-white');
        btn.classList.remove('bg-white', 'text-stone-700', 'border-2', 'border-stone-200');
        currentCat = btn.getAttribute('data-cat');
        renderDialogues();
      });
    });

    // Initial Render
    renderDialogues();
  </script>
</body>
</html>