    function updateSandboxDisplay() {
      const partsVi = [];
      const partsEn = [];

      Object.keys(sandboxVocab).forEach(key => {
        const selectedObj = sandboxVocab[key][currentSandbox[key]] || sandboxVocab[key][0];
        const labelEl = document.getElementById(`label-${key}`);
        if (labelEl) {
          labelEl.textContent = selectedObj.vi || "🚫 None";
          if (!selectedObj.vi) {
            labelEl.classList.add('text-stone-400');
            labelEl.classList.remove('text-slate-900');
          } else {
            labelEl.classList.remove('text-stone-400');
            labelEl.classList.add('text-slate-900');
          }
        }

        if (selectedObj.vi) partsVi.push(selectedObj.vi);
        if (selectedObj.en) partsEn.push(selectedObj.en);
      });

      sandboxVietEl.textContent = partsVi.length > 0 ? `“${partsVi.join(' ')}”` : "“...”";
      sandboxEngEl.textContent = partsEn.length > 0 ? `“${partsEn.join(' ')}”` : "“...”";
    }

