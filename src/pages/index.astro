  <!-- SCRIPTS -->
  <script is:inline>
    let heroAudioCtx = null;
    let heroSourceNode = null;
    let heroGainNode = null;
    let isHeroAudioLoaded = false;
    let heroAudioBuffer = null;

    const heroTimestamps = {
      ngang: { start: 0.55, end: 1.45 },
      sac:   { start: 1.85, end: 2.75 },
      hoi:   { start: 4.55, end: 5.45 }
    };

    async function initHeroAudio() {
      if (isHeroAudioLoaded) return;
      try {
        heroAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const response = await fetch('/audio/tones/ma-all.m4a');
        const arrayBuffer = await response.arrayBuffer();
        heroAudioBuffer = await heroAudioCtx.decodeAudioData(arrayBuffer);
        isHeroAudioLoaded = true;
      } catch (e) {
        console.log("Web Audio init error:", e);
      }
    }

    async function playHeroAudio(toneKey) {
      if (!isHeroAudioLoaded) {
        await initHeroAudio();
      }
      if (!heroAudioCtx || !heroAudioBuffer) return;

      if (heroAudioCtx.state === 'suspended') {
        await heroAudioCtx.resume();
      }

      if (heroSourceNode) {
        try { heroSourceNode.stop(); } catch(e) {}
      }

      const range = heroTimestamps[toneKey];
      if (!range) return;

      heroSourceNode = heroAudioCtx.createBufferSource();
      heroSourceNode.buffer = heroAudioBuffer;

      heroGainNode = heroAudioCtx.createGain();
      heroGainNode.gain.value = 2.5; 

      heroSourceNode.connect(heroGainNode);
      heroGainNode.connect(heroAudioCtx.destination);

      const duration = range.end - range.start;
      heroSourceNode.start(0, range.start, duration);
    }

    document.addEventListener('click', () => {
      if (!isHeroAudioLoaded) {
        initHeroAudio();
      }
    }, { once: true });

    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });
    }

    const track = document.getElementById('reviewTrack');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    if (track && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => track.scrollBy({ left: -320, behavior: 'smooth' }));
      nextBtn.addEventListener('click', () => track.scrollBy({ left: 320, behavior: 'smooth' }));
    }

    // Modal Control Script
    const modal = document.getElementById('consultModal');
    const openTriggers = document.querySelectorAll('.open-modal-trigger');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const consultForm = document.getElementById('consultForm');
    const successMessage = document.getElementById('successMessage');
    const btnCloseSuccess = document.getElementById('btnCloseSuccess');

    openTriggers.forEach(btn => {
      if (btn) {
        btn.addEventListener('click', () => {
          modal.classList.remove('hidden');
          consultForm.classList.remove('hidden');
          successMessage.classList.add('hidden');
          if (mobileMenu) mobileMenu.classList.add('hidden');
        });
      }
    });

    const hideModal = () => modal.classList.add('hidden');
    if (closeModalBtn) closeModalBtn.addEventListener('click', hideModal);
    if (btnCloseSuccess) closeModalBtn.addEventListener('click', hideModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) hideModal(); });

    consultForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = {
        name: document.getElementById('cName').value,
        country: document.getElementById('cCountry').value,
        phone: document.getElementById('cPhone').value,
        email: document.getElementById('cEmail').value,
        goals: document.getElementById('cGoals').value,
      };
      console.log("Consultation Booking Submitted:", formData);

      consultForm.classList.add('hidden');
      successMessage.classList.remove('hidden');
      consultForm.reset();
    });
  </script>
