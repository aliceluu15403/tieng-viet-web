---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Vietnamese Pronouns | Havie" 
  description="Interactive Vietnamese pronoun matrix calculator. Determine whether to use Anh, Chị, Em, or Cô/Chú based on age and social context, with Northern and Southern audio."
  canonical="https://havielearn.com/resources/pronouns"
>
  <!-- BACKGROUND GLOW -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute top-0 right-[15%] w-[450px] h-[450px] bg-gradient-to-br from-amber-400/20 via-red-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute top-40 left-[10%] w-[380px] h-[380px] bg-gradient-to-tr from-amber-200/30 to-transparent rounded-full blur-3xl"></div>
  </div>

  <!-- NAVBAR -->
  <header class="sticky top-0 z-40 bg-[#fffaf5]/90 backdrop-blur-md border-b border-stone-200/80 h-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 h-full flex items-center justify-between">
      
      <!-- LOGO BÊN TRÁI -->
      <a href="/" class="group flex flex-col select-none text-left shrink-0">
        <div class="h-7 sm:h-8 flex items-center">
          <svg class="h-7 sm:h-8 w-auto overflow-visible" viewBox="0 0 175 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 2H6V12H18V2H24V28H18V17H6V28H0V2Z" fill="#dc2626"/>
            <path d="M41 2L52 28H45.5L43.2 22H33.8L31.5 28H25L36 2H41ZM38.5 8.5L35.2 17.5H41.8L38.5 8.5Z" fill="#dc2626"/>
            <path d="M53 2H59.5L67 21L74.5 2H81L70.5 28H63.5L53 2Z" fill="#dc2626"/>
            <path d="M86 2H92V28H86V2Z" fill="#dc2626"/>
            <path d="M98 2H117V7.5H104V12H115V17H104V22.5H117V28H98V2Z" fill="#dc2626"/>
          </svg>
        </div>
        <span class="text-[9.5px] sm:text-[10px] font-bold tracking-[0.22em] sm:tracking-[0.26em] text-stone-400 uppercase mt-1 pl-0.5 leading-none">
          Learn Vietnamese Online
        </span>
      </a>

      <!-- CỤM MENU CHỮ Ở GIỮA -->
      <nav class="hidden md:flex items-center space-x-7 lg:space-x-8 text-base font-bold text-slate-800">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/resources" class="text-red-600 font-brand font-extrabold transition">Resources</a>
        <a href="/student" class="hover:text-red-600 transition">Student Portal</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
      </nav>

      <!-- NÚT BOOK -->
      <div class="hidden md:flex items-center pl-6 shrink-0">
        <button
          type="button"
          class="open-modal-trigger inline-flex items-center justify-center px-5 py-3 text-sm font-extrabold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-lg shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>

      <!-- MOBILE TOGGLE BUTTON -->
      <div class="flex items-center md:hidden">
        <button 
          id="mobileMenuBtn" 
          type="button" 
          aria-label="Toggle Menu"
          class="w-10 h-10 rounded-xl bg-stone-100 hover:bg-stone-200 text-slate-800 flex items-center justify-center font-bold transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobileMenu" class="hidden md:hidden absolute top-20 left-0 w-full bg-[#fffaf5] border-b border-stone-200 shadow-xl px-6 py-5 space-y-4 font-semibold text-slate-800 text-base">
      <a href="/#about" class="mobile-link block hover:text-red-600 transition">About Me</a>
      <a href="/#curriculum" class="mobile-link block hover:text-red-600 transition">Learning Tracks</a>
      <a href="/resources" class="mobile-link block text-red-600 font-bold">Resources</a>
      <a href="/student" class="mobile-link block hover:text-red-600 transition">Student Portal</a>
      <a href="/test" class="mobile-link block hover:text-red-600 transition">Level Test</a>
      <div class="pt-3 border-t border-stone-200">
        <button
          type="button"
          class="open-modal-trigger w-full py-3.5 text-sm font-bold text-white bg-red-600 rounded-xl text-center shadow-md cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="flex-grow py-8 lg:py-12">
    <div class="max-w-5xl mx-auto px-5 sm:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
        <span class="text-xs font-extrabold text-red-600 uppercase tracking-widest bg-red-50 px-3.5 py-1.5 rounded-full border border-red-200 inline-block shadow-2xs">
          Pronoun Matrix
        </span>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-2.5 tracking-tight font-brand">
          Vietnamese <span class="curved-underline text-red-600">Pronoun Calculator.</span>
        </h1>
        <p class="text-stone-600 text-sm sm:text-base mt-3 leading-relaxed max-w-lg mx-auto">
          Avoid translation words like <em class="text-slate-900 font-semibold">Tôi / Bạn</em> in daily speech. Proper pronouns build instant emotional connection and cultural warmth.
        </p>
      </div>

      <!-- Main Tool Box -->
      <div class="bg-white rounded-3xl p-5 sm:p-8 lg:p-10 shadow-md border border-stone-200/90 relative space-y-6">
        
        <!-- STEP 1: SOCIAL CONTEXT -->
        <div class="pb-6 border-b border-stone-100">
          <label class="block text-xs sm:text-sm font-extrabold uppercase tracking-wider text-stone-500 mb-3">
            Step 1: Choose Your Social Setting
          </label>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <button 
              type="button" 
              data-context-btn="street"
              class="context-card active p-4 rounded-2xl border text-left transition cursor-pointer border-red-600 bg-red-50/60 shadow-2xs flex flex-col justify-between"
            >
              <div>
                <span class="block text-lg mb-1">☕</span>
                <span class="block text-sm sm:text-base font-extrabold text-slate-900 leading-snug">Casual / Street / Cafe</span>
              </div>
              <span class="block text-xs text-stone-500 mt-1.5 font-medium">Cafes, restaurants, street vendors, peers</span>
            </button>
            <button 
              type="button" 
              data-context-btn="work"
              class="context-card p-4 rounded-2xl border text-left transition cursor-pointer border-stone-200 bg-white hover:border-stone-300 flex flex-col justify-between"
            >
              <div>
                <span class="block text-lg mb-1">💼</span>
                <span class="block text-sm sm:text-base font-extrabold text-slate-800 leading-snug">Workplace / Professional</span>
              </div>
              <span class="block text-xs text-stone-500 mt-1.5 font-medium">Colleagues, managers, meetings</span>
            </button>
            <button 
              type="button" 
              data-context-btn="family"
              class="context-card p-4 rounded-2xl border text-left transition cursor-pointer border-stone-200 bg-white hover:border-stone-300 flex flex-col justify-between"
            >
              <div>
                <span class="block text-lg mb-1">🏡</span>
                <span class="block text-sm sm:text-base font-extrabold text-slate-800 leading-snug">Partner’s Family (In-Laws)</span>
              </div>
              <span class="block text-xs text-stone-500 mt-1.5 font-medium">Complex family trees & relatives</span>
            </button>
          </div>
        </div>

        <!-- STEP 2: CALCULATOR INTERACTIVE AREA -->
        <div id="calculatorInteractiveArea" class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
          
          <!-- Controls Column -->
          <div class="lg:col-span-5 flex flex-col justify-between space-y-5 lg:border-r lg:border-stone-100 lg:pr-6 bg-stone-50/40 p-5 sm:p-6 rounded-2xl border border-stone-200/80">
            
            <div class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-stone-500">
              Step 2: Set Ages & Genders
            </div>

            <!-- Speaker Profile -->
            <div class="space-y-3">
              <div class="flex items-center justify-between text-sm sm:text-base font-extrabold text-slate-900">
                <span class="whitespace-nowrap">Your Age <span class="text-stone-400 font-bold text-xs">(Speaker)</span></span>
                <span id="ageDisplay" class="px-3 py-1 rounded-lg bg-red-50 text-red-600 font-mono text-sm font-black border border-red-100 shadow-2xs min-w-[75px] text-center whitespace-nowrap">28 yrs</span>
              </div>
              <input 
                id="userAge" 
                type="range" 
                min="10" 
                max="85" 
                value="28" 
                class="w-full accent-red-600 h-2 bg-stone-200/70 rounded-lg cursor-pointer"
              />
              
              <div class="pt-1">
                <span class="block text-xs sm:text-sm font-bold text-stone-700 mb-2">Your Gender</span>
                <div class="grid grid-cols-2 gap-2.5">
                  <button 
                    type="button" 
                    data-my-gender="male"
                    class="my-gender-btn active px-3 py-2.5 rounded-xl border text-sm font-extrabold text-center transition flex items-center justify-center gap-1.5 border-red-600 bg-red-50 text-red-600 cursor-pointer shadow-2xs"
                  >
                    <span>👨 Male</span>
                  </button>
                  <button 
                    type="button" 
                    data-my-gender="female"
                    class="my-gender-btn px-3 py-2.5 rounded-xl border text-sm font-extrabold text-center transition flex items-center justify-center gap-1.5 border-stone-200 bg-white text-stone-700 hover:border-stone-300 cursor-pointer"
                  >
                    <span>👩 Female</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Listener Profile -->
            <div class="space-y-3 pt-3 border-t border-stone-200/60">
              <div class="flex items-center justify-between text-sm sm:text-base font-extrabold text-slate-900">
                <span class="whitespace-nowrap">Their Age <span class="text-stone-400 font-bold text-xs">(Listener)</span></span>
                <span id="theirAgeDisplay" class="px-3 py-1 rounded-lg bg-slate-100 text-slate-900 font-mono text-sm font-black border border-stone-200 shadow-2xs min-w-[75px] text-center whitespace-nowrap">35 yrs</span>
              </div>
              <input 
                id="theirAge" 
                type="range" 
                min="5" 
                max="85" 
                value="35" 
                class="w-full accent-slate-800 h-2 bg-stone-200/70 rounded-lg cursor-pointer"
              />

              <div class="pt-1">
                <span class="block text-xs sm:text-sm font-bold text-stone-700 mb-2">Their Gender</span>
                <div class="grid grid-cols-2 gap-2.5">
                  <button 
                    type="button" 
                    data-their-gender="male"
                    class="their-gender-btn active px-3 py-2.5 rounded-xl border text-sm font-extrabold text-center transition flex items-center justify-center gap-1.5 border-slate-900 bg-slate-100 text-slate-900 cursor-pointer shadow-2xs"
                  >
                    <span>👨 Male</span>
                  </button>
                  <button 
                    type="button" 
                    data-their-gender="female"
                    class="their-gender-btn px-3 py-2.5 rounded-xl border text-sm font-extrabold text-center transition flex items-center justify-center gap-1.5 border-stone-200 bg-white text-stone-700 hover:border-stone-300 cursor-pointer"
                  >
                    <span>👩 Female</span>
                  </button>
                </div>
              </div>
            </div>

          </div>

          <!-- Result Column -->
          <div id="calculatorResultCol" class="lg:col-span-7 flex flex-col justify-between space-y-5 bg-stone-50/60 p-5 sm:p-6 rounded-2xl border border-stone-200/80">
            <div class="space-y-5">
              <div class="flex items-center justify-between pb-3 border-b border-stone-200/60">
                <div class="flex items-center gap-2.5">
                  <span class="text-sm font-bold text-stone-700">Accent:</span>
                  <select id="voiceRegionSelect" class="text-sm font-bold bg-white border border-stone-300 rounded-lg px-3 py-1.5 outline-none cursor-pointer">
                    <option value="n">Northern (Hanoi)</option>
                    <option value="s">Southern (Saigon)</option>
                  </select>
                </div>
              </div>

              <!-- Pair Display Grid -->
              <div class="grid grid-cols-2 gap-4 items-stretch">
                <!-- Self -->
                <div class="p-5 rounded-2xl bg-white border border-stone-200/90 text-center flex flex-col justify-center shadow-xs">
                  <span class="text-xs uppercase font-extrabold tracking-wider text-stone-400 block mb-1.5">
                    "I"
                  </span>
                  <div class="flex items-center justify-center gap-2">
                    <span id="selfPronoun" class="text-xl sm:text-2xl font-bold font-brand text-slate-900 tracking-tight">
                      Em
                    </span>
                    <button type="button" id="speakSelfBtn" title="Listen Pronunciation" class="w-8 h-8 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-700 flex items-center justify-center text-sm cursor-pointer transition shadow-2xs">
                      🔊
                    </button>
                  </div>
                </div>

                <!-- Them -->
                <div class="p-5 rounded-2xl bg-red-50 border border-red-200 text-center flex flex-col justify-center shadow-xs">
                  <span class="text-xs uppercase font-extrabold tracking-wider text-red-500 block mb-1.5">
                    "YOU"
                  </span>
                  <div class="flex items-center justify-center gap-2">
                    <span id="themPronoun" class="text-xl sm:text-2xl font-bold font-brand text-red-600 tracking-tight">
                      Anh
                    </span>
                    <button type="button" id="speakThemBtn" title="Listen Pronunciation" class="w-8 h-8 rounded-full bg-red-100 hover:bg-red-200 text-red-600 flex items-center justify-center text-sm cursor-pointer transition shadow-2xs">
                      🔊
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Context Tip -->
            <div class="bg-white rounded-xl p-4 border border-stone-200/90 flex items-start gap-3 shadow-2xs">
              <span class="text-xl shrink-0 mt-0.5">💡</span>
              <p id="pairExplanation" class="text-sm sm:text-base text-stone-700 leading-relaxed font-medium">
                In casual social settings, whether they are slightly older or the exact same age, out of polite respect you call yourself <strong>Em</strong> and address them as <strong>Anh / Chị</strong>.
              </p>
            </div>
          </div>

          <!-- Family Course Banner -->
          <div id="familyCourseBanner" class="hidden lg:col-span-12 bg-gradient-to-r from-red-50 via-amber-50/40 to-white rounded-2xl p-6 sm:p-8 border border-red-200/80 text-center space-y-3 shadow-sm">
            <span class="text-xs font-black text-red-600 uppercase tracking-widest bg-white px-4 py-1.5 rounded-full border border-red-200 inline-block shadow-2xs">
              🏡 In-Law Family Tree Masterclass
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-brand">
              Navigating Vietnamese Family Titles is Complex!
            </h3>
            <p class="text-stone-700 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
              Family trees in Vietnam involve intricate generational ranks, maternal/paternal distinctions (bên nội/bên ngoại), and regional nuances. Don't guess—master it step-by-step with expert lessons.
            </p>
            <div class="pt-2">
              <button
                type="button"
                class="open-modal-trigger px-7 py-3 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-sm shadow-md transition hover:-translate-y-0.5 cursor-pointer inline-flex items-center gap-2"
              >
                <span>Book Lessons to Master Family Tree</span>
                <span>→</span>
              </button>
            </div>
          </div>

        </div>

      </div>

      <!-- REFINED CTA SECTION -->
      <div class="mt-8 rounded-3xl bg-white p-6 sm:p-8 border border-stone-200/90 shadow-md flex flex-col md:flex-row items-center justify-between gap-5">
        <div class="space-y-2 text-center md:text-left max-w-lg">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-50 text-red-600 text-xs font-bold tracking-wide border border-red-100">
            <span>🎯 1-on-1 Pronoun & Nuance Mastery</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight font-brand">
            Speak like a Vietnamese?
          </h2>
          <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
            Pronouns change depending on age, gender, relationship, and situation. Learn how to choose the right words with a native speaker.
          </p>
        </div>
        <div class="shrink-0 w-full md:w-auto text-center">
          <button
            type="button"
            class="open-modal-trigger inline-flex items-center justify-center px-6 py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl text-base shadow-md transition hover:-translate-y-0.5 cursor-pointer whitespace-nowrap"
          >
            Book a Trial Lesson →
          </button>
        </div>
      </div>

    </div>
  </main>

<!-- FOOTER -->
  <footer class="bg-[#fffaf5] text-stone-600 py-10 border-t border-stone-200/80">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div class="flex items-center justify-center gap-2.5">
        <span class="font-brand font-black text-slate-900 tracking-wider text-base sm:text-lg">HAVIE</span>
        <span class="text-stone-300">•</span>
        <span class="text-xs sm:text-sm font-medium text-stone-500">Learn Vietnamese with Hang</span>
      </div>
      <div class="flex items-center gap-5 sm:gap-7 font-semibold text-xs sm:text-sm text-stone-700 flex-wrap justify-center">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/resources" class="hover:text-red-600 transition">Resources</a>
        <a href="/student" class="hover:text-red-600 transition">Student Portal</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        <button type="button" class="open-modal-trigger text-red-600 font-bold hover:underline cursor-pointer">Book Trial</button>
      </div>
    </div>
  </footer>
  
  <!-- CONSULTATION / BOOKING MODAL -->
  <div id="consultModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-stone-200 space-y-6 text-left">
      
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="text-xs sm:text-sm font-black text-red-600 uppercase tracking-widest bg-red-50 px-3.5 py-1.5 rounded-lg border border-red-200 inline-block font-brand">1-ON-1 LESSONS</span>
          <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-brand mt-1.5">Book 25-Min Trial Lesson</h3>
        </div>
        <button id="closeModalBtn" type="button" class="w-10 h-10 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold flex items-center justify-center text-lg cursor-pointer">
          ✕
        </button>
      </div>

      <form id="consultForm" class="space-y-4 text-sm">
        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Full Name / Tên của bạn *</label>
          <input type="text" id="cName" required placeholder="e.g. Alex Smith" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-800 mb-1.5 text-base">Country / Quốc gia *</label>
            <input type="text" id="cCountry" required placeholder="e.g. Germany, USA" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
          </div>
          <div>
            <label class="block font-bold text-slate-800 mb-1.5 text-base">Phone / SĐT</label>
            <input type="tel" id="cPhone" placeholder="e.g. +49..." class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Email Address *</label>
          <input type="email" id="cEmail" required placeholder="name@example.com" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Learning Goals / Mục tiêu học tập *</label>
          <textarea id="cGoals" rows="3" required placeholder="Current level, target dialect (Hanoi/Saigon), goals..." class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 resize-none text-base"></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-base shadow-md transition cursor-pointer mt-3"
        >
          Submit Request to Hang →
        </button>
      </form>

      <div id="successMessage" class="hidden text-center py-6 space-y-3">
        <div class="text-4xl">🎉</div>
        <h4 class="font-black text-slate-900 text-lg font-brand">Request Sent Successfully!</h4>
        <p class="text-stone-600 text-sm leading-relaxed">Thank you! Hang has received your details and goals. She will reach out via email within 24 hours.</p>
        <button id="btnCloseSuccess" type="button" class="px-6 py-3 bg-slate-900 text-white font-bold rounded-xl text-sm cursor-pointer">
          Close Window
        </button>
      </div>

    </div>
  </div>

  <!-- SCRIPTS -->
  <script is:inline>
    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });
    }

    // Modal Control Script
    const modal = document.getElementById('consultModal');
    const openTriggers = document.querySelectorAll('.open-modal-trigger');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const consultForm = document.getElementById('consultForm');
    const successMessage = document.getElementById('successMessage');
    const btnCloseSuccess = document.getElementById('btnCloseSuccess');

    openTriggers.forEach(btn => {
      if (btn) {
        btn.addEventListener('click', () => {
          modal.classList.remove('hidden');
          consultForm.classList.remove('hidden');
          successMessage.classList.add('hidden');
          if (mobileMenu) mobileMenu.classList.add('hidden');
        });
      }
    });

    const hideModal = () => {
      modal.classList.add('hidden');
      if (consultForm && successMessage) {
        consultForm.classList.remove('hidden');
        successMessage.classList.add('hidden');
        consultForm.reset();
      }
    };

    if (closeModalBtn) closeModalBtn.addEventListener('click', hideModal);
    if (btnCloseSuccess) closeModalBtn.addEventListener('click', hideModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) hideModal(); });

    // FORM SUBMISSION (Google Sheets)
    consultForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = consultForm.querySelector('button[type="submit"]');
      if (submitBtn.disabled) return;

      const name = document.getElementById('cName').value;
      const country = document.getElementById('cCountry').value;
      const phone = document.getElementById('cPhone').value;
      const email = document.getElementById('cEmail').value;
      const goals = document.getElementById('cGoals').value;

      const WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbwALyCIFh4XLjpYQCaJxQH3S3krOkcRJERXz9IcAPWpUK3QKOpj583xWw6A31TfgvSDqw/exec'; 
      const payload = { name, country, phone, email, goals };

      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.7';
      submitBtn.style.cursor = 'not-allowed';
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = 'Sending request... ⏳';

      try {
        await fetch(WEB_APP_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: {
            'Content-Type': 'text/plain;charset=utf-8',
          },
          body: JSON.stringify(payload)
        });

        consultForm.classList.add('hidden');
        successMessage.classList.remove('hidden');

      } catch (error) {
        console.error("Error submitting form:", error);
        consultForm.classList.add('hidden');
        successMessage.classList.add('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.style.cursor = 'pointer';
        submitBtn.innerHTML = originalText;
      }
    });

    // --- HỆ THỐNG XỬ LÝ KHÔNG DẤU CHO AUDIO ---
    function removeDiacritics(str) {
      return str.normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .replace(/Đ/g, 'D')
                .toLowerCase()
                .trim();
    }

    // --- HỆ THỐNG PHÁT ÂM TỪ THƯ MỤC MP3 CỤC BỘ ---
    function playPronounAudio(wordText) {
      if (!wordText) return;
      
      const cleanWord = removeDiacritics(wordText); 
      const region = document.getElementById('voiceRegionSelect').value; // 'n' hoặc 's'
      
      const audioPath = `/audio/pronouns/${cleanWord} - ${region}.mp3`;
      
      const audio = new Audio(audioPath);
      audio.play().catch(err => {
        console.warn(`Không tìm thấy file audio cho: ${audioPath}`, err);
      });
    }

    let myGender = 'male';
    let theirGender = 'male';
    let currentContext = 'street';

    const userAgeInput = document.getElementById('userAge');
    const ageDisplay = document.getElementById('ageDisplay');
    const theirAgeInput = document.getElementById('theirAge');
    const theirAgeDisplay = document.getElementById('theirAgeDisplay');

    const selfPronounEl = document.getElementById('selfPronoun');
    const themPronounEl = document.getElementById('themPronoun');
    const pairExplanationEl = document.getElementById('pairExplanation');

    const controlsCol = document.getElementById('calculatorInteractiveArea').children[0];
    const resultCol = document.getElementById('calculatorResultCol');
    const familyBanner = document.getElementById('familyCourseBanner');

    // 1. Social Context Filter Buttons
    document.querySelectorAll('[data-context-btn]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-context-btn]').forEach(b => {
          b.classList.remove('active', 'border-red-600', 'bg-red-50/60');
          b.classList.add('border-stone-200', 'bg-white');
        });
        btn.classList.add('active', 'border-red-600', 'bg-red-50/60');
        btn.classList.remove('border-stone-200', 'bg-white');
        currentContext = btn.getAttribute('data-context-btn');

        if (currentContext === 'family') {
          controlsCol.classList.add('hidden');
          resultCol.classList.add('hidden');
          familyBanner.classList.remove('hidden');
        } else {
          controlsCol.classList.remove('hidden');
          resultCol.classList.remove('hidden');
          familyBanner.classList.add('hidden');
          calculatePronouns();
        }
      });
    });

    // 2. My Gender buttons
    document.querySelectorAll('.my-gender-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.my-gender-btn').forEach(b => {
          b.classList.remove('active', 'border-red-600', 'bg-red-50', 'text-red-600');
          b.classList.add('border-stone-200', 'bg-white', 'text-stone-700');
        });
        btn.classList.add('active', 'border-red-600', 'bg-red-50', 'text-red-600');
        btn.classList.remove('border-stone-200', 'bg-white', 'text-stone-700');
        myGender = btn.getAttribute('data-my-gender');
        calculatePronouns();
      });
    });

    // 3. Their Gender buttons
    document.querySelectorAll('.their-gender-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.their-gender-btn').forEach(b => {
          b.classList.remove('active', 'border-slate-900', 'bg-slate-100', 'text-slate-900');
          b.classList.add('border-stone-200', 'bg-white', 'text-stone-700');
        });
        btn.classList.add('active', 'border-slate-900', 'bg-slate-100', 'text-slate-900');
        btn.classList.remove('border-stone-200', 'bg-white', 'text-stone-700');
        theirGender = btn.getAttribute('data-their-gender');
        calculatePronouns();
      });
    });

    // Sliders Listeners
    if (userAgeInput) {
      userAgeInput.addEventListener('input', (e) => {
        ageDisplay.textContent = `${e.target.value} yrs`;
        calculatePronouns();
      });
    }

    if (theirAgeInput) {
      theirAgeInput.addEventListener('input', (e) => {
        theirAgeDisplay.textContent = `${e.target.value} yrs`;
        calculatePronouns();
      });
    }

    // Gắn sự kiện click nghe phát âm MP3 cho nút Loa
    document.getElementById('speakSelfBtn').addEventListener('click', () => {
      playPronounAudio(selfPronounEl.textContent.trim());
    });
    document.getElementById('speakThemBtn').addEventListener('click', () => {
      playPronounAudio(themPronounEl.textContent.trim());
    });

    // ENGINE TÍNH TOÁN XƯNG HÔ
    function calculatePronouns() {
      const myAge = parseInt(userAgeInput.value, 10);
      const theirAge = parseInt(theirAgeInput.value, 10);
      const diff = theirAge - myAge;

      let self = "Em";
      let them = "Anh";
      let explanation = "";

      const conNote = ` Note: "Con" is used naturally across both North and South Vietnam, while "Cháu" is primarily used in the North.`;

      if (currentContext === 'work') {
        if ((theirAge >= 70 && diff >= 45) || diff >= 45) {
          self = "Con";
          them = theirGender === 'male' ? "Ông" : "Bà";
          explanation = `For elderly senior figures in a professional setting with a large age gap, address them as <strong>${them}</strong> and call yourself <strong>Con</strong>.${conNote}`;
        } else if (myAge >= 70 && diff <= -45) {
          self = myGender === 'male' ? "Ông" : "Bà";
          them = "Con";
          explanation = `In the workplace, when an elderly senior speaks to a staff member who is younger than you by 45+ years, call yourself <strong>Ông</strong> (or <strong>Bà</strong>) and address them as <strong>Con</strong>.${conNote}`;
        } else if (diff >= 31) {
          self = "Con";
          them = theirGender === 'male' ? "Chú" : "Cô";
          explanation = `In the workplace, if someone is older by 31+ years, professional standards dictate addressing them as <strong>Chú / Cô</strong> and calling yourself <strong>Con</strong>.${conNote}`;
        } else if (diff <= -31) {
          self = myGender === 'male' ? "Chú" : "Cô";
          them = "Con";
          explanation = `In the workplace, when speaking to a junior staff member who is younger than you by 31+ years, call yourself <strong>Chú / Cô</strong> and address them as <strong>Con</strong>.${conNote}`;
        } else {
          if (diff >= 1) {
            self = "Em";
            them = theirGender === 'male' ? "Anh" : "Chị";
            explanation = `In the workplace, for colleagues older than you by up to 30 years, it is standard to call yourself <strong>Em</strong> and address them as <strong>Anh / Chị</strong>.`;
          } else if (diff === 0) {
            self = "Em";
            them = theirGender === 'male' ? "Anh" : "Chị";
            explanation = `When meeting someone of the exact same age in a professional setting, out of polite respect, address them as <strong>Anh / Chị</strong> and call yourself <strong>Em</strong>.`;
          } else {
            self = myGender === 'male' ? "Anh" : "Chị";
            them = "Em";
            explanation = `For younger colleagues within a 30-year age gap, call yourself <strong>Anh / Chị</strong> and address them as <strong>Em</strong> (or call them by name).`;
          }
        }
      } else {
        if (theirAge >= 70 && diff >= 45) {
          self = "Con";
          them = theirGender === 'male' ? "Ông" : "Bà";
          explanation = `For elderly seniors (age 70+ and 45+ years older, like your grandparents), address them as <strong>Ông / Bà</strong> and call yourself <strong>Con</strong>.${conNote}`;
        } 
        else if (myAge >= 70 && diff <= -45) {
          self = myGender === 'male' ? "Ông" : "Bà";
          them = "Con";
          explanation = `When an elderly senior speaks to a much younger person (such as a 45+ year age gap), address them as <strong>Con</strong> and call yourself <strong>Ông</strong> (or <strong>Bà</strong>).${conNote}`;
        }
        else if (diff >= 20) {
          self = "Con";
          them = theirGender === 'male' ? "Chú" : "Cô";
          explanation = `For adults of your parents' age (older by 20–44 years), address them as <strong>Chú</strong> or <strong>Cô</strong> and call yourself <strong>Con</strong>.${conNote}`;
        } 
        else if (myAge >= 50 && diff <= -30) {
          self = myGender === 'male' ? "Ông" : "Bà";
          them = "Con";
          explanation = `When an elderly adult speaks to a young child in casual settings, address them as <strong>Con</strong> and call yourself <strong>Ông</strong> (or <strong>Bà</strong> based on your gender).${conNote}`;
        }
        else if (diff >= 0) {
          self = "Em";
          them = theirGender === 'male' ? "Anh" : "Chị";
          explanation = `In casual social settings, whether they are slightly older or the exact same age, out of polite respect you call yourself <strong>Em</strong> and address them as <strong>Anh / Chị</strong>.`;
        } 
        else if (diff > -20) {
          self = myGender === 'male' ? "Anh" : "Chị";
          them = "Em";
          explanation = `For someone younger than you by up to 19 years, call yourself <strong>Anh / Chị</strong> and address them as <strong>Em</strong> (or call them by their name).`;
        } 
        else {
          self = myGender === 'male' ? "Chú" : "Cô";
          them = "Con";
          explanation = `For children or young individuals much younger than you (by 20+ years, like your children), call yourself <strong>Chú / Cô</strong> and address them as <strong>Con</strong>.${conNote}`;
        }
      }

      selfPronounEl.textContent = self;
      themPronounEl.textContent = them;
      pairExplanationEl.innerHTML = explanation;
    }

    calculatePronouns();
  </script>
</BaseLayout>