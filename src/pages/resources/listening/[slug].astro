---
import Layout from '../../../layout.astro';
import { lessons } from '../../../data/listeningLessons.js';

export async function getStaticPaths() {
  return lessons.map((lesson) => ({
    params: { slug: lesson.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;

// Lọc các bài học cùng chung level (trừ bài hiện tại), xáo trộn ngẫu nhiên và lấy ra 3 bài
const sameLevelLessons = lessons.filter(l => l.level === lesson.level && l.slug !== lesson.slug);
const otherLessons = [...sameLevelLessons].sort(() => Math.random() - 0.5).slice(0, 3);
---

<Layout title={`${lesson.title} | Vietnamese Listening Practice | Havie`} description={lesson.description}>
  <main class="max-w-4xl mx-auto px-5 py-10 sm:py-16 font-brand">
    
    <!-- Lesson Header -->
    <div class="space-y-3 mb-8 text-center max-w-2xl mx-auto">
      <div>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-red-50 text-red-600 border border-red-200 text-xs font-bold uppercase tracking-wider shadow-2xs">
          {lesson.level} Practice
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900">
        <span class="text-red-600">{lesson.title}</span>
      </h1>
      <p class="text-stone-600 text-base sm:text-lg font-medium">
        {lesson.description}
      </p>
    </div>

    <!-- ACCENT TOGGLE SWITCH -->
    <div class="flex items-center justify-center bg-stone-200/80 p-1.5 rounded-2xl max-w-md mx-auto mb-10 border border-stone-300/80 shadow-inner">
      <button 
        type="button" 
        id="btn-north"
        class="flex-1 py-3 px-5 rounded-xl font-extrabold text-sm sm:text-base transition-all cursor-pointer bg-slate-900 text-white shadow-md flex items-center justify-center gap-2"
      >
        <span>🇻🇳</span> Northern (Hanoi)
      </button>
      <button 
        type="button" 
        id="btn-south"
        class="flex-1 py-3 px-5 rounded-xl font-extrabold text-sm sm:text-base transition-all cursor-pointer text-stone-600 hover:text-slate-900 flex items-center justify-center gap-2"
      >
        <span>🇻🇳</span> Southern (Saigon)
      </button>
    </div>

    <!-- AUDIO PLAYER -->
    <div class="space-y-6 mb-10">
      <div class="bg-white border-2 border-stone-200 rounded-3xl p-6 sm:p-8 shadow-md space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="font-black text-slate-900 text-base sm:text-lg flex items-center gap-2">
            <span class="w-8 h-8 rounded-xl bg-red-50 text-red-600 flex items-center justify-center text-sm border border-red-100 shadow-2xs">🎧</span>
            <span>Audio Practice</span>
          </h3>
          <span class="text-xs font-bold text-stone-400 uppercase tracking-wider">Listen & Repeat</span>
        </div>
        
        <!-- Northern Audio -->
        <audio id="audio-north" controls controlsList="nodownload" oncontextmenu="return false;" preload="metadata" class="w-full accent-slate-900 py-2">
          <source src={lesson.northern.audioUrl} type="audio/wav" />
          Your browser does not support the audio element.
        </audio>

        <!-- Southern Audio -->
        <audio id="audio-south" controls controlsList="nodownload" oncontextmenu="return false;" preload="metadata" class="w-full accent-slate-900 py-2 hidden">
          <source src={lesson.southern.audioUrl} type="audio/wav" />
          Your browser does not support the audio element.
        </audio>
      </div>
    </div>

    <!-- COMPREHENSION QUIZ (NORTHERN) -->
    {lesson.northern.quiz && lesson.northern.quiz.length > 0 && (
      <div id="quiz-container-north" class="quiz-container bg-white border border-stone-200/90 rounded-3xl p-6 sm:p-8 shadow-xs my-8 space-y-6">
        <div>
          <h3 class="text-xl font-black text-slate-900">
            Comprehension Quiz
          </h3>
          <p class="text-stone-500 text-sm font-medium mt-1">Answer the questions below to check your score, unlock key vocabulary, and view transcripts.</p>
        </div>
        
        <form id="quiz-form-north" class="quiz-form space-y-6 divide-y divide-stone-100" data-region="north">
          {lesson.northern.quiz.map((q, qIndex) => (
            <div class="pt-6 first:pt-0 space-y-3 quiz-question" data-question={qIndex}>
              <p class="font-bold text-slate-900 text-base">{q.question}</p>
              <div class="grid grid-cols-1 gap-2.5">
                {q.options.map((opt, optIndex) => (
                  <label class="flex items-center gap-3 p-3.5 rounded-xl border border-stone-200 bg-stone-50 hover:bg-stone-100 transition cursor-pointer text-sm sm:text-base font-bold text-slate-800">
                    <input 
                      type="radio" 
                      name={`question-north-${qIndex}`} 
                      value={optIndex} 
                      class="w-4 h-4 text-slate-900 focus:ring-slate-900" 
                      required
                    />
                    <span>{opt}</span>
                  </label>
                ))}
              </div>
              <div class="explanation-box hidden p-3.5 rounded-xl text-sm font-medium mt-2"></div>
            </div>
          ))}

          <div class="pt-6 flex flex-col items-center justify-center gap-4 text-center">
            <button 
              type="submit" 
              class="w-full sm:w-auto px-8 py-3.5 bg-slate-900 text-white font-extrabold rounded-xl shadow-md hover:bg-slate-800 transition cursor-pointer text-sm sm:text-base mx-auto"
            >
              Submit Answers & Check Score
            </button>
            <div id="quiz-result-north" class="quiz-result hidden text-base font-black text-slate-900"></div>
          </div>
        </form>
      </div>
    )}

    <!-- COMPREHENSION QUIZ (SOUTHERN) -->
    {lesson.southern.quiz && lesson.southern.quiz.length > 0 && (
      <div id="quiz-container-south" class="quiz-container bg-white border border-stone-200/90 rounded-3xl p-6 sm:p-8 shadow-xs my-8 space-y-6 hidden">
        <div>
          <h3 class="text-xl font-black text-slate-900">
            Comprehension Quiz
          </h3>
          <p class="text-stone-500 text-sm font-medium mt-1">Answer the questions below to check your score, unlock key vocabulary, and view transcripts.</p>
        </div>
        
        <form id="quiz-form-south" class="quiz-form space-y-6 divide-y divide-stone-100" data-region="south">
          {lesson.southern.quiz.map((q, qIndex) => (
            <div class="pt-6 first:pt-0 space-y-3 quiz-question" data-question={qIndex}>
              <p class="font-bold text-slate-900 text-base">{q.question}</p>
              <div class="grid grid-cols-1 gap-2.5">
                {q.options.map((opt, optIndex) => (
                  <label class="flex items-center gap-3 p-3.5 rounded-xl border border-stone-200 bg-stone-50 hover:bg-stone-100 transition cursor-pointer text-sm sm:text-base font-bold text-slate-800">
                    <input 
                      type="radio" 
                      name={`question-south-${qIndex}`} 
                      value={optIndex} 
                      class="w-4 h-4 text-slate-900 focus:ring-slate-900" 
                      required
                    />
                    <span>{opt}</span>
                  </label>
                ))}
              </div>
              <div class="explanation-box hidden p-3.5 rounded-xl text-sm font-medium mt-2"></div>
            </div>
          ))}

          <div class="pt-6 flex flex-col items-center justify-center gap-4 text-center">
            <button 
              type="submit" 
              class="w-full sm:w-auto px-8 py-3.5 bg-slate-900 text-white font-extrabold rounded-xl shadow-md hover:bg-slate-800 transition cursor-pointer text-sm sm:text-base mx-auto"
            >
              Submit Answers & Check Score
            </button>
            <div id="quiz-result-south" class="quiz-result hidden text-base font-black text-slate-900"></div>
          </div>
        </form>
      </div>
    )}

    <!-- KEY VOCABULARY (NORTHERN) -->
    <div id="vocab-section-north" class="vocab-section bg-white border border-stone-200/90 rounded-3xl p-6 sm:p-8 shadow-xs my-8 space-y-4 hidden">
      <h3 class="text-xl font-black text-slate-900">Key Vocabulary</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {lesson.northern.vocabulary.map((vocab) => (
          <div class="p-4 rounded-2xl bg-stone-50 border border-stone-100 flex flex-col justify-center">
            <span class="font-black text-slate-900 text-base">{vocab.word}</span>
            <span class="text-stone-500 text-sm font-medium mt-0.5">{vocab.meaning}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- KEY VOCABULARY (SOUTHERN) -->
    <div id="vocab-section-south" class="vocab-section bg-white border border-stone-200/90 rounded-3xl p-6 sm:p-8 shadow-xs my-8 space-y-4 hidden">
      <h3 class="text-xl font-black text-slate-900">Key Vocabulary</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {lesson.southern.vocabulary.map((vocab) => (
          <div class="p-4 rounded-2xl bg-stone-50 border border-stone-100 flex flex-col justify-center">
            <span class="font-black text-slate-900 text-base">{vocab.word}</span>
            <span class="text-stone-500 text-sm font-medium mt-0.5">{vocab.meaning}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- TRANSCRIPT SECTION -->
    <div id="transcript-section" class="space-y-6 my-8 hidden">
      <!-- Northern Transcript -->
      <div id="transcript-north" class="bg-white border border-stone-200/90 rounded-3xl p-6 sm:p-8 shadow-xs space-y-5 hidden">
        <h3 class="text-xl font-black text-slate-900">Transcript</h3>
        <div class="space-y-5 divide-y divide-stone-100">
          {lesson.northern.transcript.map(({ vietnamese, english }) => (
            <div class="pt-4 first:pt-0">
              <p class="text-base sm:text-lg font-bold text-slate-900">{vietnamese}</p>
              <p class="text-stone-500 text-sm font-medium mt-1">{english}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Southern Transcript -->
      <div id="transcript-south" class="bg-white border border-stone-200/90 rounded-3xl p-6 sm:p-8 shadow-xs space-y-5 hidden">
        <h3 class="text-xl font-black text-slate-900">Transcript</h3>
        <div class="space-y-5 divide-y divide-stone-100">
          {lesson.southern.transcript.map(({ vietnamese, english }) => (
            <div class="pt-4 first:pt-0">
              <p class="text-base sm:text-lg font-bold text-slate-900">{vietnamese}</p>
              <p class="text-stone-500 text-sm font-medium mt-1">{english}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- GỢI Ý BÀI HỌC CÙNG LEVEL -->
    {otherLessons.length > 0 && (
      <div class="my-12 bg-gradient-to-br from-red-50/40 via-white to-amber-50/30 border border-red-100 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
        <div class="flex items-center justify-between">
          <div class="space-y-1">
            <h3 class="text-xl sm:text-2xl font-black text-slate-900">
              Level up your listening!
            </h3>
            <p class="text-stone-600 text-sm font-medium">Choose your next conversation and keep improving.</p>
          </div>
          <span class="text-xs font-black text-red-600 bg-red-50 border border-red-200 px-3.5 py-1.5 rounded-full uppercase tracking-wider">
            {lesson.level}
          </span>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {otherLessons.map((item) => (
            <a href={`/resources/listening/${item.slug}`} class="group p-5 rounded-2xl bg-white hover:bg-slate-900 border border-stone-200/90 hover:border-slate-900 transition-all duration-300 flex flex-col justify-between shadow-xs hover:shadow-xl transform hover:-translate-y-1">
              <div class="space-y-3">
                <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg bg-stone-100 text-stone-700 group-hover:bg-stone-800 group-hover:text-stone-300 transition-colors">
                  {item.level}
                </span>
                <h4 class="font-black text-slate-900 group-hover:text-white transition-colors text-lg sm:text-xl line-clamp-2">
                  {item.title}
                </h4>
              </div>
              <div class="mt-6 pt-4 border-t border-stone-100 group-hover:border-stone-800 flex items-center justify-between text-sm font-black text-red-600 group-hover:text-amber-400 transition-colors">
                <span>Start lesson</span>
                <span class="transform group-hover:translate-x-1.5 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- CTA BOOKING BOX -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-amber-100/90 via-orange-100/50 to-stone-200/70 border-2 border-amber-300/80 p-8 sm:p-12 my-12 shadow-md text-center">
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-red-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-amber-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-xl mx-auto space-y-4">
        <h3 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900">
          Want to master both accents with Alice?
        </h3>
        <p class="text-stone-700 text-sm sm:text-base font-medium leading-relaxed">
          Book a 1-on-1 trial session to practice real-life conversations tailored to your target region!
        </p>
        <div class="pt-2">
          <button type="button" class="open-modal-trigger px-8 py-3.5 bg-red-600 text-white font-extrabold rounded-xl shadow-md hover:bg-red-700 transition cursor-pointer text-sm sm:text-base inline-flex items-center gap-2">
            <span>Book 25-Min Trial Lesson →</span>
          </button>
        </div>
      </div>
    </div>

  </main>

  <!-- SCRIPT HANDLING -->
  <script define:vars={{ quizNorth: lesson.northern.quiz, quizSouth: lesson.southern.quiz }} is:inline>
    const btnNorth = document.getElementById('btn-north');
    const btnSouth = document.getElementById('btn-south');
    const audioNorth = document.getElementById('audio-north');
    const audioSouth = document.getElementById('audio-south');
    
    const quizContainerNorth = document.getElementById('quiz-container-north');
    const quizContainerSouth = document.getElementById('quiz-container-south');
    const vocabNorth = document.getElementById('vocab-section-north');
    const vocabSouth = document.getElementById('vocab-section-south');
    
    const transcriptSection = document.getElementById('transcript-section');
    const transcriptNorth = document.getElementById('transcript-north');
    const transcriptSouth = document.getElementById('transcript-south');

    let currentRegion = 'north';

    if (btnNorth && btnSouth) {
      btnNorth.addEventListener('click', () => {
        currentRegion = 'north';
        btnNorth.className = "flex-1 py-3 px-5 rounded-xl font-extrabold text-sm sm:text-base transition-all cursor-pointer bg-slate-900 text-white shadow-md flex items-center justify-center gap-2";
        btnSouth.className = "flex-1 py-3 px-5 rounded-xl font-extrabold text-sm sm:text-base transition-all cursor-pointer text-stone-600 hover:text-slate-900 flex items-center justify-center gap-2";
        
        audioNorth.classList.remove('hidden');
        audioSouth.classList.add('hidden');
        if (!audioSouth.paused) {
          audioSouth.pause();
          audioSouth.currentTime = 0;
        }

        quizContainerNorth.classList.remove('hidden');
        quizContainerSouth.classList.add('hidden');

        vocabNorth.classList.add('hidden');
        vocabSouth.classList.add('hidden');
        transcriptSection.classList.add('hidden');
        transcriptNorth.classList.add('hidden');
        transcriptSouth.classList.add('hidden');
      });

      btnSouth.addEventListener('click', () => {
        currentRegion = 'south';
        btnSouth.className = "flex-1 py-3 px-5 rounded-xl font-extrabold text-sm sm:text-base transition-all cursor-pointer bg-slate-900 text-white shadow-md flex items-center justify-center gap-2";
        btnNorth.className = "flex-1 py-3 px-5 rounded-xl font-extrabold text-sm sm:text-base transition-all cursor-pointer text-stone-600 hover:text-slate-900 flex items-center justify-center gap-2";
        
        audioSouth.classList.remove('hidden');
        audioNorth.classList.add('hidden');
        if (!audioNorth.paused) {
          audioNorth.pause();
          audioNorth.currentTime = 0;
        }

        quizContainerSouth.classList.remove('hidden');
        quizContainerNorth.classList.add('hidden');

        vocabNorth.classList.add('hidden');
        vocabSouth.classList.add('hidden');
        transcriptSection.classList.add('hidden');
        transcriptNorth.classList.add('hidden');
        transcriptSouth.classList.add('hidden');
      });
    }

    // Quiz submission handler
    document.querySelectorAll('.quiz-form').forEach(quizForm => {
      quizForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const region = quizForm.getAttribute('data-region');
        const quizData = region === 'north' ? quizNorth : quizSouth;
        const quizResult = quizForm.querySelector('.quiz-result');
        const vocabSection = document.getElementById(`vocab-section-${region}`);
        const transRegion = document.getElementById(`transcript-${region}`);

        let score = 0;
        const total = quizData.length;

        quizData.forEach((q, index) => {
          const selected = quizForm.querySelector(`input[name="question-${region}-${index}"]:checked`);
          const questionDiv = quizForm.querySelector(`[data-question="${index}"]`);
          const explanationBox = questionDiv.querySelector('.explanation-box');
          const radios = questionDiv.querySelectorAll('input[type="radio"]');

          radios.forEach(r => r.disabled = true);

          const userAns = selected ? parseInt(selected.value) : -1;
          const correctAns = q.correct;

          explanationBox.classList.remove('hidden');

          let rawExp = q.explanation;
          let formattedExp = rawExp;

          if (rawExp.includes(':')) {
            const parts = rawExp.split(':');
            formattedExp = `<strong>${parts[0].trim()}:</strong> ${parts.slice(1).join(':').trim()}`;
          } else {
            formattedExp = `<strong>${rawExp}</strong>`;
          }

          if (userAns === correctAns) {
            score++;
            explanationBox.className = "explanation-box p-3.5 rounded-xl text-sm font-medium mt-2 bg-emerald-50 text-emerald-900 border border-emerald-200";
            explanationBox.innerHTML = `${formattedExp}`;
            if (selected) {
              selected.closest('label').classList.add('bg-emerald-100', 'border-emerald-300', 'font-bold');
            }
          } else {
            explanationBox.className = "explanation-box p-3.5 rounded-xl text-sm font-medium mt-2 bg-rose-50 text-rose-900 border border-rose-200";
            explanationBox.innerHTML = `${formattedExp}`;
            if (selected) {
              selected.closest('label').classList.add('bg-rose-100', 'border-rose-300');
            }
            const correctLabel = radios[correctAns].closest('label');
            correctLabel.classList.add('bg-emerald-100', 'border-emerald-300', 'font-bold');
          }
        });

        quizResult.classList.remove('hidden');
        quizResult.innerHTML = `Your Score: ${score} / ${total} (${Math.round((score/total)*100)}%)`;

        if (vocabSection) vocabSection.classList.remove('hidden');
        if (transcriptSection) transcriptSection.classList.remove('hidden');
        if (transRegion) transRegion.classList.remove('hidden');

        if (transcriptSection) {
          transcriptSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  </script>
</Layout>