---
// src/pages/resources/streetwise.astro - Spoken Vietnamese Sandbox & WH-Questions Lab
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Real Spoken Vietnamese Lab — Havie</title>
  <meta name="description" content="Build modular Vietnamese sentences block by block and practice everyday WH-Questions and natural spoken answers." />

  <!-- FAVICON & MOBILE TOUCH ICONS -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #fffaf5;
      --navy: #0f172a;
      --brand-red: #dc2626;
      --orange: #ef7218;
    }

    html {
      scroll-padding-top: 85px;
    }

    body {
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--cream);
      color: var(--navy);
    }

    .font-brand {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
  </style>
</head>
<body class="selection:bg-red-600 selection:text-white min-h-screen flex flex-col antialiased relative overflow-x-hidden">

  <!-- BACKGROUND GLOW -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute top-0 right-[15%] w-[450px] h-[450px] bg-gradient-to-br from-amber-400/20 via-red-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute top-40 left-[10%] w-[380px] h-[380px] bg-gradient-to-tr from-amber-200/30 to-transparent rounded-full blur-3xl"></div>
  </div>

  <!-- NAVBAR -->
  <header class="sticky top-0 z-40 bg-[#fffaf5]/90 backdrop-blur-md border-b border-stone-200/80 h-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 h-full flex items-center justify-between">
      
      <!-- LOGO -->
      <a href="/" class="group flex flex-col select-none text-left">
        <div class="h-6 sm:h-7 flex items-center">
          <svg class="h-6 sm:h-7 w-auto overflow-visible" viewBox="0 0 175 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 2H6V12H18V2H24V28H18V17H6V28H0V2Z" fill="#dc2626"/>
            <path d="M41 2L52 28H45.5L43.2 22H33.8L31.5 28H25L36 2H41ZM38.5 8.5L35.2 17.5H41.8L38.5 8.5Z" fill="#dc2626"/>
            <path d="M53 2H59.5L67 21L74.5 2H81L70.5 28H63.5L53 2Z" fill="#dc2626"/>
            <path d="M86 2H92V28H86V2Z" fill="#dc2626"/>
            <path d="M98 2H117V7.5H104V12H115V17H104V22.5H117V28H98V2Z" fill="#dc2626"/>
          </svg>
        </div>
        <span class="text-[9px] sm:text-[9.5px] font-bold tracking-[0.2em] sm:tracking-[0.24em] text-stone-400 uppercase mt-1 pl-0.5 leading-none">
          Learn Vietnamese Online
        </span>
      </a>

      <!-- Desktop Menu Links -->
      <nav class="hidden md:flex items-center space-x-6 lg:space-x-7 text-sm font-semibold text-slate-700">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/#reviews" class="hover:text-red-600 transition">Student Stories</a>
        <a href="/resources" class="text-red-600 font-bold transition">Resources</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        <a href="/#faq" class="hover:text-red-600 transition">FAQ</a>
      </nav>

      <!-- Desktop CTA & Mobile Toggle Button -->
      <div class="flex items-center gap-3">
        <button
          type="button"
          class="open-modal-trigger hidden sm:inline-flex items-center justify-center px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-lg shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>

        <!-- Mobile Menu Hamburger Button -->
        <button 
          id="mobileMenuBtn" 
          type="button" 
          aria-label="Toggle Menu"
          class="md:hidden w-10 h-10 rounded-xl bg-stone-100 hover:bg-stone-200 text-slate-800 flex items-center justify-center font-bold transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobileMenu" class="hidden md:hidden absolute top-20 left-0 w-full bg-[#fffaf5] border-b border-stone-200 shadow-xl px-6 py-5 space-y-4 font-semibold text-slate-700 text-sm">
      <a href="/#about" class="mobile-link block hover:text-red-600 transition">About Me</a>
      <a href="/#curriculum" class="mobile-link block hover:text-red-600 transition">Learning Tracks</a>
      <a href="/#reviews" class="mobile-link block hover:text-red-600 transition">Student Stories</a>
      <a href="/resources" class="mobile-link block text-red-600 font-bold">Resources</a>
      <a href="/test" class="mobile-link block hover:text-red-600 transition">Level Test</a>
      <a href="/#faq" class="mobile-link block hover:text-red-600 transition">FAQ</a>
      <div class="pt-3 border-t border-stone-200">
        <button
          type="button"
          class="open-modal-trigger w-full py-3 text-xs font-bold text-white bg-red-600 rounded-xl text-center shadow-md cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="flex-grow py-10 lg:py-14">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 space-y-16">
      
      <!-- HERO HEADER -->
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="text-[11px] font-bold text-emerald-700 uppercase tracking-widest bg-emerald-50 px-3.5 py-1.5 rounded-full border border-emerald-200 inline-block shadow-2xs">
          Tactile Practice • Real-Time Reflex
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-brand">
          Real Spoken Vietnamese Lab
        </h1>
        <p class="text-stone-600 text-sm leading-relaxed">
          In <strong>Part 1</strong>, construct flexible sentences using 5 modular blocks. In <strong>Part 2</strong>, practice spontaneous conversations by responding to everyday WH-Questions.
        </p>
      </div>

      <!-- ================================================================ -->
      <!-- PART 1: 5-BLOCK LEGO SANDBOX -->
      <!-- ================================================================ -->
      <section class="space-y-6">
        <div class="flex items-center justify-between border-b border-stone-200/80 pb-3">
          <div>
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-red-600 bg-red-50 px-2 py-0.5 rounded border border-red-200">Part 1 • Dynamic Lego Sandbox</span>
            <h2 class="text-xl font-extrabold text-slate-900 font-brand mt-1">Build Your Own Sentence</h2>
          </div>
          <button id="resetSandboxBtn" class="text-xs font-bold text-stone-500 hover:text-red-600 transition flex items-center gap-1 cursor-pointer">
            <span>↺</span> Reset
          </button>
        </div>

        <!-- Live Display Box -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-stone-200/90 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-stone-400">
              Live Sentence:
            </span>
            <div class="flex items-center gap-2">
              <button 
                id="speakSandboxBtn" 
                type="button"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#fffaf5] border border-stone-200 text-slate-800 text-xs font-bold hover:border-red-500 hover:text-red-600 transition cursor-pointer shadow-2xs"
              >
                <span>🔊</span>
                <span>Listen</span>
              </button>
              <button 
                id="randomSandboxBtn" 
                type="button"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition cursor-pointer shadow-xs"
                title="Shuffle realistic combinations"
              >
                <span>🎲</span>
                <span>Shuffle</span>
              </button>
            </div>
          </div>

          <div id="sandboxViet" class="text-2xl sm:text-3xl font-black text-slate-900 leading-snug font-brand tracking-tight">
            “Tối nay em uống cà phê ở gần đây với bạn”
          </div>
          
          <p id="sandboxEng" class="text-xs sm:text-sm text-stone-500 italic">
            “Tonight I drink coffee nearby with a friend”
          </p>
        </div>

        <!-- 5 Compact Clickable Blocks -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
          
          <!-- Block 1: When -->
          <div class="relative">
            <button class="block-trigger-btn w-full p-3 rounded-2xl bg-white border border-stone-200/90 text-left hover:border-slate-800 transition shadow-2xs cursor-pointer" data-block="time">
              <span class="text-[10px] uppercase font-bold text-stone-400 block">1. When?</span>
              <span id="label-time" class="text-xs font-bold text-slate-900 block mt-1 truncate">Tối nay</span>
            </button>
            <div id="menu-time" class="block-menu hidden absolute top-full left-0 mt-1.5 w-72 bg-white rounded-2xl p-2 shadow-xl border border-stone-200 z-30 max-h-72 overflow-y-auto space-y-1"></div>
          </div>

          <!-- Block 2: Who -->
          <div class="relative">
            <button class="block-trigger-btn w-full p-3 rounded-2xl bg-white border border-stone-200/90 text-left hover:border-slate-800 transition shadow-2xs cursor-pointer" data-block="subject">
              <span class="text-[10px] uppercase font-bold text-stone-400 block">2. Who?</span>
              <span id="label-subject" class="text-xs font-bold text-slate-900 block mt-1 truncate">em</span>
            </button>
            <div id="menu-subject" class="block-menu hidden absolute top-full left-0 mt-1.5 w-72 bg-white rounded-2xl p-2 shadow-xl border border-stone-200 z-30 max-h-72 overflow-y-auto space-y-1"></div>
          </div>

          <!-- Block 3: Action -->
          <div class="relative col-span-2 sm:col-span-1">
            <button class="block-trigger-btn w-full p-3 rounded-2xl bg-white border border-stone-200/90 text-left hover:border-slate-800 transition shadow-2xs cursor-pointer" data-block="action">
              <span class="text-[10px] uppercase font-bold text-stone-400 block">3. Action</span>
              <span id="label-action" class="text-xs font-bold text-slate-900 block mt-1 truncate">uống cà phê</span>
            </button>
            <div id="menu-action" class="block-menu hidden absolute top-full left-0 sm:left-auto sm:right-0 lg:left-0 mt-1.5 w-80 bg-white rounded-2xl p-2 shadow-xl border border-stone-200 z-30 max-h-72 overflow-y-auto space-y-1"></div>
          </div>

          <!-- Block 4: Where -->
          <div class="relative">
            <button class="block-trigger-btn w-full p-3 rounded-2xl bg-white border border-stone-200/90 text-left hover:border-slate-800 transition shadow-2xs cursor-pointer" data-block="location">
              <span class="text-[10px] uppercase font-bold text-stone-400 block">4. Where?</span>
              <span id="label-location" class="text-xs font-bold text-slate-900 block mt-1 truncate">ở gần đây</span>
            </button>
            <div id="menu-location" class="block-menu hidden absolute top-full left-0 sm:left-auto sm:right-0 lg:left-0 mt-1.5 w-72 bg-white rounded-2xl p-2 shadow-xl border border-stone-200 z-30 max-h-72 overflow-y-auto space-y-1"></div>
          </div>

          <!-- Block 5: With Whom -->
          <div class="relative col-span-2 sm:col-span-2 lg:col-span-1">
            <button class="block-trigger-btn w-full p-3 rounded-2xl bg-white border border-stone-200/90 text-left hover:border-slate-800 transition shadow-2xs cursor-pointer" data-block="companion">
              <span class="text-[10px] uppercase font-bold text-stone-400 block">5. With?</span>
              <span id="label-companion" class="text-xs font-bold text-slate-900 block mt-1 truncate">với bạn</span>
            </button>
            <div id="menu-companion" class="block-menu hidden absolute top-full right-0 mt-1.5 w-72 bg-white rounded-2xl p-2 shadow-xl border border-stone-200 z-30 max-h-72 overflow-y-auto space-y-1"></div>
          </div>

        </div>

        <p class="text-xs text-stone-500 italic text-center">
          💡 Click any box to browse vocabulary or choose <strong class="text-slate-800">"🚫 None"</strong>. Tap <strong class="text-slate-800">"Shuffle"</strong> for verified natural sentences!
        </p>
      </section>

      <!-- ================================================================ -->
      <!-- PART 2: EVERYDAY WH-QUESTIONS & ANSWER PAIRS (INTERACTIVE LAB) -->
      <!-- ================================================================ -->
      <section class="space-y-6 pt-6 border-t border-stone-200/80">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-stone-200/80 pb-4">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-red-600 bg-red-50 px-2.5 py-0.5 rounded border border-red-200">
                Part 2 • Spoken Q&A Reflex
              </span>
              <span id="qaCounter" class="text-xs font-bold text-slate-900 bg-stone-100 px-2.5 py-0.5 rounded-full">
                24 Question Prompts
              </span>
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 font-brand mt-1">
              Everyday WH-Questions Lab
            </h2>
          </div>

          <!-- Random Question Prompt Button -->
          <button 
            type="button" 
            id="randomQBtn"
            class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition cursor-pointer shadow-xs"
          >
            <span>🎲</span>
            <span>Random Question</span>
          </button>
        </div>

        <!-- Filter Question Type Tabs -->
        <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
          <button class="q-filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-bold shrink-0 transition bg-slate-900 text-white cursor-pointer" data-type="all">All WH-Types</button>
          <button class="q-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold shrink-0 transition bg-white text-stone-600 border border-stone-200 hover:border-stone-300 cursor-pointer" data-type="what">❓ Làm gì? (What?)</button>
          <button class="q-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold shrink-0 transition bg-white text-stone-600 border border-stone-200 hover:border-stone-300 cursor-pointer" data-type="where">📍 Ở đâu? (Where?)</button>
          <button class="q-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold shrink-0 transition bg-white text-stone-600 border border-stone-200 hover:border-stone-300 cursor-pointer" data-type="who">👥 Với ai? (With whom?)</button>
          <button class="q-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold shrink-0 transition bg-white text-stone-600 border border-stone-200 hover:border-stone-300 cursor-pointer" data-type="when">⏰ Khi nào? (When?)</button>
        </div>

        <!-- Q&A Cards Grid -->
        <div id="qaGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Rendered via JavaScript -->
        </div>
      </section>

      <!-- CTA LESSON -->
      <div class="rounded-3xl bg-white p-7 sm:p-9 border border-stone-200/90 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left max-w-lg">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-50 text-red-600 text-[11px] font-bold tracking-wide border border-red-100">
            <span>🎯 1-on-1 Pronunciation Coaching</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight font-brand">
            Sound Like a Local in Natural Conversations.
          </h2>
          <p class="text-stone-600 text-xs sm:text-sm leading-relaxed">
            Practice conversational reflex, question answering, and regional accents with live teacher feedback.
          </p>
        </div>
        <div class="shrink-0 w-full md:w-auto text-center">
          <button
            type="button"
            class="open-modal-trigger inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl text-xs sm:text-sm shadow-sm transition hover:-translate-y-0.5 cursor-pointer"
          >
            Book Free 25-Min Trial Lesson →
          </button>
        </div>
      </div>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="bg-[#fffaf5] text-stone-600 py-8 text-xs border-t border-stone-200/80">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex items-center justify-center gap-2.5">
        <span class="font-brand font-black text-slate-900 tracking-widest text-sm">HAVIE.</span>
        <span class="text-stone-400">•</span>
        <span class="font-medium">Learn Vietnamese with Hang</span>
      </div>
      <div class="flex items-center gap-4 sm:gap-6 font-semibold text-stone-700 flex-wrap justify-center">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/#reviews" class="hover:text-red-600 transition">Student Stories</a>
        <a href="/resources" class="text-red-600 transition font-bold">Resources</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        <button type="button" class="open-modal-trigger text-red-600 font-bold hover:underline cursor-pointer">Book Trial</button>
      </div>
    </div>
  </footer>

  <!-- CONSULTATION / BOOKING MODAL -->
  <div id="consultModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-stone-200 space-y-5 text-left">
      
      <div class="flex items-center justify-between border-b border-stone-100 pb-3">
        <div>
          <span class="text-[10px] font-black text-red-600 uppercase tracking-widest bg-red-50 px-2.5 py-0.5 rounded border border-red-200">1-on-1 Coaching</span>
          <h3 class="text-xl font-black text-slate-900 font-brand mt-1">Book 25-Min Trial Lesson</h3>
        </div>
        <button id="closeModalBtn" type="button" class="w-8 h-8 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-600 font-bold flex items-center justify-center cursor-pointer">
          ✕
        </button>
      </div>

      <form id="consultForm" class="space-y-3.5 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Full Name / Tên của bạn *</label>
          <input type="text" id="cName" required placeholder="e.g. Alex Smith" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Country / Quốc gia *</label>
            <input type="text" id="cCountry" required placeholder="e.g. Germany, USA" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Phone / SĐT</label>
            <input type="tel" id="cPhone" placeholder="e.g. +49..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Email Address *</label>
          <input type="email" id="cEmail" required placeholder="name@example.com" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Learning Goals / Mục tiêu học tập *</label>
          <textarea id="cGoals" rows="3" required placeholder="Current level, target dialect (Hanoi/Saigon), goals..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50 resize-none"></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3.5 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-xs sm:text-sm shadow-md transition cursor-pointer mt-2"
        >
          Submit Request to Hang →
        </button>
      </form>

      <div id="successMessage" class="hidden text-center py-6 space-y-3">
        <div class="text-3xl">🎉</div>
        <h4 class="font-black text-slate-900 text-base font-brand">Request Sent Successfully!</h4>
        <p class="text-stone-600 text-xs leading-relaxed">Thank you! Hang has received your details and goals. She will reach out via email within 24 hours.</p>
        <button id="btnCloseSuccess" type="button" class="px-6 py-2.5 bg-slate-900 text-white font-bold rounded-xl text-xs cursor-pointer">
          Close Window
        </button>
      </div>

    </div>
  </div>

  <!-- JAVASCRIPT LOGIC -->
  <script is:inline>
    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });
    }

    // ==========================================
    // PART 1: 5-BLOCK LEGO VOCABULARY
    // ==========================================
    const sandboxVocab = {
      time: [
        { vi: null, en: "", label: "🚫 None (Skip)" },
        { vi: "Bây giờ", en: "Right now", label: "⚡ Bây giờ (Right now)" },
        { vi: "Lát nữa", en: "In a little bit", label: "⏳ Lát nữa (In a bit)" },
        { vi: "Tí nữa", en: "In a little bit (North)", label: "⏱️ Tí nữa (In a bit)" },
