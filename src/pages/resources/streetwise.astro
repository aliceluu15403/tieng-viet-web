          const lIdx = p.location ? sandboxVocab.location.findIndex(x => x.vi === p.location) : 0;
          const cIdx = p.companion ? sandboxVocab.companion.findIndex(x => x.vi === p.companion) : 0;

          currentSandbox = {
            time: tIdx !== -1 ? tIdx : 0,
            subject: sIdx !== -1 ? sIdx : 1,
            action: aIdx !== -1 ? aIdx : 0,
            location: lIdx !== -1 ? lIdx : 0,
            companion: cIdx !== -1 ? cIdx : 0
          };

          updateSandboxDisplay();
          document.getElementById('sandboxViet').scrollIntoView({ behavior: 'smooth', block: 'center' });
        });

        qaGrid.appendChild(card);
      });

      document.querySelectorAll('.speak-q-btn, .speak-a-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const text = btn.getAttribute('data-text');
          if (!('speechSynthesis' in window)) return;
          window.speechSynthesis.cancel();
          const utterance = new SpeechSynthesisUtterance(text);
          utterance.lang = 'vi-VN';
          utterance.rate = 0.9;
          window.speechSynthesis.speak(utterance);
        });
      });
    }

    document.querySelectorAll('.q-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.q-filter-btn').forEach(b => {
          b.classList.remove('active', 'bg-slate-900', 'text-white');
          b.classList.add('bg-white', 'text-stone-600', 'border', 'border-stone-200');
        });
        btn.classList.add('active', 'bg-slate-900', 'text-white');
        btn.classList.remove('bg-white', 'text-stone-600', 'border', 'border-stone-200');
        currentQType = btn.getAttribute('data-type');
        renderQACards();
      });
    });

    document.getElementById('randomQBtn').addEventListener('click', () => {
      const randomItem = whQuestionsDatabase[Math.floor(Math.random() * whQuestionsDatabase.length)];
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(randomItem.qVi);
        utterance.lang = 'vi-VN';
        utterance.rate = 0.9;
        window.speechSynthesis.speak(utterance);
      }
      currentQType = randomItem.type;
      document.querySelectorAll('.q-filter-btn').forEach(b => {
        if (b.getAttribute('data-type') === currentQType) {
          b.classList.add('active', 'bg-slate-900', 'text-white');
          b.classList.remove('bg-white', 'text-stone-600', 'border', 'border-stone-200');
        } else {
          b.classList.remove('active', 'bg-slate-900', 'text-white');
          b.classList.add('bg-white', 'text-stone-600', 'border', 'border-stone-200');
        }
      });
      renderQACards();
    });

    // Initial Execution
    initSandboxMenus();
    updateSandboxDisplay();
    renderQACards();
  </script>
</body>
</html>