---
// src/pages/resources/tones.astro
import Layout from '../../layout.astro';
---

<Layout 
  title="Vietnamese Tones | Havie" 
  description="Learn the 6 Vietnamese tones with native sound, easy pronunciation tips, North and South accents, and fun listening practice.">
  <!-- BACKGROUND GLOW -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute top-0 right-[15%] w-[450px] h-[450px] bg-gradient-to-br from-amber-400/20 via-red-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute top-40 left-[10%] w-[380px] h-[380px] bg-gradient-to-tr from-amber-200/30 to-transparent rounded-full blur-3xl"></div>
  </div>

  <main class="flex-grow py-10 lg:py-14 font-brand">
    
    <!-- HEADER & DIALECT SWITCHER -->
    <section class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 mb-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-extrabold text-red-600 uppercase tracking-widest bg-red-50 px-4 py-1.5 rounded-full border border-red-200 inline-block shadow-2xs">
            Tones Studio
          </span>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight font-brand pt-1">
            Master the 6 <span class="text-red-600">Vietnamese Tones.</span>
          </h1>
          <p class="text-stone-600 text-base sm:text-lg leading-relaxed pt-2">
            Select your accent first, click any tone card to hear native pronunciation, and <a href="#workout" class="text-red-600 font-bold underline underline-offset-4 decoration-red-300 hover:decoration-red-600 transition cursor-pointer">practice</a> ↓.
          </p>
        </div>

        <!-- ACCENT SWITCHER -->
        <div class="inline-flex items-center p-1.5 bg-white rounded-2xl border border-stone-200 shadow-xs shrink-0 self-start md:self-auto">
          <button 
            id="btn-north" 
            onclick="setDialect('north')" 
            class="px-4 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs sm:text-sm transition shadow-xs cursor-pointer"
          >
            🇻🇳 Northern (Hanoi)
          </button>
          <button 
            id="btn-south" 
            onclick="setDialect('south')" 
            class="px-4 py-2.5 rounded-xl text-stone-500 hover:text-slate-900 font-bold text-xs sm:text-sm transition cursor-pointer"
          >
            🇻🇳 Southern (Saigon)
          </button>
        </div>
      </div>
    </section>

    <!-- 6 TONE CARDS GRID -->
    <section class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pb-16">
      <div id="tonesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </section>

    <!-- PRACTICE WORKOUT SECTION -->
    <section id="workout" class="max-w-5xl mx-auto px-5 sm:px-8 lg:px-12 pt-6 scroll-mt-28">
      <div class="bg-white rounded-[28px] p-6 sm:p-10 border border-stone-200/95 shadow-xl shadow-stone-300/30 relative overflow-hidden">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-stone-100">
          <div>
            <span id="practiceSubtitle" class="text-xs font-extrabold text-red-600 uppercase tracking-widest block mb-1">Practice • 6 Questions</span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 font-brand">Which Tone Did You Hear?</h2>
            <p class="text-stone-500 text-xs sm:text-sm mt-1">Play the audio and test your ear by selecting the exact tone match below.</p>
          </div>
          <div class="flex items-center gap-4 bg-stone-50 px-5 py-2.5 rounded-2xl border border-stone-200 shrink-0 text-sm font-bold self-start sm:self-auto">
            <span id="quizRound" class="text-slate-900 font-mono font-extrabold">1 / 6</span>
            <span class="text-stone-300">|</span>
            <span class="text-stone-500">Score: <strong id="quizScore" class="text-red-600 font-mono font-extrabold">0</strong></span>
          </div>
        </div>

        <div id="quizPlayArea" class="pt-6">
          <div class="py-8 text-center space-y-3">
            <button 
              id="btnPlayQuiz" 
              onclick="playCurrentQuestionAudio()" 
              class="px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-2xl text-sm sm:text-base shadow-lg shadow-red-600/20 transition active:scale-95 inline-flex items-center gap-2.5 cursor-pointer"
            >
              <span class="text-lg">🔊</span> 
              <span id="quizBtnText">Listen Audio</span>
            </button>
            <div id="quizPromptHint" class="text-xs text-stone-400 font-medium italic">Click to play sound, then pick the right choice below.</div>
          </div>

          <div id="quizChoicesGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto"></div>
          
          <div id="quizFeedback" class="hidden mt-6 p-4.5 rounded-2xl text-xs sm:text-sm font-semibold text-center max-w-2xl mx-auto"></div>

          <div id="nextButtonArea" class="hidden mt-6 text-center">
            <button 
              onclick="goToNextQuestion()" 
              class="px-10 py-4 bg-slate-900 hover:bg-slate-800 text-white font-extrabold rounded-2xl text-base shadow-lg shadow-slate-900/20 transition cursor-pointer"
            >
              Continue →
            </button>
          </div>
        </div>

        <!-- SUMMARY -->
        <div id="quizSummaryArea" class="hidden py-12 text-center space-y-4">
          <div class="w-16 h-16 rounded-3xl bg-amber-100 text-amber-700 flex items-center justify-center text-3xl mx-auto shadow-xs">🏆</div>
          <h3 class="text-3xl font-black text-slate-900 font-brand">Workout Completed!</h3>
          <p id="quizFinalResultText" class="text-stone-600 text-sm sm:text-base max-w-md mx-auto leading-relaxed"></p>
          <div class="pt-4 flex justify-center gap-4">
            <button type="button" class="open-modal-trigger px-6 py-3.5 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-xl text-sm shadow-md transition cursor-pointer">Book Trial Lesson →</button>
            <button onclick="restartQuiz()" class="px-6 py-3.5 bg-stone-100 hover:bg-stone-200 text-slate-900 font-bold rounded-xl text-sm transition cursor-pointer">Practice Again ↺</button>
          </div>
        </div>

      </div>

      <!-- BANNER TRIAL -->
      <div class="mt-10 rounded-[28px] bg-gradient-to-r from-red-50 via-white to-amber-50 border border-red-200/80 p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
        <div class="space-y-1 text-center md:text-left">
          <span class="text-xs font-extrabold uppercase tracking-wider text-red-600">Personalized Coaching</span>
          <h3 class="text-xl font-extrabold text-slate-900 font-brand">Want to fix your pronunciation with Hang Luu?</h3>
          <p class="text-xs sm:text-sm text-stone-600">Let's figure out where you're getting stuck and practice together in a 25-minute trial session.</p>
        </div>
        <button 
          type="button"
          class="open-modal-trigger shrink-0 px-6 py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl text-xs shadow-md shadow-red-600/20 transition hover:-translate-y-0.5 cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>
    </section>

  </main>

  <!-- SCRIPTS -->
  <script is:inline>
    // ĐỊNH NGHĨA DỮ LIỆU ĐỘC LẬP CHO 2 MIỀN
    const TONES_DATA = {
      north: [
        { id: 'ngang', num: '1', name: 'Ngang', type: 'Flat', word: 'ma', en: 'Ghost', path: 'M 10,25 L 110,25', color: '#10b981', bg: 'hover:border-emerald-400', mechanic: 'Keep pitch steady at mid level. Relax your jaw and vocal cords, like humming.' },
        { id: 'sac', num: '2', name: 'Sắc', type: 'Up', word: 'má', en: 'Mother', path: 'M 10,38 L 110,12', color: '#e52b27', bg: 'hover:border-red-400', mechanic: 'Start at mid pitch and shoot sharply upward. Tighten cords quickly, like asking: "WHAT?!".' },
        { id: 'huyen', num: '3', name: 'Huyền', type: 'Down', word: 'mà', en: 'But', path: 'M 10,15 L 110,38', color: '#3b82f6', bg: 'hover:border-blue-400', mechanic: 'Start at lower-mid pitch and glide down gently. Drop chin like a relaxed sigh: "Ahhh".' },
        { id: 'hoi', num: '4', name: 'Hỏi', type: 'Question Mark', word: 'mả', en: 'Tomb', path: 'M 10,20 Q 60,46 110,18', color: '#d97706', bg: 'hover:border-amber-400', mechanic: 'Dip deep into low pitch, then scoop upward with a questioning curve: "Reaaally?".' },
        { id: 'nga', num: '5', name: 'Ngã', type: 'Wave', word: 'mã', en: 'Horse', path: 'M 10,28 L 50,32 M 70,24 L 110,10', color: '#8b5cf6', bg: 'hover:border-purple-400', mechanic: 'High rising pitch broken midway by a brief throat stop before rising: "Uh-oh!".' },
        { id: 'nang', num: '6', name: 'Nặng', type: 'Dot', word: 'mạ', en: 'Seedling', path: 'M 10,18 L 85,38', dot: true, color: '#ea580c', bg: 'hover:border-orange-400', mechanic: 'Drop pitch immediately to the bottom and cut airflow dead short, like a blunt "Yup!".' }
      ],
      south: [
        { id: 'ngang', num: '1', name: 'Ngang', type: 'Flat', word: 'ma', en: 'Ghost', path: 'M 10,25 L 110,25', color: '#10b981', bg: 'hover:border-emerald-400', mechanic: 'Keep pitch steady at mid level. Relax your jaw and vocal cords, like humming.' },
        { id: 'sac', num: '2', name: 'Sắc', type: 'Up', word: 'má', en: 'Mother', path: 'M 10,38 L 110,12', color: '#e52b27', bg: 'hover:border-red-400', mechanic: 'Start at mid pitch and shoot sharply upward. Tighten cords quickly, like asking: "WHAT?!".' },
        { id: 'huyen', num: '3', name: 'Huyền', type: 'Down', word: 'mà', en: 'But', path: 'M 10,15 L 110,38', color: '#3b82f6', bg: 'hover:border-blue-400', mechanic: 'Start at lower-mid pitch and glide down gently. Drop chin like a relaxed sigh: "Ahhh".' },
        { id: 'hoi', num: '4', name: 'Hỏi', type: 'Question Mark', word: 'mả', en: 'Tomb', path: 'M 10,20 Q 60,46 110,18', color: '#d97706', bg: 'hover:border-amber-400', mechanic: 'Dip deep into low pitch, then scoop upward with a questioning curve: "Reaaally?".' },
        { id: 'nga', num: '5', name: 'Ngã', type: 'Wave', word: 'mã', en: 'Horse', path: 'M 10,20 Q 60,46 110,18', color: '#8b5cf6', bg: 'hover:border-purple-400', mechanic: 'In Southern accent, tone Ngã merges with tone Hỏi: dip down and scoop upward.' },
        { id: 'nang', num: '6', name: 'Nặng', type: 'Dot', word: 'mạ', en: 'Seedling', path: 'M 10,18 L 85,38', dot: true, color: '#ea580c', bg: 'hover:border-orange-400', mechanic: 'Drop pitch immediately to the bottom and cut airflow dead short, but held slightly longer in Southern accent.' }
      ]
    };

    // Miền Bắc: 6 câu
    const QUIZ_ROUNDS_NORTH = [
      { correctIndex: 2, choices: [{ word: 'ca', tone: 'ngang' }, { word: 'cà', tone: 'huyen' }, { word: 'cá', tone: 'sac' }, { word: 'cả', tone: 'hoi' }] },
      { correctIndex: 2, choices: [{ word: 'sưa', tone: 'ngang' }, { word: 'sừa', tone: 'huyen' }, { word: 'sữa', tone: 'sac' }, { word: 'sửa', tone: 'hoi' }] },
      { correctIndex: 3, choices: [{ word: 'phơ', tone: 'ngang' }, { word: 'phờ', tone: 'huyen' }, { word: 'phớ', tone: 'sac' }, { word: 'phở', tone: 'hoi' }] },
      { correctIndex: 3, choices: [{ word: 'la', tone: 'ngang' }, { word: 'là', tone: 'huyen' }, { word: 'lá', tone: 'sac' }, { word: 'lạ', tone: 'nang' }] },
      { correctIndex: 0, choices: [{ word: 'to', tone: 'ngang' }, { word: 'tò', tone: 'huyen' }, { word: 'tỏ', tone: 'hoi' }, { word: 'tọ', tone: 'nang' }] },
      { correctIndex: 1, choices: [{ word: 'ga', tone: 'ngang' }, { word: 'gà', tone: 'huyen' }, { word: 'gá', tone: 'sac' }, { word: 'gả', tone: 'hoi' }] }
    ];

    // Miền Nam: 5 câu
    const QUIZ_ROUNDS_SOUTH = [
      { correctIndex: 2, choices: [{ word: 'ca', tone: 'ngang' }, { word: 'cà', tone: 'huyen' }, { word: 'cá', tone: 'sac' }, { word: 'cả', tone: 'hoi' }] },
      { correctIndex: 3, choices: [{ word: 'phơ', tone: 'ngang' }, { word: 'phờ', tone: 'huyen' }, { word: 'phớ', tone: 'sac' }, { word: 'phở', tone: 'hoi' }] },
      { correctIndex: 3, choices: [{ word: 'la', tone: 'ngang' }, { word: 'là', tone: 'huyen' }, { word: 'lá', tone: 'sac' }, { word: 'lạ', tone: 'nang' }] },
      { correctIndex: 0, choices: [{ word: 'to', tone: 'ngang' }, { word: 'tò', tone: 'huyen' }, { word: 'tỏ', tone: 'hoi' }, { word: 'tọ', tone: 'nang' }] },
      { correctIndex: 1, choices: [{ word: 'ga', tone: 'ngang' }, { word: 'gà', tone: 'huyen' }, { word: 'gá', tone: 'sac' }, { word: 'gả', tone: 'hoi' }] }
    ];

    let currentDialect = 'north';
    let currentRoundIndex = 0;
    let score = 0;
    let hasAnsweredCurrentRound = false;

    function getActiveQuizRounds() {
      return currentDialect === 'north' ? QUIZ_ROUNDS_NORTH : QUIZ_ROUNDS_SOUTH;
    }

    // RENDER LẠI LƯỚI CARD TÙY THEO DIALECT
    function renderTonesGrid() {
      const grid = document.getElementById('tonesGrid');
      const data = TONES_DATA[currentDialect];
      grid.innerHTML = '';

      data.forEach(t => {
        const card = document.createElement('div');
        card.onclick = () => playTone(t.id);
        card.className = `group bg-white rounded-3xl p-6 lg:p-7 border border-stone-200/90 ${t.bg} shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 cursor-pointer flex flex-col justify-between relative select-none`;
        card.innerHTML = `
          <div class="relative z-10">
            <div class="flex items-center justify-between pb-4 border-b border-stone-100">
              <span class="font-mono font-extrabold text-xs text-stone-400 uppercase tracking-widest">TONE ${t.num}</span>
              <span class="font-bold text-xs text-slate-800 bg-stone-100/90 px-3 py-1 rounded-full border border-stone-200/60">
                ${t.name} • ${t.type}
              </span>
            </div>
            <div class="py-5 flex items-center justify-between gap-4">
              <div>
                <span class="text-4xl sm:text-5xl font-black font-tone text-slate-900 group-hover:text-red-600 transition-colors leading-none block">
                  ${t.word}
                </span>
                <span class="text-xs sm:text-sm font-bold text-stone-400 mt-1.5 block">
                  ${t.en}
                </span>
              </div>
              <div class="w-24 h-12 flex items-center justify-center bg-stone-50/80 rounded-2xl p-2 border border-stone-100">
                <svg class="w-full h-full" viewBox="0 0 120 50">
                  <path class="tone-path" d="${t.path}" fill="none" stroke="${t.color}" stroke-width="5" stroke-linecap="round" />
                  ${t.dot ? `<circle class="tone-dot" cx="102" cy="38" r="5" fill="${t.color}" />` : ''}
                </svg>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed pt-1">
              ${t.mechanic}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between text-xs font-bold text-stone-400 group-hover:text-red-600 transition-colors relative z-10">
            <span>Click to listen & repeat</span>
            <div class="w-8 h-8 rounded-full bg-stone-100 group-hover:bg-red-600 group-hover:text-white flex items-center justify-center transition-colors text-xs shadow-2xs">
              🔊
            </div>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function setDialect(d) {
      currentDialect = d;
      currentRoundIndex = 0;
      score = 0;
      document.getElementById('quizScore').innerText = 0;

      document.getElementById('btn-north').className = d === 'north' ? 'px-4 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs sm:text-sm transition shadow-xs cursor-pointer' : 'px-4 py-2.5 rounded-xl text-stone-500 hover:text-slate-900 font-bold text-xs sm:text-sm transition cursor-pointer';
      document.getElementById('btn-south').className = d === 'south' ? 'px-4 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs sm:text-sm transition shadow-xs cursor-pointer' : 'px-4 py-2.5 rounded-xl text-stone-500 hover:text-slate-900 font-bold text-xs sm:text-sm transition cursor-pointer';

      renderTonesGrid();

      document.getElementById('quizSummaryArea').classList.add('hidden');
      document.getElementById('quizPlayArea').classList.remove('hidden');
      renderCurrentQuestion();
    }

    // --- SETUP AUDIO CHO CARDS VÀ PRACTICE ---
    const northAudio = new Audio('/audio/tones/ma-all.m4a');
    const southAudio = new Audio('/audio/tones/ma-south.m4a');
    const practiceNorthAudio = new Audio('/audio/tones/practice - north.m4a');
    const practiceSouthAudio = new Audio('/audio/tones/practice - south.m4a');

    const cardTimestampsNorth = {
      ngang: { start: 0.6, end: 1.4 },
      sac:   { start: 1.9, end: 2.7 },
      huyen: { start: 2.9, end: 3.9 },
      hoi:   { start: 4.6, end: 5.4 },
      nga:   { start: 5.9, end: 6.7 }, 
      nang:  { start: 7.2, end: 8.0 }
    };

    // Mốc thời gian được tối ưu lại rõ ràng, khoảng cách an toàn cho từng dấu giọng Nam (ma-south.m4a)
    const cardTimestampsSouth = {
      ngang: { start: 0.0, end: 1.0 },
      sac:   { start: 1.7, end: 2.3 },
      huyen: { start: 2.9, end: 3.4 },
      hoi:   { start: 3.7, end: 4.7 },
      nga:   { start: 3.7, end: 4.7 }, 
      nang:  { start: 6.1, end: 7.1 }
    };

    const practiceNorthTimestamps = [
      { start: 0.6, end: 1.5 },
      { start: 2.1, end: 3.1 },
      { start: 3.6, end: 4.6 },
      { start: 4.9, end: 5.5 },
      { start: 6.2, end: 6.9 },
      { start: 7.5, end: 8.2 }
    ];

    const practiceSouthTimestamps = [
      { start: 0.9, end: 1.5 },
      { start: 2.5, end: 3.1 },
      { start: 3.7, end: 4.5 },
      { start: 4.9, end: 5.7 },
      { start: 6.1, end: 6.8 }
    ];

    function playTone(toneKey) {
      northAudio.pause();
      southAudio.pause();
      practiceNorthAudio.pause();
      practiceSouthAudio.pause();

      let activeAudio = northAudio;
      let range;

      if (currentDialect === 'south') {
        activeAudio = southAudio;
        range = cardTimestampsSouth[toneKey];
      } else {
        range = cardTimestampsNorth[toneKey];
      }

      if (!range) return;

      activeAudio.currentTime = range.start;
      activeAudio.play().catch(err => console.log("Audio play error:", err));

      const checkTime = () => {
        if (activeAudio.currentTime >= range.end) {
          activeAudio.pause();
          activeAudio.removeEventListener('timeupdate', checkTime);
        }
      };
      
      activeAudio.addEventListener('timeupdate', checkTime);
    }

    function playCurrentQuestionAudio() {
      northAudio.pause();
      southAudio.pause();
      practiceNorthAudio.pause();
      practiceSouthAudio.pause();

      let activeAudio;
      let range;

      if (currentDialect === 'north') {
        activeAudio = practiceNorthAudio;
        range = practiceNorthTimestamps[currentRoundIndex];
      } else {
        activeAudio = practiceSouthAudio;
        range = practiceSouthTimestamps[currentRoundIndex];
      }

      if (!range) return;

      activeAudio.currentTime = range.start;
      activeAudio.play().catch(err => console.log("Audio play error:", err));

      const checkTime = () => {
        if (activeAudio.currentTime >= range.end) {
          activeAudio.pause();
          activeAudio.removeEventListener('timeupdate', checkTime);
        }
      };

      activeAudio.addEventListener('timeupdate', checkTime);
      document.getElementById('quizBtnText').innerText = 'Listen Again ↺';
    }

    function renderCurrentQuestion() {
      hasAnsweredCurrentRound = false;
      const rounds = getActiveQuizRounds();
      const roundData = rounds[currentRoundIndex];
      const totalRounds = rounds.length;

      document.getElementById('quizRound').innerText = `${currentRoundIndex + 1} / ${totalRounds}`;
      document.getElementById('practiceSubtitle').innerText = `Practice • ${totalRounds} Questions`;
      document.getElementById('quizBtnText').innerText = 'Listen Audio';
      document.getElementById('quizPromptHint').innerText = 'Click to play sound, then pick the right choice below.';
      document.getElementById('quizFeedback').classList.add('hidden');
      document.getElementById('nextButtonArea').classList.add('hidden');

      const container = document.getElementById('quizChoicesGrid');
      container.innerHTML = '';

      roundData.choices.forEach((choice, idx) => {
        const btn = document.createElement('button');
        btn.className = 'quiz-opt-btn p-5 rounded-2xl border border-stone-200/90 hover:border-slate-800 bg-[#fffaf6] text-center transition active:scale-95 group shadow-2xs cursor-pointer';
        btn.innerHTML = `
          <span class="block text-3xl sm:text-4xl font-black font-tone text-slate-900 group-hover:text-red-600 transition-colors leading-tight">${choice.word}</span>
        `;
        btn.onclick = () => selectAnswer(idx, btn);
        container.appendChild(btn);
      });
    }

    function selectAnswer(selectedIndex, btnEl) {
      if (hasAnsweredCurrentRound) return;
      hasAnsweredCurrentRound = true;

      const rounds = getActiveQuizRounds();
      const roundData = rounds[currentRoundIndex];
      const correctObj = roundData.choices[roundData.correctIndex];
      const selectedObj = roundData.choices[selectedIndex];

      const fb = document.getElementById('quizFeedback');
      fb.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-900', 'border-emerald-200', 'bg-red-50', 'text-red-900', 'border-red-200');

      document.querySelectorAll('.quiz-opt-btn').forEach(btn => {
        btn.classList.remove('hover:border-slate-800', 'active:scale-95');
        btn.classList.add('cursor-default');
      });

      if (selectedIndex === roundData.correctIndex) {
        score += 10;
        btnEl.classList.add('border-emerald-500', 'bg-emerald-50');
        fb.classList.add('bg-emerald-50', 'text-emerald-900', 'border', 'border-emerald-200');
        fb.innerHTML = `Correct! The word was <strong class="font-tone">“${correctObj.word}”</strong>.`;
      } else {
        btnEl.classList.add('border-red-400', 'bg-red-50');
        document.querySelectorAll('.quiz-opt-btn')[roundData.correctIndex].classList.add('border-emerald-500', 'bg-emerald-50');
        fb.classList.add('bg-red-50', 'text-red-900', 'border', 'border-red-200');
        fb.innerHTML = `Not quite! You selected <strong>“${selectedObj.word}”</strong>. The correct word was <strong class="font-tone">“${correctObj.word}”</strong>.`;
      }

      document.getElementById('quizScore').innerText = score;
      document.getElementById('nextButtonArea').classList.remove('hidden');
    }

    function goToNextQuestion() {
      const rounds = getActiveQuizRounds();
      if (currentRoundIndex < rounds.length - 1) {
        currentRoundIndex++;
        renderCurrentQuestion();
      } else {
        document.getElementById('quizPlayArea').classList.add('hidden');
        document.getElementById('quizSummaryArea').classList.remove('hidden');
        const maxScore = rounds.length * 10;
        document.getElementById('quizFinalResultText').innerHTML = 
          `You scored <strong>${score} / ${maxScore} points</strong>! Keep practicing regularly to make Vietnamese tones instinctive.`;
      }
    }

    function restartQuiz() {
      currentRoundIndex = 0;
      score = 0;
      document.getElementById('quizScore').innerText = 0;
      document.getElementById('quizSummaryArea').classList.add('hidden');
      document.getElementById('quizPlayArea').classList.remove('hidden');
      renderCurrentQuestion();
    }

    window.addEventListener('DOMContentLoaded', () => {
      renderTonesGrid();
      renderCurrentQuestion();
    });
  </script>
</Layout>