---
import Layout from '../../../layout.astro';
import { lessons } from '../../../data/listeningLessons.js';

// Sắp xếp danh sách bài học theo thứ tự từ A-Z
const sortedLessons = [...lessons].sort((a, b) => a.title.localeCompare(b.title));
---

<Layout 
  title="Vietnamese Listening Practice Hub | Northern & Southern Accents | Havie" 
  description="Practice listening to real Vietnamese with audio, interactive transcripts, and English translations. Choose your preferred Northern (Hanoi) or Southern (Saigon) accent for each lesson."
>
  <main class="max-w-6xl mx-auto px-5 sm:px-8 py-10 sm:py-16">
    
    <!-- HERO SECTION -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-amber-100/90 via-orange-100/50 to-stone-200/70 border-2 border-amber-300/80 p-8 sm:p-12 mb-12 shadow-md text-center max-w-5xl mx-auto">
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-red-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-amber-500/20 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-2xl mx-auto space-y-5">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/95 backdrop-blur-md border border-amber-300 text-xs font-black tracking-wider uppercase text-amber-900 shadow-2xs">
          <span>🎧</span> Interactive Learning Hub
        </div>

        <h1 class="text-3xl sm:text-5xl font-black tracking-tight font-brand text-slate-900">
          <span class="text-red-600">Vietnamese Listening Practice</span>
        </h1>

        <p class="text-stone-700 text-base sm:text-lg font-medium leading-relaxed">
          Improve your listening comprehension with real-world conversations. Choose your preferred <span class="text-slate-900 font-bold">Northern (Hanoi)</span> or <span class="text-slate-900 font-bold">Southern (Saigon)</span> accent in every lesson!
        </p>
        
        <div class="pt-3 flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm font-bold text-stone-700">
          <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/95 border border-amber-200 shadow-2xs">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
            <span>{lessons.length} Real-world Lessons</span>
          </div>
          <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/95 border border-amber-200 shadow-2xs">
            <span>📚</span>
            <span>Levels from A1 to B1</span>
          </div>
          <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/95 border border-amber-200 shadow-2xs">
            <span>🎯</span>
            <span>Quizzes & Key Vocabulary</span>
          </div>
        </div>
      </div>
    </div>

    <!-- FILTER BUTTONS -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 mb-12">
      <button 
        type="button" 
        data-filter="all"
        class="filter-btn px-6 py-3 rounded-2xl text-sm font-black transition cursor-pointer bg-slate-900 text-white shadow-md hover:bg-slate-800"
      >
        All Lessons ({lessons.length})
      </button>
      <button 
        type="button" 
        data-filter="Beginner (A1)"
        class="filter-btn px-6 py-3 rounded-2xl text-sm font-black transition cursor-pointer bg-white text-stone-700 hover:bg-amber-50 border border-stone-200 shadow-xs"
      >
        🟡 Beginner (A1)
      </button>
      <button 
        type="button" 
        data-filter="Elementary (A2)"
        class="filter-btn px-6 py-3 rounded-2xl text-sm font-black transition cursor-pointer bg-white text-stone-700 hover:bg-orange-50 border border-stone-200 shadow-xs"
      >
        🟠 Elementary (A2)
      </button>
      <button 
        type="button" 
        data-filter="Intermediate (B1)"
        class="filter-btn px-6 py-3 rounded-2xl text-sm font-black transition cursor-pointer bg-white text-stone-700 hover:bg-rose-50 border border-stone-200 shadow-xs"
      >
        🔴 Intermediate (B1)
      </button>
    </div>

    <!-- LESSONS GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {sortedLessons.map((lesson) => {
        const isA1 = lesson.level.includes('A1');
        const isA2 = lesson.level.includes('A2');

        // Phân bổ màu sắc đồng bộ tone ấm (Vàng - Cam - Đỏ)
        const levelColor = isA1 
          ? 'bg-amber-50 text-amber-800 border-amber-200' 
          : isA2 
          ? 'bg-orange-50 text-orange-800 border-orange-200' 
          : 'bg-rose-50 text-rose-800 border-rose-200';

        const cardBgGradient = isA1
          ? 'bg-gradient-to-br from-amber-50/50 via-white to-white'
          : isA2
          ? 'bg-gradient-to-br from-orange-50/50 via-white to-white'
          : 'bg-gradient-to-br from-rose-50/50 via-white to-white';

        const cardBorder = isA1
          ? 'border-amber-200 hover:border-amber-400'
          : isA2
          ? 'border-orange-200 hover:border-orange-400'
          : 'border-rose-200 hover:border-rose-400';

        return (
          <a 
            href={`/resources/listening/${lesson.slug}`}
            data-level={lesson.level}
            class={`lesson-card ${cardBgGradient} rounded-3xl p-7 border ${cardBorder} shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group cursor-pointer relative`}
          >
            <div class="space-y-4">
              <div class="flex items-center justify-end">
                <span class={`text-xs font-black px-3.5 py-1.5 rounded-full border ${levelColor}`}>
                  {lesson.level}
                </span>
              </div>

              <div class="space-y-2">
                <h3 class="text-xl sm:text-2xl font-black text-slate-900 transition-colors font-brand tracking-tight">
                  {lesson.title}
                </h3>
                <p class="text-stone-600 text-sm sm:text-base line-clamp-2 font-medium leading-relaxed">
                  {lesson.description}
                </p>
              </div>
            </div>

            <div class="mt-8 pt-4 border-t border-stone-200/60 flex items-center justify-between">
              <span class="inline-flex items-center gap-2 text-sm font-extrabold text-stone-700 transition-colors">
                <span class="w-8 h-8 rounded-full bg-white shadow-2xs flex items-center justify-center transition-colors">🎧</span>
                <span>Listen & Practice</span>
              </span>
              <span class="w-8 h-8 rounded-full bg-white shadow-2xs group-hover:bg-slate-900 group-hover:text-white flex items-center justify-center font-black transition-all group-hover:translate-x-1">
                →
              </span>
            </div>
          </a>
        );
      })}
    </div>

  </main>

  <script is:inline>
    const filterBtns = document.querySelectorAll('.filter-btn');
    const lessonCards = document.querySelectorAll('.lesson-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-slate-900', 'text-white', 'shadow-md');
          b.classList.add('bg-white', 'text-stone-700', 'border', 'border-stone-200', 'shadow-xs');
        });
        btn.classList.remove('bg-white', 'text-stone-700', 'border', 'border-stone-200', 'shadow-xs');
        btn.classList.add('bg-slate-900', 'text-white', 'shadow-md');

        const filterValue = btn.getAttribute('data-filter');

        lessonCards.forEach(card => {
          const level = card.getAttribute('data-level');
          if (filterValue === 'all' || level === filterValue) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>