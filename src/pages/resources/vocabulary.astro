---
// src/pages/resources/vocabulary.astro
import Layout from '../../layout.astro';
import allTopics from '../../data/vocabData.js';

const freeTopics = Object.entries(allTopics).filter(([_, topic]) => topic.type === 'free');
---

<Layout 
  title="Vocabulary Lab | Havie Vietnamese"
  description="Practice and memorize Vietnamese vocabulary with interactive flashcards, matching games, multiple-choice quizzes, and word scramble challenges."
>
  <Fragment slot="head">
    <style>
      .curved-underline {
        position: relative;
        display: inline-block;
      }
      .curved-underline::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 100%;
        height: 6px;
        border-bottom: 3.5px solid #ef7218;
        border-radius: 50%;
        transform: rotate(-1.5deg);
      }
    </style>
  </Fragment>

  <!-- CONTAINER THAY ĐỔI ĐỘ RỘNG LINH HOẠT THEO TRẠNG THÁI -->
  <main id="pageMainContainer" class="min-h-screen py-10 px-5 sm:px-8 font-brand max-w-6xl mx-auto flex flex-col justify-between transition-all duration-300">
    
    <div>
      <!-- TOP NAV / BREADCRUMB & DROPDOWN -->
      <div class="flex items-center justify-between gap-4 mb-6">
        <!-- Chỉ hiện khi đã vào trang chi tiết bài từ vựng -->
        <div id="breadcrumbWrapper" style="display: none;">
          <a href="/resources/vocabulary" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-stone-200 text-xs font-extrabold text-red-600 hover:border-red-300 shadow-2xs transition">
            ← VOCABULARY LAB
          </a>
        </div>
        <div></div>

        <!-- DROPDOWN SELECTOR -->
        <div id="topicSelectorWrapper" class="relative w-36 sm:w-44 shrink-0" style="display: none;">
          <button type="button" id="dropdownToggleBtn" class="w-full px-4 py-2.5 rounded-2xl bg-white border border-stone-200 text-xs sm:text-sm font-extrabold text-slate-800 shadow-xs flex items-center justify-between cursor-pointer hover:border-red-300 transition-all">
            <span id="currentTopicLabel" class="truncate">Select Topic</span>
            <svg id="dropdownArrow" class="w-4 h-4 text-stone-400 shrink-0 ml-2 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          
          <div id="dropdownMenu" class="hidden absolute top-[calc(100%+8px)] right-0 w-full bg-white border border-stone-200 rounded-2xl shadow-xl py-2 z-50 max-h-[280px] overflow-y-auto">
            {freeTopics.map(([key, topic]) => (
              <div data-value={key} class="topic-option px-4 py-2.5 text-xs sm:text-sm font-extrabold text-slate-700 hover:bg-red-50 hover:text-red-600 cursor-pointer transition">
                {topic.title}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- PAGE TITLE & INTRO DESCRIPTION -->
      <div class="text-center max-w-2xl mx-auto mb-8">
        <div class="inline-block">
          <span class="text-[11px] font-extrabold uppercase tracking-widest text-red-500 bg-red-50 px-3 py-1 rounded-full border border-red-200 mb-1.5 inline-block">
            Practice & Master
          </span>
          <h1 id="topicTitle" class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight">
            <span class="curved-underline text-red-600">Vocabulary Lab</span>
          </h1>
        </div>
        <!-- Đoạn giới thiệu chỉ hiển thị ở trang tổng quan danh sách chủ đề -->
        <p id="vocabIntroDescription" class="text-stone-600 text-sm sm:text-base font-medium mt-3 leading-relaxed">
          Explore curated vocabulary topics with interactive flashcards, matching games, and quizzes to build your real-world Vietnamese conversational skills.
        </p>
      </div>

      <!-- AUDIO NOTICE BANNER -->
      <div id="audioNoticeBanner" class="hidden max-w-max mx-auto mb-6 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-[#fffaf0] border border-amber-200/80 text-amber-900 text-xs sm:text-sm font-bold shadow-2xs whitespace-nowrap">
          <span>💡</span>
          <span>Audio supports Northern accent (HN). Southern coming soon!</span>
        </div>
      </div>
      
      <!-- TABS CHUYỂN GAME -->
      <div id="gameTabsWrapper" class="hidden items-center justify-start md:justify-center gap-1.5 bg-stone-200/80 p-2 rounded-2xl max-w-2xl mx-auto w-full overflow-x-auto border border-stone-200 shadow-inner font-brand mb-8">
        <button data-game="flashcard" class="game-tab flex-1 min-w-[90px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer text-center text-stone-600 hover:text-slate-900">Flashcards</button>
        <button data-game="matching" class="game-tab flex-1 min-w-[80px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer text-center text-stone-600 hover:text-slate-900">Matching</button>
        <button data-game="mcqs" class="game-tab flex-1 min-w-[70px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer text-center text-stone-600 hover:text-slate-900">MCQs</button>
        <button data-game="scramble" class="game-tab flex-1 min-w-[85px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer text-center text-stone-600 hover:text-slate-900">Scramble</button>
        <button data-game="truefalse" class="game-tab flex-1 min-w-[95px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer text-center text-stone-600 hover:text-slate-900">True/False</button>
        <button data-game="fulllist" class="game-tab flex-1 min-w-[85px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer text-center text-stone-600 hover:text-slate-900">Full List</button>
      </div>

      <!-- MAIN CONTAINER -->
      <div id="mainGameBox" class="w-full">
        
        <!-- GIAO DIỆN CHỌN TOPIC -->
        <div id="noTopicSelectedState" class="w-full mt-2 sm:mt-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
            {freeTopics.map(([key, topic]) => (
              <a 
                href={`/resources/vocabulary?topic=${key}`}
                class="group bg-white hover:bg-stone-100/80 border border-stone-200/90 hover:border-red-200/80 rounded-3xl p-6 sm:p-7 transition-all duration-300 shadow-xs hover:shadow-md hover:-translate-y-1 flex flex-col justify-between min-h-[160px]"
              >
                <div class="space-y-3">
                  <div>
                    <span class="text-[11px] font-black uppercase tracking-wider text-red-600 bg-red-50/80 px-3 py-1 rounded-full border border-red-100 inline-block">
                      {topic.words?.length || 0} Words
                    </span>
                  </div>
                  
                  <h3 class="text-xl sm:text-2xl font-black text-slate-900 transition-colors tracking-tight">
                    {topic.title}
                  </h3>
                </div>

                <div class="pt-4 border-t border-stone-100 flex items-center justify-between text-xs sm:text-sm font-extrabold text-slate-700 group-hover:text-red-600 transition-colors">
                  <span>Start Practice</span>
                  <div class="w-7 h-7 rounded-full bg-stone-100 group-hover:bg-red-600 text-slate-600 group-hover:text-white flex items-center justify-center transition-all group-hover:translate-x-1">
                    →
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- 1. FLASHCARD PANEL -->
        <div id="game-flashcard" class="game-panel hidden bg-white rounded-[32px] p-6 sm:p-10 shadow-xl border border-stone-200/90 flex-col gap-5 w-full">
          <div class="grid grid-cols-3 items-center font-brand">
            <div class="flex justify-start">
              <button type="button" class="openGuideBtn text-red-600 hover:text-red-700 font-extrabold bg-red-50 hover:bg-red-100 px-3.5 py-1.5 rounded-xl transition cursor-pointer inline-flex items-center gap-1.5 border border-red-200/60 shadow-2xs text-xs sm:text-sm">
                <span>ℹ️</span> How to play
              </button>
            </div>
            <div class="flex justify-center">
              <span id="fc-counter" class="text-slate-700 font-black text-sm sm:text-base">1 / 5</span>
            </div>
            <div class="flex justify-end">
              <span class="text-stone-400 uppercase tracking-wider font-bold text-xs sm:text-sm">CLICK CARD TO FLIP 🔄</span>
            </div>
          </div>
          <div class="perspective w-full max-w-md mx-auto h-[230px] cursor-pointer" id="flashcard-container" style="perspective: 1000px;">
            <div class="card-inner relative w-full h-full transition-transform duration-500 rounded-3xl shadow-lg" id="flashcard-inner" style="transform-style: preserve-3d;">
              <div class="card-face absolute inset-0 w-full h-full rounded-3xl bg-gradient-to-br from-red-50/50 via-white to-stone-50 border-2 border-red-100 flex flex-col items-center justify-center p-5 text-center" style="backface-visibility: hidden;">
                <span class="text-xs font-black uppercase tracking-widest text-red-600 mb-1.5 font-brand">Vietnamese Word</span>
                <div class="font-brand text-2xl sm:text-3xl font-black text-slate-900 leading-tight px-4 mb-3" id="fc-front">Word</div>
                <div class="z-10" onclick="event.stopPropagation()">
                  <button type="button" id="speakAudioBtn" class="px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 font-extrabold text-xs rounded-full shadow-2xs transition cursor-pointer inline-flex items-center gap-1.5 border border-red-200">
                    🔊 Listen
                  </button>
                </div>
              </div>
              <div class="card-face absolute inset-0 w-full h-full rounded-3xl bg-slate-900 text-white flex flex-col items-center justify-center p-5 text-center" style="backface-visibility: hidden; transform: rotateY(180deg);">
                <span class="text-xs font-black uppercase tracking-widest text-amber-400 mb-1.5 font-brand">English Meaning</span>
                <div class="font-brand text-xl sm:text-2xl font-black text-white leading-tight px-4" id="fc-back">Meaning</div>
              </div>
            </div>
          </div>
          <div class="flex justify-center gap-4 pt-1 font-brand">
            <button id="prevCardBtn" class="px-8 py-3.5 bg-stone-100 hover:bg-stone-200 text-slate-800 font-extrabold rounded-2xl text-sm sm:text-base transition cursor-pointer shadow-xs">← Prev</button>
            <button id="nextCardBtn" class="px-10 py-3.5 bg-red-600 hover:bg-red-700 text-white font-black rounded-2xl text-sm sm:text-base shadow-lg shadow-red-600/30 cursor-pointer transition">Next →</button>
          </div>
        </div>

        <!-- 2. MATCHING PANEL -->
        <div id="game-matching" class="game-panel hidden bg-white rounded-[32px] p-6 sm:p-10 shadow-xl border border-stone-200/90 flex-col gap-4 w-full font-brand">
          <div class="flex justify-between items-center font-brand">
            <button type="button" class="openGuideBtn text-red-600 hover:text-red-700 font-extrabold bg-red-50 hover:bg-red-100 px-3.5 py-1.5 rounded-xl transition cursor-pointer inline-flex items-center gap-1.5 border border-red-200/60 shadow-2xs text-xs sm:text-sm">
              <span>ℹ️</span> How to play
            </button>
            <span></span>
          </div>
          <div id="match-setup" class="flex flex-col items-center justify-center text-center py-4 space-y-4 my-auto">
            <div class="w-14 h-14 bg-red-50 text-red-600 rounded-2xl flex items-center justify-center text-2xl shadow-inner border border-red-100">🧩</div>
            <div class="space-y-1">
              <h3 class="font-brand text-xl sm:text-2xl font-black text-slate-900 tracking-tight">Enter number of pairs to play</h3>
              <p class="text-stone-500 text-xs sm:text-sm">Total available words in this topic: <span id="match-total-words" class="font-bold text-slate-900">5</span></p>
            </div>
            <div class="flex items-center justify-center gap-2.5 max-w-xs mx-auto w-full pt-1">
              <input type="number" id="match-custom-count" min="1" value="5" class="w-32 px-4 py-2.5 rounded-xl border border-stone-300 font-bold text-center text-sm outline-none focus:border-red-600 bg-stone-50 transition" />
              <button type="button" id="startMatchCustomBtn" class="px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl text-xs shadow-md cursor-pointer transition shrink-0">Start →</button>
            </div>
            <p id="match-error-msg" class="text-xs font-bold text-red-600 min-h-[16px]"></p>
          </div>

          <div id="match-play-area" class="flex-col gap-4 w-full" style="display: none;">
            <div class="flex justify-between items-center text-xs font-bold">
              <button type="button" id="backToMatchSetup" class="px-3 py-1 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-xl transition cursor-pointer font-bold">← Change Count</button>
              <span class="bg-red-50 text-red-600 px-3 py-1 rounded-xl border border-red-200 text-xs font-black shadow-2xs" id="match-score">Matched: 0 / 5</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><div id="match-vn-col" class="flex flex-col gap-2"></div><div id="match-en-col" class="flex flex-col gap-2"></div></div>
            <div id="match-msg" class="text-center font-bold text-emerald-600 text-xs bg-emerald-50 border border-emerald-200 py-3 rounded-xl" style="display: none;"></div>
          </div>
        </div>

        <!-- 3. MCQS PANEL -->
        <div id="game-mcqs" class="game-panel hidden bg-white rounded-[32px] p-6 sm:p-10 shadow-xl border border-stone-200/90 flex-col gap-5 w-full font-brand">
          <div class="grid grid-cols-3 items-center font-brand">
            <div class="flex justify-start">
              <button type="button" class="openGuideBtn text-red-600 hover:text-red-700 font-extrabold bg-red-50 hover:bg-red-100 px-3.5 py-1.5 rounded-xl transition cursor-pointer inline-flex items-center gap-1.5 border border-red-200/60 shadow-2xs text-xs sm:text-sm">
                <span>ℹ️</span> How to play
              </button>
            </div>
            <div class="flex justify-center">
              <span id="mcq-progress" class="text-slate-700 font-black text-sm sm:text-base">1 / 5</span>
            </div>
            <div class="flex justify-end">
              <span id="mcq-score-box" class="text-red-600 font-black text-sm sm:text-base">Score: 0</span>
            </div>
          </div>
          <div class="bg-gradient-to-br from-red-50/50 via-white to-stone-50 border-2 border-red-100 rounded-3xl p-6 text-center max-w-md mx-auto w-full space-y-2.5 shadow-sm">
            <span class="text-xs font-black uppercase tracking-widest text-red-600 font-brand">What is the correct word?</span>
            <h3 class="font-brand text-2xl sm:text-3xl font-black text-slate-900 leading-tight mb-2" id="mcq-word">Word</h3>
            <button type="button" id="speakMcqBtn" class="px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 font-extrabold text-xs rounded-full shadow-2xs transition cursor-pointer inline-flex items-center gap-1.5 border border-red-200 mx-auto">🔊 Listen</button>
          </div>
          <div id="mcq-options" class="grid grid-cols-1 gap-2.5 max-w-md mx-auto w-full"></div>
          <div id="mcq-feedback-area" class="text-center pt-1"></div>
        </div>

        <!-- 4. SCRAMBLE PANEL -->
        <div id="game-scramble" class="game-panel hidden bg-white rounded-[32px] p-6 sm:p-10 shadow-xl border border-stone-200/90 flex-col gap-5 w-full text-center font-brand">
          <div class="grid grid-cols-3 items-center font-brand">
            <div class="flex justify-start">
              <button type="button" class="openGuideBtn text-red-600 hover:text-red-700 font-extrabold bg-red-50 hover:bg-red-100 px-3.5 py-1.5 rounded-xl transition cursor-pointer inline-flex items-center gap-1.5 border border-red-200/60 shadow-2xs text-xs sm:text-sm">
                <span>ℹ️</span> How to play
              </button>
            </div>
            <div class="flex justify-center">
              <span id="scramble-progress" class="text-slate-700 font-black text-sm sm:text-base">1 / 5</span>
            </div>
            <div class="flex justify-end">
              <span id="scramble-score-box" class="text-red-600 font-black text-sm sm:text-base">Score: 0</span>
            </div>
          </div>
          <div class="bg-gradient-to-b from-stone-50/80 to-white border border-stone-200/90 rounded-2xl p-6 max-w-md mx-auto w-full space-y-3 shadow-sm">
            <div class="text-stone-400 font-bold text-xs uppercase tracking-widest">💡 Hint</div>
            <div id="scramble-hint" class="text-slate-900 font-black text-lg sm:text-xl font-brand">Meaning</div>
            <button type="button" id="speakScrBtn" class="px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 font-extrabold text-xs rounded-full shadow-2xs transition cursor-pointer inline-flex items-center gap-1.5 border border-red-200 mx-auto">🔊 Listen</button>
            <div class="w-10 h-0.5 bg-stone-200 mx-auto"></div>
            <div id="scramble-letters" class="font-brand text-xl sm:text-2xl font-black text-red-600 tracking-[0.15em] py-1">word</div>
          </div>
          <div class="flex gap-2.5 max-w-md mx-auto w-full" id="scramble-action-area">
            <input type="text" id="scramble-input" placeholder="Type here..." class="w-full px-4 py-2.5 rounded-xl border border-stone-300 font-bold text-center text-sm outline-none focus:border-red-600 bg-stone-50/50 transition" />
            <button id="checkScrambleBtn" class="px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-xs sm:text-sm shadow-md cursor-pointer transition shrink-0">Check</button>
          </div>
          <div id="scramble-feedback" class="text-xs sm:text-sm font-bold min-h-[20px]"></div>
        </div>

        <!-- 5. TRUE / FALSE PANEL -->
        <div id="game-truefalse" class="game-panel hidden bg-white rounded-[32px] p-6 sm:p-10 shadow-xl border border-stone-200/90 flex-col gap-5 w-full text-center font-brand">
          <div class="grid grid-cols-3 items-center font-brand">
            <div class="flex justify-start">
              <button type="button" class="openGuideBtn text-red-600 hover:text-red-700 font-extrabold bg-red-50 hover:bg-red-100 px-3.5 py-1.5 rounded-xl transition cursor-pointer inline-flex items-center gap-1.5 border border-red-200/60 shadow-2xs text-xs sm:text-sm">
                <span>ℹ️</span> How to play
              </button>
            </div>
            <div class="flex justify-center">
              <span id="tf-progress" class="text-slate-700 font-black text-sm sm:text-base">1 / 5</span>
            </div>
            <div class="flex justify-end">
              <span id="tf-score-box" class="text-red-600 font-black text-sm sm:text-base">Score: 0</span>
            </div>
          </div>
          <div class="bg-gradient-to-b from-stone-50/80 to-white border border-stone-200/90 rounded-2xl p-6 max-w-md mx-auto w-full space-y-3 shadow-sm">
            <span class="text-[10px] font-extrabold uppercase tracking-widest text-stone-400">Translate Check</span>
            <div id="tf-word" class="font-brand text-xl sm:text-2xl font-black text-slate-900 leading-tight px-2">Word</div>
            <button type="button" id="speakTfBtn" class="px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 font-extrabold text-xs rounded-full shadow-2xs transition cursor-pointer inline-flex items-center gap-1.5 border border-red-200 mx-auto">🔊 Listen</button>
            <div class="w-10 h-0.5 bg-stone-200 mx-auto"></div>
            <div id="tf-meaning" class="font-brand text-base sm:text-lg font-extrabold text-red-600 px-2">Meaning</div>
          </div>
          <div class="flex justify-center gap-3" id="tf-buttons-wrapper">
            <button id="tfTrueBtn" class="px-8 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold rounded-xl text-xs sm:text-sm shadow-md cursor-pointer transition">True</button>
            <button id="tfFalseBtn" class="px-8 py-2.5 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-xl text-xs sm:text-sm shadow-md cursor-pointer transition">False</button>
          </div>
          <div id="tf-feedback" class="text-xs sm:text-sm font-bold min-h-[20px]"></div>
        </div>

        <!-- 6. FULL VOCABULARY LIST VIEW -->
        <div id="game-fulllist" class="game-panel hidden bg-white rounded-[32px] p-6 sm:p-10 shadow-xl border border-stone-300 flex flex-col gap-6 w-full max-w-4xl mx-auto font-brand">
          <div class="flex justify-between items-center gap-4 pb-3 border-b-2 border-stone-200">
            <h2 class="text-lg sm:text-xl font-bold text-slate-700 tracking-tight">Vocabulary List</h2>
            <span id="list-total-count" class="shrink-0 px-4 py-1.5 bg-red-50 border border-red-300 rounded-2xl text-xs sm:text-sm font-black text-red-600 shadow-2xs"></span>
          </div>

          <div class="bg-white border-2 border-stone-300 rounded-2xl overflow-hidden shadow-xs">
            <div class="max-h-[480px] overflow-y-auto">
              <table class="w-full table-fixed border-collapse">
                <colgroup>
                  <col class="w-[28%]">
                  <col class="w-[47%]">
                  <col class="w-[25%]">
                </colgroup>
                <thead class="bg-stone-100 sticky top-0 border-b-2 border-stone-300 text-stone-800 text-xs uppercase tracking-wider font-black z-10">
                  <tr>
                    <th class="py-3 px-2 sm:px-4 text-center">Vietnamese</th>
                    <th class="py-3 px-2 sm:px-4 text-center">English Meaning</th>
                    <th class="py-3 px-2 sm:px-4 text-center">Audio</th>
                  </tr>
                </thead>
                <tbody id="vocab-table-body" class="divide-y divide-stone-200 text-sm sm:text-base font-bold text-slate-900 [&_td]:text-center [&_td]:px-2 [&_td]:py-2.5">
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- MODAL HƯỚNG DẪN GAME -->
  <div id="guideModal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 flex items-center justify-center p-4 font-brand">
    <div class="bg-white rounded-3xl max-w-md w-full p-7 shadow-2xl border border-stone-200 space-y-4 relative">
      <div class="flex items-center justify-between">
        <h3 class="text-xl font-black text-slate-900 flex items-center gap-2">📖 How to Play</h3>
        <button type="button" id="closeGuideBtn" class="w-8 h-8 rounded-full bg-stone-100 hover:bg-stone-200 text-slate-500 font-bold flex items-center justify-center cursor-pointer transition">✕</button>
      </div>
      <p id="gameInstruction" class="text-stone-600 text-sm sm:text-base leading-relaxed font-medium">
        Loading instructions...
      </p>
      <button type="button" id="gotItBtn" class="w-full py-3.5 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-xl text-sm shadow-md cursor-pointer transition">
        Got it, let's play!
      </button>
    </div>
  </div>

  <script is:inline define:vars={{ allTopics }}>
    const urlParams = new URLSearchParams(window.location.search);
    let userCode = (urlParams.get('code') || '').trim().toUpperCase();
    let currentTopicKey = urlParams.get('topic');

    if (userCode === 'AVB01') currentTopicKey = 'daily_activities';
    else if (userCode === 'KVN01') currentTopicKey = 'kitchen_north';
    else if (userCode === 'KVS01') currentTopicKey = 'kitchen_south';

    const currentTopic = (currentTopicKey && allTopics && allTopics[currentTopicKey]) ? allTopics[currentTopicKey] : null;

    const toggleBtn = document.getElementById('dropdownToggleBtn');
    const dropdownMenu = document.getElementById('dropdownMenu');
    const dropdownArrow = document.getElementById('dropdownArrow');
    const vocabIntroDescription = document.getElementById('vocabIntroDescription');
    
    if (currentTopic) {
      document.getElementById('currentTopicLabel').textContent = currentTopic.title;
      document.getElementById('pageMainContainer').classList.remove('max-w-6xl');
      document.getElementById('pageMainContainer').classList.add('max-w-4xl');
      document.getElementById('breadcrumbWrapper').style.display = 'block';
      document.getElementById('topicSelectorWrapper').style.display = 'block';
      document.getElementById('audioNoticeBanner').classList.remove('hidden');
      if (vocabIntroDescription) vocabIntroDescription.style.display = 'none'; // Ẩn đoạn giới thiệu khi vào trang chi tiết
    } else {
      document.getElementById('topicSelectorWrapper').style.display = 'none';
      if (vocabIntroDescription) vocabIntroDescription.style.display = 'block'; // Hiện đoạn giới thiệu ở trang chủ danh sách chủ đề
    }

    if (userCode) document.getElementById('topicSelectorWrapper').style.display = 'none';

    if (toggleBtn) {
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdownMenu.classList.toggle('hidden');
        dropdownArrow.classList.toggle('rotate-180');
      });
    }
    document.addEventListener('click', () => {
      if (dropdownMenu) dropdownMenu.classList.add('hidden');
      if (dropdownArrow) dropdownArrow.classList.remove('rotate-180');
    });

    document.querySelectorAll('.topic-option').forEach(opt => {
      const val = opt.getAttribute('data-value');
      if (val === currentTopicKey) opt.classList.add('bg-red-50', 'text-red-600', 'font-extrabold');
      opt.addEventListener('click', () => window.location.href = `/resources/vocabulary?topic=${val}`);
    });

    const guideModal = document.getElementById('guideModal');
    document.querySelectorAll('.openGuideBtn').forEach(btn => {
      btn.addEventListener('click', () => guideModal.classList.remove('hidden'));
    });
    document.getElementById('closeGuideBtn').addEventListener('click', () => guideModal.classList.add('hidden'));
    document.getElementById('gotItBtn').addEventListener('click', () => guideModal.classList.add('hidden'));
    guideModal.addEventListener('click', (e) => { if (e.target === guideModal) guideModal.classList.add('hidden'); });

    const speakWord = (text) => {
      if (!('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'vi-VN';
      utterance.rate = 0.9;
      window.speechSynthesis.speak(utterance);
    };

    const instructions = {
      flashcard: "👉 Click the card to flip and reveal the English meaning. Use Prev/Next to navigate, and click 'Listen' to hear audio.",
      matching: "👉 Enter how many pairs you want to practice, then select a Vietnamese word and match it with its correct English meaning on the right.",
      mcqs: "👉 Read the vocabulary word, listen to the audio if needed, and choose the correct answer from 4 options.",
      scramble: "👉 Look at the English hint, un-scramble the letters, type the correct Vietnamese word into the input box, and hit Check.",
      truefalse: "👉 Check if the displayed Vietnamese word matches the English meaning. Click True if correct and False if incorrect.",
      fulllist: "📜 Browse the complete vocabulary list for this topic. Click 'Listen' to hear the pronunciation of each word."
    };

    const updateInstruction = (gameId) => {
      const insEl = document.getElementById('gameInstruction');
      if (insEl && instructions[gameId]) {
        insEl.textContent = instructions[gameId];
      }
    };

    const lockedCodes = { 'daily_activities': 'AVB01', 'kitchen_north': 'KVN01', 'kitchen_south': 'KVS01', 'bedroom_expert': 'LOCKED', 'bathroom_expert': 'LOCKED' };

    if (!currentTopic) {
      document.getElementById('gameTabsWrapper').style.display = 'none';
      document.getElementById('noTopicSelectedState').style.display = 'block';
    } 
    else if ((allTopics[currentTopicKey] && allTopics[currentTopicKey].type === 'locked') && userCode !== lockedCodes[currentTopicKey]) {
      document.getElementById('gameTabsWrapper').style.display = 'none';
      document.getElementById('noTopicSelectedState').style.display = 'none';
      document.getElementById('topicTitle').innerHTML = `🔒 ${currentTopic.title} (Locked)`;
      document.getElementById('mainGameBox').innerHTML = `
        <div class="max-w-md mx-auto bg-white rounded-3xl p-8 border border-stone-200 text-center space-y-5 py-8 font-brand shadow-lg">
          <div class="w-14 h-14 bg-red-50 text-red-600 rounded-2xl mx-auto flex items-center justify-center text-xl shadow-inner border border-red-100">🔐</div>
          <div class="space-y-1.5">
            <span class="text-[10px] font-extrabold uppercase tracking-widest text-red-600 bg-red-50 px-3 py-1 rounded-full border border-red-100 inline-block">Student Portal Exclusive</span>
            <h2 class="text-xl font-black text-slate-900 tracking-tight">Yêu cầu mã khóa học</h2>
            <p class="text-stone-500 text-xs">Chủ đề này yêu cầu mã bài học hợp lệ. Vui lòng vào Student Portal để xác thực.</p>
          </div>
          <div class="space-y-2.5">
            <a href="/student" class="block w-full py-3.5 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-xl text-xs sm:text-sm shadow-md transition">Đến Student Portal nhập mã →</a>
            <a href="/resources/vocabulary" class="block w-full py-3 bg-stone-100 hover:bg-stone-200 text-slate-700 font-bold rounded-xl text-xs sm:text-sm transition">Quay lại chọn chủ đề khác</a>
          </div>
        </div>`;
    } 
    else {
      document.getElementById('gameTabsWrapper').style.display = 'flex';
      document.getElementById('noTopicSelectedState').style.display = 'none';
      document.getElementById('topicTitle').textContent = currentTopic.title;

      let vocabData = currentTopic.words || [];

      const renderCompletionScreen = (panelId, cb, scoreText) => {
        const panel = document.getElementById(panelId);
        panel.innerHTML = `
          <div class="flex flex-col items-center justify-center text-center py-6 my-auto space-y-3 w-full font-brand">
            <div class="w-12 h-12 bg-red-50 rounded-full flex items-center justify-center text-xl shadow-sm border border-red-100 animate-bounce">🎯</div>
            <div class="space-y-1">
              <h3 class="font-brand text-lg sm:text-xl font-black text-slate-900 tracking-tight">Challenge Finished!</h3>
              ${scoreText ? `<div class="text-xs font-extrabold text-red-600 bg-red-50 px-3 py-1 rounded-xl border border-red-100 inline-block mt-1">${scoreText}</div>` : ''}
              <p class="text-stone-500 font-medium text-xs">Great job completing this vocabulary session.</p>
            </div>
            <button type="button" class="restart-btn px-5 py-2 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-xl text-xs shadow-md cursor-pointer transition mt-1">Play Again</button>
          </div>`;
        panel.querySelector('.restart-btn').addEventListener('click', cb);
      };

      const switchGame = (gameId) => {
        document.querySelectorAll('.game-panel').forEach(p => {
          p.style.display = 'none';
          p.classList.add('hidden');
        });
        document.querySelectorAll('.game-tab').forEach(t => {
          t.classList.remove('bg-white', 'text-slate-900', 'shadow-md', 'active');
          t.classList.add('text-stone-600');
        });
        
        const activePanel = document.getElementById(`game-${gameId}`);
        activePanel.style.display = 'flex';
        activePanel.classList.remove('hidden');

        const activeTab = document.querySelector(`[data-game="${gameId}"]`);
        activeTab.classList.add('bg-white', 'text-slate-900', 'shadow-md', 'active');
        activeTab.classList.remove('text-stone-600');

        updateInstruction(gameId);

        if (gameId === 'flashcard') initFlashcard();
        else if (gameId === 'matching') initMatchingSetup();
        else if (gameId === 'mcqs') initMcqs();
        else if (gameId === 'scramble') initScramble();
        else if (gameId === 'truefalse') initTrueFalse();
        else if (gameId === 'fulllist') initFullList();
      };

      // 1. Flashcards logic
      let fcIndex = 0;
      const initFlashcard = () => {
        fcIndex = 0;
        renderFlashcard();
      };
      const renderFlashcard = () => {
        const item = vocabData[fcIndex];
        document.getElementById('fc-counter').textContent = `${fcIndex + 1} / ${vocabData.length}`;
        document.getElementById('fc-front').textContent = item.vn;
        document.getElementById('fc-back').textContent = item.en;
        document.getElementById('flashcard-inner').style.transform = 'rotateY(0deg)';
      };

      document.getElementById('flashcard-container').addEventListener('click', () => {
        const inner = document.getElementById('flashcard-inner');
        const currentTransform = inner.style.transform;
        inner.style.transform = (!currentTransform || currentTransform === 'rotateY(0deg)') ? 'rotateY(180deg)' : 'rotateY(0deg)';
      });
      document.getElementById('speakAudioBtn').addEventListener('click', (e) => {
        e.stopPropagation();
        speakWord(vocabData[fcIndex].vn);
      });
      document.getElementById('prevCardBtn').addEventListener('click', () => {
        if (fcIndex > 0) { fcIndex--; renderFlashcard(); }
      });
      document.getElementById('nextCardBtn').addEventListener('click', () => {
        if (fcIndex < vocabData.length - 1) { fcIndex++; renderFlashcard(); }
        else {
          renderCompletionScreen('game-flashcard', initFlashcard);
        }
      });

      // 2. Matching logic
      const initMatchingSetup = () => {
        const setupDiv = document.getElementById('match-setup');
        const playDiv = document.getElementById('match-play-area');
        setupDiv.style.display = 'flex';
        playDiv.style.display = 'none';
        document.getElementById('match-total-words').textContent = vocabData.length;
        document.getElementById('match-custom-count').value = Math.min(5, vocabData.length);
        document.getElementById('match-error-msg').textContent = '';
      };

      document.getElementById('startMatchCustomBtn').addEventListener('click', () => {
        const count = parseInt(document.getElementById('match-custom-count').value);
        const errEl = document.getElementById('match-error-msg');
        if (isNaN(count) || count < 1 || count > vocabData.length) {
          errEl.textContent = `Please enter a number between 1 and ${vocabData.length}`;
          return;
        }
        errEl.textContent = '';
        document.getElementById('match-setup').style.display = 'none';
        document.getElementById('match-play-area').style.display = 'flex';
        startMatchingGame(count);
      });

      document.getElementById('backToMatchSetup').addEventListener('click', initMatchingSetup);

      const startMatchingGame = (count) => {
        const shuffled = [...vocabData].sort(() => 0.5 - Math.random()).slice(0, count);
        const vnCol = document.getElementById('match-vn-col');
        const enCol = document.getElementById('match-en-col');
        vnCol.innerHTML = '';
        enCol.innerHTML = '';

        let matchedCount = 0;
        document.getElementById('match-score').textContent = `Matched: 0 / ${count}`;
        document.getElementById('match-msg').style.display = 'none';

        const shuffledVn = [...shuffled].sort(() => 0.5 - Math.random());
        const shuffledEn = [...shuffled].sort(() => 0.5 - Math.random());

        let selectedVn = null;
        let selectedEn = null;

        const checkMatch = () => {
          if (selectedVn && selectedEn) {
            if (selectedVn.dataset.id === selectedEn.dataset.id) {
              selectedVn.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-800', 'opacity-50', 'pointer-events-none');
              selectedEn.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-800', 'opacity-50', 'pointer-events-none');
              matchedCount++;
              document.getElementById('match-score').textContent = `Matched: ${matchedCount} / ${count}`;
              if (matchedCount === count) {
                const msg = document.getElementById('match-msg');
                msg.textContent = "🎉 Excellent! All pairs matched correctly!";
                msg.style.display = 'block';
              }
            } else {
              selectedVn.classList.add('bg-red-100', 'border-red-400', 'text-red-700');
              selectedEn.classList.add('bg-red-100', 'border-red-400', 'text-red-700');
              setTimeout(() => {
                selectedVn.classList.remove('bg-red-100', 'border-red-400', 'text-red-700', 'bg-red-50', 'border-red-500');
                selectedEn.classList.remove('bg-red-100', 'border-red-400', 'text-red-700', 'bg-red-50', 'border-red-500');
              }, 600);
            }
            selectedVn = null;
            selectedEn = null;
          }
        };

        shuffledVn.forEach(item => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = item.vn;
          btn.dataset.id = item.vn;
          btn.className = 'w-full py-3 px-4 rounded-xl border border-stone-200 bg-white hover:bg-stone-50 text-slate-800 font-extrabold text-xs sm:text-sm transition shadow-2xs cursor-pointer text-center';
          btn.addEventListener('click', () => {
            if (selectedVn) selectedVn.classList.remove('bg-red-50', 'border-red-500');
            selectedVn = btn;
            btn.classList.add('bg-red-50', 'border-red-500');
            speakWord(item.vn);
            checkMatch();
          });
          vnCol.appendChild(btn);
        });

        shuffledEn.forEach(item => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = item.en;
          btn.dataset.id = item.vn;
          btn.className = 'w-full py-3 px-4 rounded-xl border border-stone-200 bg-white hover:bg-stone-50 text-slate-800 font-extrabold text-xs sm:text-sm transition shadow-2xs cursor-pointer text-center';
          btn.addEventListener('click', () => {
            if (selectedEn) selectedEn.classList.remove('bg-red-50', 'border-red-500');
            selectedEn = btn;
            btn.classList.add('bg-red-50', 'border-red-500');
            checkMatch();
          });
          enCol.appendChild(btn);
        });
      };

      // 3. MCQs logic
      let mcqIndex = 0;
      let mcqScore = 0;
      let mcqList = [];
      const initMcqs = () => {
        mcqIndex = 0;
        mcqScore = 0;
        mcqList = [...vocabData].sort(() => 0.5 - Math.random());
        renderMcqQuestion();
      };

      const renderMcqQuestion = () => {
        if (mcqIndex >= mcqList.length) {
          renderCompletionScreen('game-mcqs', initMcqs, `Score: ${mcqScore} / ${mcqList.length}`);
          return;
        }
        const current = mcqList[mcqIndex];
        document.getElementById('mcq-progress').textContent = `${mcqIndex + 1} / ${mcqList.length}`;
        document.getElementById('mcq-score-box').textContent = `Score: ${mcqScore}`;
        document.getElementById('mcq-word').textContent = current.vn;
        document.getElementById('mcq-feedback-area').innerHTML = '';

        const wrongOptions = vocabData.filter(w => w.en !== current.en).sort(() => 0.5 - Math.random()).slice(0, 3);
        const options = [...wrongOptions, current].sort(() => 0.5 - Math.random());

        const optContainer = document.getElementById('mcq-options');
        optContainer.innerHTML = '';

        options.forEach(opt => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = opt.en;
          btn.className = 'w-full py-3.5 px-4 rounded-2xl border border-stone-200 bg-white hover:bg-stone-50 text-slate-800 font-extrabold text-sm sm:text-base transition shadow-2xs cursor-pointer text-center';
          btn.addEventListener('click', () => {
            const allBtns = optContainer.querySelectorAll('button');
            allBtns.forEach(b => b.disabled = true);
            if (opt.en === current.en) {
              btn.className = 'w-full py-3.5 px-4 rounded-2xl border border-emerald-500 bg-emerald-50 text-emerald-800 font-extrabold text-sm sm:text-base shadow-2xs text-center';
              mcqScore++;
              document.getElementById('mcq-score-box').textContent = `Score: ${mcqScore}`;
            } else {
              btn.className = 'w-full py-3.5 px-4 rounded-2xl border border-red-400 bg-red-50 text-red-700 font-extrabold text-sm sm:text-base shadow-2xs text-center';
              allBtns.forEach(b => {
                if (b.textContent === current.en) b.className = 'w-full py-3.5 px-4 rounded-2xl border border-emerald-500 bg-emerald-50 text-emerald-800 font-extrabold text-sm sm:text-base shadow-2xs text-center';
              });
            }
            setTimeout(() => {
              mcqIndex++;
              renderMcqQuestion();
            }, 1000);
          });
          optContainer.appendChild(btn);
        });
      };
      document.getElementById('speakMcqBtn').addEventListener('click', () => {
        speakWord(mcqList[mcqIndex].vn);
      });

      // 4. Scramble logic
      let scrIndex = 0;
      let scrScore = 0;
      let scrList = [];
      const initScramble = () => {
        scrIndex = 0;
        scrScore = 0;
        scrList = [...vocabData].sort(() => 0.5 - Math.random());
        renderScrambleQuestion();
      };

      const renderScrambleQuestion = () => {
        if (scrIndex >= scrList.length) {
          renderCompletionScreen('game-scramble', initScramble, `Score: ${scrScore} / ${scrList.length}`);
          return;
        }
        const current = scrList[scrIndex];
        document.getElementById('scramble-progress').textContent = `${scrIndex + 1} / ${scrList.length}`;
        document.getElementById('scramble-score-box').textContent = `Score: ${scrScore}`;
        document.getElementById('scramble-hint').textContent = current.en;
        document.getElementById('scramble-feedback').textContent = '';
        document.getElementById('scramble-input').value = '';
        document.getElementById('scramble-input').disabled = false;
        document.getElementById('checkScrambleBtn').disabled = false;

        const scrambled = current.vn.split('').sort(() => 0.5 - Math.random()).join(' ');
        document.getElementById('scramble-letters').textContent = scrambled;
      };

      document.getElementById('speakScrBtn').addEventListener('click', () => {
        speakWord(scrList[scrIndex].vn);
      });

      const handleScrambleCheck = () => {
        const input = document.getElementById('scramble-input');
        const feedback = document.getElementById('scramble-feedback');
        const current = scrList[scrIndex];
        if (!input.value.trim()) return;

        if (input.value.trim().toLowerCase() === current.vn.toLowerCase()) {
          feedback.textContent = "✅ Correct!";
          feedback.className = "text-xs sm:text-sm font-bold text-emerald-600 min-h-[20px]";
          scrScore++;
          document.getElementById('scramble-score-box').textContent = `Score: ${scrScore}`;
          input.disabled = true;
          document.getElementById('checkScrambleBtn').disabled = true;
          setTimeout(() => {
            scrIndex++;
            renderScrambleQuestion();
          }, 1000);
        } else {
          feedback.textContent = `❌ Incorrect. The correct word is: ${current.vn}`;
          feedback.className = "text-xs sm:text-sm font-bold text-red-600 min-h-[20px]";
        }
      };

      document.getElementById('checkScrambleBtn').addEventListener('click', handleScrambleCheck);
      document.getElementById('scramble-input').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') handleScrambleCheck();
      });

      // 5. True / False logic
      let tfIndex = 0;
      let tfScore = 0;
      let tfList = [];
      const initTrueFalse = () => {
        tfIndex = 0;
        tfScore = 0;
        tfList = [...vocabData].sort(() => 0.5 - Math.random());
        renderTfQuestion();
      };

      const renderTfQuestion = () => {
        if (tfIndex >= tfList.length) {
          renderCompletionScreen('game-truefalse', initTrueFalse, `Score: ${tfScore} / ${tfList.length}`);
          return;
        }
        const current = tfList[tfIndex];
        document.getElementById('tf-progress').textContent = `${tfIndex + 1} / ${tfList.length}`;
        document.getElementById('tf-score-box').textContent = `Score: ${tfScore}`;
        document.getElementById('tf-feedback').textContent = '';
        document.getElementById('tfTrueBtn').disabled = false;
        document.getElementById('tfFalseBtn').disabled = false;

        document.getElementById('tf-word').textContent = current.vn;

        const isTrue = Math.random() < 0.5;
        let displayMeaning = current.en;
        if (!isTrue) {
          const wrong = vocabData.filter(w => w.en !== current.en);
          if (wrong.length > 0) {
            displayMeaning = wrong[Math.floor(Math.random() * wrong.length)].en;
          }
        }
        document.getElementById('tf-meaning').textContent = displayMeaning;
        document.getElementById('tf-buttons-wrapper').dataset.correct = (displayMeaning === current.en) ? 'true' : 'false';
      };

      document.getElementById('speakTfBtn').addEventListener('click', () => {
        speakWord(tfList[tfIndex].vn);
      });

      const handleTfAnswer = (userAns) => {
        const correctAns = document.getElementById('tf-buttons-wrapper').dataset.correct === 'true';
        const feedback = document.getElementById('tf-feedback');
        document.getElementById('tfTrueBtn').disabled = true;
        document.getElementById('tfFalseBtn').disabled = true;

        if (userAns === correctAns) {
          feedback.textContent = "✅ Correct!";
          feedback.className = "text-xs sm:text-sm font-bold text-emerald-600 min-h-[20px]";
          tfScore++;
          document.getElementById('tf-score-box').textContent = `Score: ${tfScore}`;
        } else {
          feedback.textContent = "❌ Incorrect!";
          feedback.className = "text-xs sm:text-sm font-bold text-red-600 min-h-[20px]";
        }
        setTimeout(() => {
          tfIndex++;
          renderTfQuestion();
        }, 1000);
      };

      document.getElementById('tfTrueBtn').addEventListener('click', () => handleTfAnswer(true));
      document.getElementById('tfFalseBtn').addEventListener('click', () => handleTfAnswer(false));

      // 6. Full List logic
      const initFullList = () => {
        const tbody = document.getElementById('vocab-table-body');
        tbody.innerHTML = '';
        document.getElementById('list-total-count').textContent = `${vocabData.length} Words`;

        vocabData.forEach(item => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-stone-50 transition';

          const tdVn = document.createElement('td');
          tdVn.textContent = item.vn;
          tdVn.className = 'font-black text-slate-900 py-3 px-2 sm:px-4 text-center';

          const tdEn = document.createElement('td');
          tdEn.textContent = item.en;
          tdEn.className = 'font-medium text-stone-700 py-3 px-2 sm:px-4 text-center';

          const tdAudio = document.createElement('td');
          tdAudio.className = 'py-3 px-2 sm:px-4 text-center';
          const listenBtn = document.createElement('button');
          listenBtn.type = 'button';
          listenBtn.innerHTML = '🔊 Listen';
          listenBtn.className = 'px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 font-extrabold text-xs rounded-full shadow-2xs transition cursor-pointer inline-flex items-center gap-1 border border-red-200';
          listenBtn.addEventListener('click', () => speakWord(item.vn));
          tdAudio.appendChild(listenBtn);

          tr.appendChild(tdVn);
          tr.appendChild(tdEn);
          tr.appendChild(tdAudio);
          tbody.appendChild(tr);
        });
      };

      // Tab switcher event listeners
      document.querySelectorAll('.game-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          const gameId = tab.getAttribute('data-game');
          switchGame(gameId);
        });
      });

      // Khởi động mặc định vào flashcard khi load trang chi tiết
      switchGame('flashcard');
    }
  </script>
</Layout>