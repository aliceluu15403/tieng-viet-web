        descEl.textContent = "You manage survival basics and simple notices well. Strengthening fundamental sentence patterns will unlock B1.";
        recommendations = [
          "🔹 <strong>Core Grammar & Tense Markers:</strong> Solidify fundamental syntax and sentence structures.",
          "🔹 <strong>Service & Admin Interactions:</strong> Practice filling forms and navigating daily public exchanges.",
          "🔹 <strong>Pronunciation & Tone Accuracy:</strong> Eliminate subtle tone confusion in minimal pairs."
        ];
      } else {
        badgeEl.textContent = "🎯";
        titleEl.textContent = "Estimated Level: Beginner (A1)";
        descEl.textContent = "A great starting point! Focusing on the 6 tones and basic survival phrases will build a rock-solid foundation.";
        recommendations = [
          "🔹 <strong>The 6 Tones Mastery:</strong> Focus heavily on pitch contour exercises.",
          "🔹 <strong>Basic Pronunciation & Vocabulary:</strong> Build core survival vocabulary with Hang.",
          "🔹 <strong>Guided 1-on-1 Sessions:</strong> Book a trial session to establish proper vocal mechanics early."
        ];
      }

      recListEl.innerHTML = recommendations.map(item => `<li>${item}</li>`).join('');
      resultModal.classList.remove('hidden');
    });

    btnCloseModal.addEventListener('click', () => {
      resultModal.classList.add('hidden');
    });

    resultModal.addEventListener('click', (e) => {
      if (e.target === resultModal) resultModal.classList.add('hidden');
    });

    // Modal Control Script (Consultation Modal)
    const consultModal = document.getElementById('consultModal');
    const openTriggers = document.querySelectorAll('.open-modal-trigger');
    const closeConsultModalBtn = document.getElementById('closeConsultModalBtn');
    const consultForm = document.getElementById('consultForm');
    const successMessage = document.getElementById('successMessage');
    const btnCloseSuccess = document.getElementById('btnCloseSuccess');

    openTriggers.forEach(btn => {
      if (btn) {
        btn.addEventListener('click', () => {
          if (!consultModal.classList.contains('hidden')) return;
          resultModal.classList.add('hidden');
          consultModal.classList.remove('hidden');
          consultForm.classList.remove('hidden');
          successMessage.classList.add('hidden');
        });
      }
    });

    const hideConsultModal = () => consultModal.classList.add('hidden');
    if (closeConsultModalBtn) closeConsultModalBtn.addEventListener('click', hideConsultModal);
    if (btnCloseSuccess) btnCloseSuccess.addEventListener('click', hideConsultModal);
    consultModal.addEventListener('click', (e) => { if (e.target === consultModal) hideConsultModal(); });

    consultForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = {
        name: document.getElementById('cName').value,
        country: document.getElementById('cCountry').value,
        phone: document.getElementById('cPhone').value,
        email: document.getElementById('cEmail').value,
        goals: document.getElementById('cGoals').value,
      };
      console.log("Consultation Booking Submitted:", formData);

      consultForm.classList.add('hidden');
      successMessage.classList.remove('hidden');
      consultForm.reset();
    });

    // Initial render
    renderTest();
  </script>
</body>
</html>