---
// src/pages/conversation.astro - Dynamic Interactive Exercise Room
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Conversations | Havie</title>
  <meta name="description" content="Interactive visual roleplay exercise." />

  <!-- FAVICON -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #fffaf5;
      --navy: #0f172a;
      --brand-red: #dc2626;
    }
    html {
      scroll-padding-top: 85px;
    }
    body {
      font-family: 'DM Sans', sans-serif;
      background-color: var(--cream);
      color: var(--navy);
    }
    .font-brand {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .hero-glow {
      background: radial-gradient(circle, rgba(220, 38, 38, 0.12) 0%, rgba(245, 158, 11, 0.06) 50%, transparent 80%);
    }
    #chatBox::-webkit-scrollbar {
      width: 6px;
    }
    #chatBox::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 10px;
    }
    #chatBox::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }
    #chatBox::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="selection:bg-red-600 selection:text-white min-h-screen flex flex-col antialiased relative overflow-x-hidden">

  <!-- NAVBAR -->
  <header class="sticky top-0 z-40 bg-[#fffaf5]/90 backdrop-blur-md border-b border-stone-200/80 h-20">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16 h-full flex items-center justify-between">
      <a href="/" class="group flex flex-col select-none text-left shrink-0">
        <div class="h-6 sm:h-7 flex items-center">
          <svg class="h-6 sm:h-7 w-auto overflow-visible" viewBox="0 0 175 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 2H6V12H18V2H24V28H18V17H6V28H0V2Z" fill="#dc2626"/>
            <path d="M41 2L52 28H45.5L43.2 22H33.8L31.5 28H25L36 2H41ZM38.5 8.5L35.2 17.5H41.8L38.5 8.5Z" fill="#dc2626"/>
            <path d="M53 2H59.5L67 21L74.5 2H81L70.5 28H63.5L53 2Z" fill="#dc2626"/>
            <path d="M86 2H92V28H86V2Z" fill="#dc2626"/>
            <path d="M98 2H117V7.5H104V12H115V17H104V22.5H117V28H98V2Z" fill="#dc2626"/>
          </svg>
        </div>
        <span class="text-[9px] sm:text-[9.5px] font-bold tracking-[0.2em] text-stone-400 uppercase mt-1 leading-none font-brand">
          Learn Vietnamese Online
        </span>
      </a>

      <div class="hidden lg:flex items-center space-x-7 text-sm font-semibold text-slate-700 font-brand">
        <a href="/student" class="text-red-600 font-bold transition flex items-center gap-1">← Back to Portal</a>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="flex-grow flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 relative">
    <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[450px] h-[450px] hero-glow rounded-full blur-3xl"></div>
    </div>

    <!-- KHUNG BÀI TẬP max-w-3xl -->
    <div class="w-full max-w-3xl">
      <div id="lessonScreen" class="bg-white rounded-[32px] p-8 sm:p-12 shadow-2xl border border-stone-200/90 space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-stone-100 font-brand">
          <div>
            <span id="lessonCategory" class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-md bg-stone-100 text-stone-700"></span>
            <h2 id="lessonHeaderTitle" class="text-xl sm:text-2xl font-extrabold text-slate-900 font-brand mt-1"></h2>
          </div>
          <button id="resetTopBtn" type="button" class="text-xs font-bold text-stone-500 hover:text-red-600 transition bg-stone-50 px-4 py-2 rounded-xl border border-stone-200 cursor-pointer flex items-center gap-1.5">
            <span>Chơi lại</span> 🔄
          </button>
        </div>

        <!-- Khung chat co giãn linh hoạt -->
        <div id="chatBox" class="space-y-4 min-h-[120px] max-h-[380px] overflow-y-auto pr-2 flex flex-col"></div>

        <!-- Khung chọn câu trả lời -->
        <div id="choiceArea" class="pt-3 border-t border-stone-100"></div>
      </div>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="bg-[#fffaf5] text-stone-600 py-8 text-xs border-t border-stone-200/80 text-center font-brand">
    <p>© 2026 Learn Vietnamese with Hang</p>
  </footer>

  <!-- SCRIPT LOGIC TRỰC TIẾP -->
  <script>
    // Nhúng trực tiếp cơ sở dữ liệu bài tập tại đây để loại bỏ mọi lỗi import module SSR
    const exerciseDatabase = {
      "FCS01": {
        topic: "SOUTHERN FOOD & RESTAURANT CONVERSATION",
        title: "Bài tập: Gọi món tại quán ăn (Miền Nam)",
        getStep: function(state) {
          if (state.step === 0) {
            return {
              npc: "Quán em có phở với cơm, anh muốn ăn gì?",
              choices: [
                { text: "Cho anh phở bò", main: "phở bò", type: "pho" },
                { text: "Cho anh phở gà", main: "phở gà", type: "pho" },
                { text: "Cho anh cơm bò", main: "cơm bò", type: "com" },
                { text: "Cho anh cơm gà", main: "cơm gà", type: "com" }
              ]
            };
          } else if (state.step === 1) {
            if (state.dishType === "pho") {
              return {
                npc: "Anh có ăn hành lá không?",
                choices: [
                  { text: "Có", detail: "có hành" },
                  { text: "Không", detail: "không hành" }
                ]
              };
            } else {
              return {
                npc: "Anh có ăn ớt không?",
                choices: [
                  { text: "Có", detail: "có ớt" },
                  { text: "Không", detail: "không ớt" }
                ]
              };
            }
          } else if (state.step === 2) {
            return {
              npc: "Anh có muốn uống gì không?",
              choices: [
                { text: "Cho anh ly coca", drink: "coca" },
                { text: "Cho anh ly trà đá", drink: "trà đá" },
                { text: "Không, anh không uống gì thêm", drink: "không uống gì" }
              ]
            };
          } else if (state.step === 3) {
            let summary = `Dạ vậy mình gọi ${state.selectedMain}`;
            if (state.selectedDetail) summary += `, ${state.selectedDetail}`;
            if (state.selectedDrink) summary += ` và ${state.selectedDrink}`;
            summary += " nha.";

            return {
              npc: summary,
              isConfirm: true
            };
          } else if (state.step === 4) {
            return {
              npc: "Tổng cộng của mình là 60k.",
              isPayment: true,
              choices: [
                { text: "Đưa tờ 60k (Đúng tiền)", amount: 60 },
                { text: "Đưa tờ 100k", amount: 100 },
                { text: "Đưa tờ 200k", amount: 200 }
              ]
            };
          }
          return null;
        }
      }
    };

    const urlParams = new URLSearchParams(window.location.search);
    const lessonCode = urlParams.get('code') || 'FCS01';

    if (!lessonCode || !exerciseDatabase[lessonCode]) {
      window.location.href = '/student';
    }

    const lessonCategory = document.getElementById('lessonCategory');
    const lessonHeaderTitle = document.getElementById('lessonHeaderTitle');
    const chatBox = document.getElementById('chatBox');
    const choiceArea = document.getElementById('choiceArea');
    const resetTopBtn = document.getElementById('resetTopBtn');

    let currentState = {
      step: 0,
      dishType: "",
      selectedMain: "",
      selectedDetail: "",
      selectedDrink: ""
    };

    function startLesson() {
      currentState = { step: 0, dishType: "", selectedMain: "", selectedDetail: "", selectedDrink: "" };
      chatBox.innerHTML = "";

      const lesson = exerciseDatabase[lessonCode];
      lessonCategory.textContent = lesson.topic;
      lessonHeaderTitle.textContent = lesson.title;
      renderCurrentStep();
    }

    function scrollToBottom() {
      setTimeout(() => {
        chatBox.scrollTop = chatBox.scrollHeight;
      }, 50);
    }

    function renderCurrentStep() {
      const lesson = exerciseDatabase[lessonCode];
      const stepData = lesson.getStep(currentState);

      let npcBubble = document.createElement('div');
      npcBubble.className = "flex items-center gap-3 shrink-0";
      npcBubble.innerHTML = `
        <div class="w-9 h-9 rounded-full bg-red-100 text-red-600 flex items-center justify-center font-bold text-sm shrink-0">👩🏻‍🍳</div>
        <div class="p-4 rounded-2xl bg-stone-100 text-slate-800 text-sm sm:text-base max-w-[85%] leading-relaxed font-medium">
          ${stepData.npc}
        </div>
      `;
      chatBox.appendChild(npcBubble);
      scrollToBottom();

      if (stepData.isConfirm) {
        choiceArea.innerHTML = `
          <div class="space-y-3 font-brand">
            <div class="text-xs sm:text-sm font-bold text-slate-700">💡 How to say: <span class="text-red-600 font-extrabold">"I want to pay"</span>?</div>
            <div>
              <button type="button" id="hintBtn" class="w-full py-4 px-5 bg-red-50 hover:bg-red-100 text-red-600 font-bold rounded-2xl text-xs sm:text-sm transition border border-red-200 cursor-pointer flex items-center justify-center gap-2">
                <span>Cần gợi ý</span> 🔍
              </button>
            </div>
            <div id="hintOptions" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <button type="button" class="pay-option p-4 rounded-2xl bg-stone-50 hover:bg-red-50 border border-stone-200 text-xs sm:text-sm font-bold text-slate-700 text-center transition cursor-pointer" data-text="Em ơi, tính tiền cho anh!">
                <span>Em ơi, tính tiền cho anh!</span>
              </button>
              <button type="button" class="pay-option p-4 rounded-2xl bg-stone-50 hover:bg-red-50 border border-stone-200 text-xs sm:text-sm font-bold text-slate-700 text-center transition cursor-pointer" data-text="Cho anh xin cái hóa đơn!">
                <span>Cho anh xin cái hóa đơn!</span>
              </button>
            </div>
          </div>
        `;

        document.getElementById('hintBtn').addEventListener('click', () => {
          document.getElementById('hintOptions').classList.toggle('hidden');
          scrollToBottom();
        });

        document.querySelectorAll('.pay-option').forEach(btn => {
          btn.addEventListener('click', (e) => {
            selectChoice(e.currentTarget.getAttribute('data-text'));
          });
        });
        return;
      }

      choiceArea.innerHTML = `
        <div class="text-xs font-extrabold text-stone-400 uppercase tracking-wider mb-3 font-brand">Chọn câu trả lời của bạn:</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5" id="choiceBtnsContainer"></div>
      `;

      const container = document.getElementById('choiceBtnsContainer');
      stepData.choices.forEach((choice) => {
        let btn = document.createElement('button');
        btn.type = "button";
        btn.className = "p-4 rounded-2xl bg-stone-50 hover:bg-red-50 border border-stone-200 hover:border-red-300 text-center transition cursor-pointer shadow-2xs group font-bold text-xs sm:text-sm text-slate-700 hover:text-red-600 font-brand";
        btn.textContent = choice.text;

        btn.addEventListener('click', () => {
          if (lessonCode === "FCS01") {
            if (currentState.step === 0) {
              currentState.selectedMain = choice.main;
              currentState.dishType = choice.type;
            } else if (currentState.step === 1) {
              currentState.selectedDetail = choice.detail;
            } else if (currentState.step === 2) {
              currentState.selectedDrink = choice.drink;
            } else if (currentState.step === 4) {
              handlePayment(choice.amount);
              return;
            }
          }

          appendStudentBubble(choice.text);
          currentState.step++;
          renderCurrentStep();
        });

        container.appendChild(btn);
      });
    }

    function selectChoice(text) {
      appendStudentBubble(text);
      currentState.step++;
      renderCurrentStep();
    }

    function handlePayment(paidAmount) {
      appendStudentBubble(`Đưa tờ ${paidAmount}k`);

      let responseText = "";
      if (paidAmount === 60) {
        responseText = `Em nhận của anh ${paidAmount}k. Em cảm ơn anh!`;
      } else {
        let excess = paidAmount - 60;
        responseText = `Em nhận của anh ${paidAmount}k, em thối lại mình ${excess}k. Em cảm ơn anh!`;
      }

      setTimeout(() => {
        let npcBubble = document.createElement('div');
        npcBubble.className = "flex items-center gap-3 shrink-0";
        npcBubble.innerHTML = `
          <div class="w-9 h-9 rounded-full bg-red-100 text-red-600 flex items-center justify-center font-bold text-sm shrink-0">👩🏻‍🍳</div>
          <div class="p-4 rounded-2xl bg-stone-100 text-slate-800 text-sm sm:text-base max-w-[85%] leading-relaxed font-medium">
            ${responseText}
          </div>
        `;
        chatBox.appendChild(npcBubble);
        scrollToBottom();

        choiceArea.innerHTML = `
          <div class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-center space-y-3 mt-2 font-brand">
            <div class="text-sm sm:text-base font-bold text-emerald-800">🎉 Xuất sắc! Bạn đã hoàn thành toàn bộ cuộc hội thoại.</div>
            <button type="button" id="resetBtn" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs sm:text-sm transition cursor-pointer inline-flex items-center gap-2">
              <span>Chơi lại</span> 🔄
            </button>
          </div>
        `;
        document.getElementById('resetBtn').addEventListener('click', startLesson);
      }, 500);
    }

    function appendStudentBubble(text) {
      let studentBubble = document.createElement('div');
      studentBubble.className = "flex items-center justify-end gap-3 shrink-0";
      studentBubble.innerHTML = `
        <div class="p-4 rounded-2xl bg-red-600 text-white text-sm sm:text-base max-w-[85%] leading-relaxed font-medium shadow-sm">
          ${text}
        </div>
        <div class="w-9 h-9 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-sm">🎓</div>
      `;
      chatBox.appendChild(studentBubble);
      scrollToBottom();
    }

    resetTopBtn.addEventListener('click', () => {
      startLesson();
    });

    startLesson();
  </script>
</body>
</html>