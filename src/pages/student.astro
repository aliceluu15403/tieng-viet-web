---
// src/pages/student.astro - Secure Access Portal (Fully Synced & Refined)
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Portal | Havie Learn Vietnamese</title>
  <meta name="description" content="Secure student portal for Hang's Vietnamese learners." />

  <!-- CANONICAL URL -->
  <link rel="canonical" href="https://havielearn.com/student" />

  <!-- FAVICON NHÚNG TRỰC TIẾP -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 512 512%22><rect width=%22512%22 height=%22512%22 rx=%22110%22 fill=%22%23dc2626%22/><path d=%22M136 116h68v110h104V116h68v280h-68V290H204v106h-68V116z%22 fill=%22%23ffffff%22/></svg>" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: DM Sans & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #fffaf5;
      --navy: #0f172a;
      --brand-red: #dc2626;
    }

    html {
      scroll-padding-top: 100px;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background-color: var(--cream);
      color: var(--navy);
    }

    .font-brand {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .hero-glow {
      background: radial-gradient(circle, rgba(220, 38, 38, 0.12) 0%, rgba(245, 158, 11, 0.06) 50%, transparent 80%);
    }
  </style>
</head>
<body class="selection:bg-red-600 selection:text-white min-h-screen flex flex-col antialiased relative overflow-x-hidden">

  <!-- NAVBAR -->
  <header class="sticky top-0 z-40 bg-[#fffaf5]/90 backdrop-blur-md border-b border-stone-200/80 h-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 h-full flex items-center justify-between">
      
      <!-- LOGO BÊN TRÁI -->
      <a href="/" class="group flex flex-col select-none text-left shrink-0">
        <div class="h-7 sm:h-8 flex items-center">
          <svg class="h-7 sm:h-8 w-auto overflow-visible" viewBox="0 0 175 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 2H6V12H18V2H24V28H18V17H6V28H0V2Z" fill="#dc2626"/>
            <path d="M41 2L52 28H45.5L43.2 22H33.8L31.5 28H25L36 2H41ZM38.5 8.5L35.2 17.5H41.8L38.5 8.5Z" fill="#dc2626"/>
            <path d="M53 2H59.5L67 21L74.5 2H81L70.5 28H63.5L53 2Z" fill="#dc2626"/>
            <path d="M86 2H92V28H86V2Z" fill="#dc2626"/>
            <path d="M98 2H117V7.5H104V12H115V17H104V22.5H117V28H98V2Z" fill="#dc2626"/>
          </svg>
        </div>
        <span class="text-[9.5px] sm:text-[10px] font-bold tracking-[0.22em] sm:tracking-[0.26em] text-stone-400 uppercase mt-1 pl-0.5 leading-none">
          Learn Vietnamese Online
        </span>
      </a>

      <!-- CỤM PHẢI: MENU -->
      <div class="hidden md:flex items-center gap-7 lg:gap-8 ml-auto mr-4">
        <nav class="flex items-center space-x-7 lg:space-x-8 text-base font-bold text-slate-800 tracking-normal font-[inherit]">
          <a href="/#about" class="hover:text-red-600 transition text-base font-bold text-slate-800">About Me</a>
          <a href="/#curriculum" class="hover:text-red-600 transition text-base font-bold text-slate-800">Learning Tracks</a>
          <a href="/resources" class="hover:text-red-600 transition text-base font-bold text-slate-800">Resources</a>
          <a href="/student" class="text-red-600 font-bold transition">Student Portal</a>
          <a href="/test" class="hover:text-red-600 transition text-base font-bold text-slate-800">Level Test</a>
        </nav>
      </div>

      <!-- DESKTOP CTA & MOBILE TOGGLE -->
      <div class="flex items-center gap-3 shrink-0">
        <button
          type="button"
          class="open-modal-trigger hidden sm:inline-flex items-center justify-center px-5 py-3 text-sm font-extrabold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-lg shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>

        <!-- Mobile Menu Hamburger Button -->
        <button 
          id="mobileMenuBtn" 
          type="button" 
          aria-label="Toggle Menu"
          class="md:hidden w-10 h-10 rounded-xl bg-stone-100 hover:bg-stone-200 text-slate-800 flex items-center justify-center font-bold transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobileMenu" class="hidden md:hidden absolute top-20 left-0 w-full bg-[#fffaf5] border-b border-stone-200 shadow-xl px-6 py-5 space-y-4 font-semibold text-slate-800 text-base">
      <a href="/#about" class="mobile-link block hover:text-red-600 transition">About Me</a>
      <a href="/#curriculum" class="mobile-link block hover:text-red-600 transition">Learning Tracks</a>
      <a href="/resources" class="mobile-link block hover:text-red-600 transition">Resources</a>
      <a href="/student" class="mobile-link block text-red-600 font-bold">Student Portal</a>
      <a href="/test" class="mobile-link block hover:text-red-600 transition">Level Test</a>
      <div class="pt-3 border-t border-stone-200">
        <button
          type="button"
          class="open-modal-trigger w-full py-3.5 text-sm font-bold text-white bg-red-600 rounded-xl text-center shadow-md cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="flex-grow flex items-center justify-center py-12 sm:py-16 px-4 sm:px-6 lg:px-8 relative">
    <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] hero-glow rounded-full blur-3xl"></div>
    </div>

    <div class="w-full max-w-lg">
      <div class="bg-white rounded-[32px] p-8 sm:p-10 shadow-2xl shadow-stone-300/50 border border-stone-200/90 text-center space-y-6">
        <div class="w-16 h-16 bg-red-50 text-red-600 rounded-2xl mx-auto flex items-center justify-center text-2xl shadow-inner border border-red-100">
          🔐
        </div>
        
        <div class="space-y-2">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-brand">Enter Lesson Access Code</h1>
          <p class="text-stone-500 text-xs sm:text-sm">
            Please enter your 5-character access code provided by Hang.
          </p>
        </div>

        <!-- FORM 5 Ô OTP BẢO MẬT -->
        <form id="codeForm" class="space-y-6 max-w-sm mx-auto">
          <div class="flex justify-center gap-2.5 sm:gap-3" id="otpContainer">
            <input type="text" maxlength="1" autocomplete="off" class="otp-input w-12 h-14 sm:w-13 sm:h-15 text-center text-xl font-extrabold font-mono uppercase bg-stone-50 border-2 border-stone-200 rounded-2xl focus:border-red-600 focus:bg-white focus:outline-none transition-all shadow-2xs" />
            <input type="text" maxlength="1" autocomplete="off" class="otp-input w-12 h-14 sm:w-13 sm:h-15 text-center text-xl font-extrabold font-mono uppercase bg-stone-50 border-2 border-stone-200 rounded-2xl focus:border-red-600 focus:bg-white focus:outline-none transition-all shadow-2xs" />
            <input type="text" maxlength="1" autocomplete="off" class="otp-input w-12 h-14 sm:w-13 sm:h-15 text-center text-xl font-extrabold font-mono uppercase bg-stone-50 border-2 border-stone-200 rounded-2xl focus:border-red-600 focus:bg-white focus:outline-none transition-all shadow-2xs" />
            <input type="text" maxlength="1" autocomplete="off" class="otp-input w-12 h-14 sm:w-13 sm:h-15 text-center text-xl font-extrabold font-mono uppercase bg-stone-50 border-2 border-stone-200 rounded-2xl focus:border-red-600 focus:bg-white focus:outline-none transition-all shadow-2xs" />
            <input type="text" maxlength="1" autocomplete="off" class="otp-input w-12 h-14 sm:w-13 sm:h-15 text-center text-xl font-extrabold font-mono uppercase bg-stone-50 border-2 border-stone-200 rounded-2xl focus:border-red-600 focus:bg-white focus:outline-none transition-all shadow-2xs" />
          </div>

          <input type="hidden" id="accessCodeInput" required />

          <div id="errorMessage" class="hidden text-xs font-bold text-red-600 bg-red-50 py-3 rounded-xl border border-red-100 text-center">
            ❌ Invalid access code. Please try again!
          </div>

          <button type="submit" class="w-full py-4 bg-red-600 hover:bg-red-700 text-white font-extrabold font-brand rounded-2xl text-base shadow-xl shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer">
            Open exercise →
          </button>
        </form>
      </div>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="bg-[#fffaf5] text-stone-600 py-10 border-t border-stone-200/80">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div class="flex items-center justify-center gap-2.5">
        <span class="font-brand font-black text-slate-900 tracking-wider text-base sm:text-lg">HAVIE</span>
        <span class="text-stone-300">•</span>
        <span class="text-xs sm:text-sm font-medium text-stone-500">Learn Vietnamese with Hang</span>
      </div>
      <div class="flex items-center gap-5 sm:gap-7 font-semibold text-xs sm:text-sm text-stone-700 flex-wrap justify-center">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/resources" class="hover:text-red-600 transition">Resources</a>
        <a href="/student" class="text-red-600 font-bold transition">Student Portal</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        <button type="button" class="open-modal-trigger text-red-600 font-bold hover:underline cursor-pointer">Book Trial</button>
      </div>
    </div>
  </footer>

  <!-- CONSULTATION / BOOKING MODAL -->
  <div id="consultModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-stone-200 space-y-6 text-left">
      
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="text-xs sm:text-sm font-black text-red-600 uppercase tracking-widest bg-red-50 px-3.5 py-1.5 rounded-lg border border-red-200 inline-block font-brand">1-ON-1 LESSONS</span>
          <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-brand mt-1.5">Book 25-Min Trial Lesson</h3>
        </div>
        <button id="closeModalBtn" type="button" class="w-10 h-10 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold flex items-center justify-center text-lg cursor-pointer">
          ✕
        </button>
      </div>

      <form id="consultForm" class="space-y-4 text-sm">
        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Full Name / Tên của bạn *</label>
          <input type="text" id="cName" required placeholder="e.g. Alex Smith" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-800 mb-1.5 text-base">Country / Quốc gia *</label>
            <input type="text" id="cCountry" required placeholder="e.g. Germany, USA" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
          </div>
          <div>
            <label class="block font-bold text-slate-800 mb-1.5 text-base">Phone / SĐT</label>
            <input type="tel" id="cPhone" placeholder="e.g. +49..." class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Email Address *</label>
          <input type="email" id="cEmail" required placeholder="name@example.com" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Learning Goals / Mục tiêu học tập *</label>
          <textarea id="cGoals" rows="3" required placeholder="Current level, target dialect (Hanoi/Saigon), goals..." class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 resize-none text-base"></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-base shadow-md transition cursor-pointer mt-3"
        >
          Submit Request to Hang →
        </button>
      </form>

      <div id="successMessage" class="hidden text-center py-6 space-y-3">
        <div class="text-4xl">🎉</div>
        <h4 class="font-black text-slate-900 text-lg font-brand">Request Sent Successfully!</h4>
        <p class="text-stone-600 text-sm leading-relaxed">Thank you! Hang has received your details and goals. She will reach out via email within 24 hours.</p>
        <button id="btnCloseSuccess" type="button" class="px-6 py-3 bg-slate-900 text-white font-bold rounded-xl text-sm cursor-pointer">
          Close Window
        </button>
      </div>

    </div>
  </div>

  <!-- SCRIPTS -->
  <script is:inline>
    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });
    }

    // Modal Control Script
    const modal = document.getElementById('consultModal');
    const openTriggers = document.querySelectorAll('.open-modal-trigger');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const consultForm = document.getElementById('consultForm');
    const successMessage = document.getElementById('successMessage');
    const btnCloseSuccess = document.getElementById('btnCloseSuccess');

    openTriggers.forEach(btn => {
      if (btn) {
        btn.addEventListener('click', () => {
          modal.classList.remove('hidden');
          consultForm.classList.remove('hidden');
          successMessage.classList.add('hidden');
          if (mobileMenu) mobileMenu.classList.add('hidden');
        });
      }
    });

    const hideModal = () => modal.classList.add('hidden');
    if (closeModalBtn) closeModalBtn.addEventListener('click', hideModal);
    if (btnCloseSuccess) closeModalBtn.addEventListener('click', hideModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) hideModal(); });

    consultForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = {
        name: document.getElementById('cName').value,
        country: document.getElementById('cCountry').value,
        phone: document.getElementById('cPhone').value,
        email: document.getElementById('cEmail').value,
        goals: document.getElementById('cGoals').value,
      };
      console.log("Consultation Booking Submitted:", formData);

      consultForm.classList.add('hidden');
      successMessage.classList.remove('hidden');
      consultForm.reset();
    });

    // Danh sách các mã hợp lệ (đã thêm SLN01)
    const validCodes = ["FCS01", "SLS01", "SLN01"];

    const inputs = document.querySelectorAll('.otp-input');
    const hiddenInput = document.getElementById('accessCodeInput');
    const codeForm = document.getElementById('codeForm');
    const errorMessage = document.getElementById('errorMessage');

    inputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        const val = e.target.value.toUpperCase();
        e.target.value = val;
        if (val && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }
        updateHiddenCode();
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !input.value && index > 0) {
          inputs[index - 1].focus();
        }
      });
    });

    function updateHiddenCode() {
      let code = "";
      inputs.forEach(input => code += input.value);
      hiddenInput.value = code;
    }

    codeForm.addEventListener('submit', (e) => {
      e.preventDefault();
      updateHiddenCode();
      const code = hiddenInput.value.trim().toUpperCase();

      if (validCodes.includes(code)) {
        errorMessage.classList.add('hidden');
        
        if (code.startsWith('SLS') || code.startsWith('SLN')) {
          window.location.href = `/listening?code=${code}`;
        } else {
          window.location.href = `/exercise?code=${code}`;
        }
      } else {
        errorMessage.classList.remove('hidden');
        inputs.forEach(input => input.value = '');
        hiddenInput.value = '';
        inputs[0].focus();
      }
    });
  </script>
</body>
</html>