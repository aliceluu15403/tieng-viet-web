---
// src/pages/student.astro - Secure Access Portal (Clean & Private)
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Portal | Havie Learn Vietnamese</title>
  <meta name="description" content="Secure student portal for Hang's Vietnamese learners." />

  <!-- FAVICON & MOBILE TOUCH ICONS -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: DM Sans & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #fffaf5;
      --navy: #0f172a;
      --brand-red: #dc2626;
    }

    html {
      scroll-padding-top: 85px;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background-color: var(--cream);
      color: var(--navy);
    }

    .font-brand {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .hero-glow {
      background: radial-gradient(circle, rgba(220, 38, 38, 0.12) 0%, rgba(245, 158, 11, 0.06) 50%, transparent 80%);
    }
  </style>
</head>
<body class="selection:bg-red-600 selection:text-white min-h-screen flex flex-col antialiased relative overflow-x-hidden">

  <!-- NAVBAR -->
  <header class="sticky top-0 z-40 bg-[#fffaf5]/90 backdrop-blur-md border-b border-stone-200/80 h-20">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16 h-full flex items-center justify-between">
      
      <!-- LOGO -->
      <a href="/" class="group flex flex-col select-none text-left shrink-0">
        <div class="h-6 sm:h-7 flex items-center">
          <svg class="h-6 sm:h-7 w-auto overflow-visible" viewBox="0 0 175 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 2H6V12H18V2H24V28H18V17H6V28H0V2Z" fill="#dc2626"/>
            <path d="M41 2L52 28H45.5L43.2 22H33.8L31.5 28H25L36 2H41ZM38.5 8.5L35.2 17.5H41.8L38.5 8.5Z" fill="#dc2626"/>
            <path d="M53 2H59.5L67 21L74.5 2H81L70.5 28H63.5L53 2Z" fill="#dc2626"/>
            <path d="M86 2H92V28H86V2Z" fill="#dc2626"/>
            <path d="M98 2H117V7.5H104V12H115V17H104V22.5H117V28H98V2Z" fill="#dc2626"/>
          </svg>
        </div>
        <span class="text-[9px] sm:text-[9.5px] font-bold tracking-[0.2em] sm:tracking-[0.24em] text-stone-400 uppercase mt-1 pl-0.5 leading-none">
          Learn Vietnamese Online
        </span>
      </a>

      <!-- CỤM ĐIỀU HƯỚNG & NÚT BẤM -->
      <div class="hidden lg:flex items-center space-x-7 text-sm font-semibold text-slate-700">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/resources" class="hover:text-red-600 transition">Resources</a>
        <a href="/student" class="text-red-600 font-bold transition">Student Portal</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        
        <div class="flex items-center pl-2">
          <button
            type="button"
            class="open-modal-trigger inline-flex items-center justify-center px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-lg shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer"
          >
            Book 25-Min Trial Lesson →
          </button>
        </div>
      </div>

      <!-- Mobile Menu Hamburger Button -->
      <button 
        id="mobileMenuBtn" 
        type="button" 
        aria-label="Toggle Menu"
        class="lg:hidden w-10 h-10 rounded-xl bg-stone-100 hover:bg-stone-200 text-slate-800 flex items-center justify-center font-bold transition cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobileMenu" class="hidden lg:hidden absolute top-20 left-0 w-full bg-[#fffaf5] border-b border-stone-200 shadow-xl px-6 py-5 space-y-3 font-semibold text-slate-700 text-sm">
      <a href="/#about" class="mobile-link block hover:text-red-600 transition py-1">About Me</a>
      <a href="/#curriculum" class="mobile-link block hover:text-red-600 transition py-1">Learning Tracks</a>
      <a href="/resources" class="mobile-link block hover:text-red-600 transition py-1">Resources</a>
      <a href="/student" class="mobile-link block hover:text-red-600 transition py-1">Student Portal</a>
      <a href="/test" class="mobile-link block hover:text-red-600 transition py-1">Level Test</a>
      <div class="pt-3 border-t border-stone-200">
        <button
          type="button"
          class="open-modal-trigger w-full py-3 text-xs font-bold text-white bg-red-600 rounded-xl text-center shadow-md cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="flex-grow flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 relative">
    <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[450px] h-[450px] hero-glow rounded-full blur-3xl"></div>
    </div>

    <div class="w-full max-w-xl">
      <div class="bg-white rounded-[32px] p-8 sm:p-12 shadow-2xl border border-stone-200/90 text-center space-y-6">
        <div class="w-16 h-16 bg-red-50 text-red-600 rounded-2xl mx-auto flex items-center justify-center text-2xl shadow-inner border border-red-100">
          🔐
        </div>
        
        <div class="space-y-2">
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 font-brand">Enter Lesson Access Code</h1>
          <p class="text-stone-500 text-xs sm:text-sm">
            Please enter your 5-character access code provided by Hang.
          </p>
        </div>

        <!-- FORM 5 Ô OTP BẢO MẬT -->
        <form id="codeForm" class="space-y-6 max-w-sm mx-auto">
          <div class="flex justify-center gap-2.5 sm:gap-3" id="otpContainer">
            <input type="text" maxlength="1" autocomplete="off" class="otp-input w-12 h-14 sm:w-13 sm:h-15 text-center text-xl font-extrabold font-mono uppercase bg-stone-50 border-2 border-stone-200 rounded-2xl focus:border-red-600 focus:bg-white focus:outline-none transition-all shadow-2xs" />
            <input type="text" maxlength="1" autocomplete="off" class="otp-input w-12 h-14 sm:w-13 sm:h-15 text-center text-xl font-extrabold font-mono uppercase bg-stone-50 border-2 border-stone-200 rounded-2xl focus:border-red-600 focus:bg-white focus:outline-none transition-all shadow-2xs" />
            <input type="text" maxlength="1" autocomplete="off" class="otp-input w-12 h-14 sm:w-13 sm:h-15 text-center text-xl font-extrabold font-mono uppercase bg-stone-50 border-2 border-stone-200 rounded-2xl focus:border-red-600 focus:bg-white focus:outline-none transition-all shadow-2xs" />
            <input type="text" maxlength="1" autocomplete="off" class="otp-input w-12 h-14 sm:w-13 sm:h-15 text-center text-xl font-extrabold font-mono uppercase bg-stone-50 border-2 border-stone-200 rounded-2xl focus:border-red-600 focus:bg-white focus:outline-none transition-all shadow-2xs" />
            <input type="text" maxlength="1" autocomplete="off" class="otp-input w-12 h-14 sm:w-13 sm:h-15 text-center text-xl font-extrabold font-mono uppercase bg-stone-50 border-2 border-stone-200 rounded-2xl focus:border-red-600 focus:bg-white focus:outline-none transition-all shadow-2xs" />
          </div>

          <input type="hidden" id="accessCodeInput" required />

          <div id="errorMessage" class="hidden text-xs font-bold text-red-600 bg-red-50 py-2.5 rounded-xl border border-red-100 text-center">
            ❌ Invalid access code. Please try again!
          </div>

          <!-- Đã tăng font chữ thành text-base và thêm font-brand -->
          <button type="submit" class="w-full py-4 bg-red-600 hover:bg-red-700 text-white font-black font-brand rounded-2xl text-base shadow-lg shadow-red-600/25 transition cursor-pointer">
            Open exercise →
          </button>
        </form>
      </div>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="bg-[#fffaf5] text-stone-600 py-8 text-xs border-t border-stone-200/80">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <span class="font-brand font-black text-slate-900 tracking-widest text-sm">HAVIE.</span>
        <span class="text-stone-400">•</span>
        <span class="font-medium">Learn Vietnamese with Hang</span>
      </div>
      <div class="flex items-center gap-5 sm:gap-6 font-semibold text-stone-700 flex-wrap justify-center">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/resources" class="hover:text-red-600 transition">Resources</a>
        <a href="/student" class="text-red-600 font-bold hover:underline transition">Student Portal</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        <button type="button" class="open-modal-trigger text-red-600 font-bold hover:underline cursor-pointer">Book Trial</button>
      </div>
    </div>
  </footer>

  <!-- CONSULTATION / BOOKING MODAL -->
  <div id="consultModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-stone-200 space-y-5 text-left">
      
      <div class="flex items-center justify-between border-b border-stone-100 pb-3">
        <div>
          <span class="text-[10px] font-black text-red-600 uppercase tracking-widest bg-red-50 px-2.5 py-0.5 rounded border border-red-200">1-on-1 Coaching</span>
          <h3 class="text-xl font-black text-slate-900 font-brand mt-1">Book 25-Min Trial Lesson</h3>
        </div>
        <button id="closeModalBtn" type="button" class="w-8 h-8 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-600 font-bold flex items-center justify-center cursor-pointer">
          ✕
        </button>
      </div>

      <form id="consultForm" class="space-y-3.5 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Full Name / Tên của bạn *</label>
          <input type="text" id="cName" required placeholder="e.g. Alex Smith" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Country / Quốc gia *</label>
            <input type="text" id="cCountry" required placeholder="e.g. Germany, USA" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Phone / SĐT</label>
            <input type="tel" id="cPhone" placeholder="e.g. +49..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Email Address *</label>
          <input type="email" id="cEmail" required placeholder="name@example.com" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Learning Goals / Mục tiêu học tập *</label>
          <textarea id="cGoals" rows="3" required placeholder="Current level, target dialect (Hanoi/Saigon), goals..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50 resize-none"></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3.5 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-xs sm:text-sm shadow-md transition cursor-pointer mt-2"
        >
          Submit Request to Hang →
        </button>
      </form>

      <div id="successMessage" class="hidden text-center py-6 space-y-3">
        <div class="text-3xl">🎉</div>
        <h4 class="font-black text-slate-900 text-base font-brand">Request Sent Successfully!</h4>
        <p class="text-stone-600 text-xs leading-relaxed">Thank you! Hang has received your details and goals. She will reach out via email within 24 hours.</p>
        <button id="btnCloseSuccess" type="button" class="px-6 py-2.5 bg-slate-900 text-white font-bold rounded-xl text-xs cursor-pointer">
          Close Window
        </button>
      </div>

    </div>
  </div>

  <!-- SCRIPTS -->
  <script is:inline>
    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });
    }

    // Modal Control Script
    const modal = document.getElementById('consultModal');
    const openTriggers = document.querySelectorAll('.open-modal-trigger');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const consultForm = document.getElementById('consultForm');
    const successMessage = document.getElementById('successMessage');
    const btnCloseSuccess = document.getElementById('btnCloseSuccess');

    openTriggers.forEach(btn => {
      if (btn) {
        btn.addEventListener('click', () => {
          modal.classList.remove('hidden');
          consultForm.classList.remove('hidden');
          successMessage.classList.add('hidden');
          if (mobileMenu) mobileMenu.classList.add('hidden');
        });
      }
    });

    const hideModal = () => modal.classList.add('hidden');
    if (closeModalBtn) closeModalBtn.addEventListener('click', hideModal);
    if (btnCloseSuccess) closeModalBtn.addEventListener('click', hideModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) hideModal(); });

    consultForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = {
        name: document.getElementById('cName').value,
        country: document.getElementById('cCountry').value,
        phone: document.getElementById('cPhone').value,
        email: document.getElementById('cEmail').value,
        goals: document.getElementById('cGoals').value,
      };
      console.log("Consultation Booking Submitted:", formData);

      consultForm.classList.add('hidden');
      successMessage.classList.remove('hidden');
      consultForm.reset();
    });

    // Danh sách các mã hợp lệ được phép truy cập
    const validCodes = ["FCS01"];

    const inputs = document.querySelectorAll('.otp-input');
    const hiddenInput = document.getElementById('accessCodeInput');
    const codeForm = document.getElementById('codeForm');
    const errorMessage = document.getElementById('errorMessage');

    inputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        const val = e.target.value.toUpperCase();
        e.target.value = val;
        if (val && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }
        updateHiddenCode();
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !input.value && index > 0) {
          inputs[index - 1].focus();
        }
      });
    });

    function updateHiddenCode() {
      let code = "";
      inputs.forEach(input => code += input.value);
      hiddenInput.value = code;
    }

    codeForm.addEventListener('submit', (e) => {
      e.preventDefault();
      updateHiddenCode();
      const code = hiddenInput.value.trim().toUpperCase();

      if (validCodes.includes(code)) {
        errorMessage.classList.add('hidden');
        window.location.href = `/exercise?code=${code}`;
      } else {
        errorMessage.classList.remove('hidden');
        inputs.forEach(input => input.value = '');
        hiddenInput.value = '';
        inputs[0].focus();
      }
    });
  </script>
</body>
</html>