      const cIdx = randomPreset.companion ? sandboxVocab.companion.findIndex(item => item.vi === randomPreset.companion) : 0;

      currentSandbox = {
        time: tIdx !== -1 ? tIdx : 0,
        subject: sIdx !== -1 ? sIdx : 1,
        action: aIdx !== -1 ? aIdx : 0,
        location: lIdx !== -1 ? lIdx : 0,
        companion: cIdx !== -1 ? cIdx : 0
