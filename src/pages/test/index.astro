---
// src/pages/test/index.astro - Official Vietnamese Proficiency Placement Test (A1 - C2)
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vietnamese Proficiency Placement Test — HAVIE</title>
  <meta name="description" content="Take our comprehensive Vietnamese level test with Northern and Southern dialect tracks, audio tone discrimination, and real-time feedback." />

  <!-- CANONICAL URL -->
  <link rel="canonical" href="https://havielearn.com/test" />

  <!-- FAVICON -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #fffaf5;
      --navy: #0f172a;
      --brand-red: #dc2626;
      --orange: #ef7218;
    }
    html { scroll-padding-top: 100px; }
    body { font-family: 'DM Sans', sans-serif; background-color: var(--cream); color: var(--navy); }
    .font-brand { font-family: 'Plus Jakarta Sans', sans-serif; }
    .curved-underline { position: relative; }
    .curved-underline::after {
      content: ""; position: absolute; left: 0; bottom: -4px; width: 100%; height: 6px;
      border-bottom: 3px solid var(--orange); border-radius: 50%; transform: rotate(-1.5deg);
    }
  </style>
</head>
<body class="selection:bg-red-600 selection:text-white min-h-screen flex flex-col antialiased relative overflow-x-hidden">

  <!-- BACKGROUND GLOW -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute top-0 right-[15%] w-[450px] h-[450px] bg-gradient-to-br from-amber-400/20 via-red-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute top-40 left-[10%] w-[380px] h-[380px] bg-gradient-to-tr from-amber-200/30 to-transparent rounded-full blur-3xl"></div>
  </div>

  <!-- NAVBAR -->
  <header class="sticky top-0 z-40 bg-[#fffaf5]/90 backdrop-blur-md border-b border-stone-200/80 h-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 h-full flex items-center justify-between">
      <a href="/" class="group flex flex-col select-none text-left shrink-0">
        <div class="h-7 sm:h-8 flex items-center">
          <svg class="h-7 sm:h-8 w-auto overflow-visible" viewBox="0 0 175 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 2H6V12H18V2H24V28H18V17H6V28H0V2Z" fill="#dc2626"/>
            <path d="M41 2L52 28H45.5L43.2 22H33.8L31.5 28H25L36 2H41ZM38.5 8.5L35.2 17.5H41.8L38.5 8.5Z" fill="#dc2626"/>
            <path d="M53 2H59.5L67 21L74.5 2H81L70.5 28H63.5L53 2Z" fill="#dc2626"/>
            <path d="M86 2H92V28H86V2Z" fill="#dc2626"/>
            <path d="M98 2H117V7.5H104V12H115V17H104V22.5H117V28H98V2Z" fill="#dc2626"/>
          </svg>
        </div>
        <span class="text-[9.5px] sm:text-[10px] font-bold tracking-[0.22em] text-stone-400 uppercase mt-1 pl-0.5 leading-none">Learn Vietnamese Online</span>
      </a>

      <nav class="hidden md:flex items-center space-x-7 lg:space-x-8 text-base font-bold text-slate-800">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/resources" class="hover:text-red-600 transition">Resources</a>
        <a href="/student" class="hover:text-red-600 transition">Student Portal</a>
        <a href="/test" class="text-red-600 font-brand font-extrabold transition">Level Test</a>
      </nav>

      <div class="hidden md:flex items-center pl-6 shrink-0">
        <button type="button" class="open-modal-trigger inline-flex items-center justify-center px-5 py-3 text-sm font-extrabold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-lg shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer">
          Book 25-Min Trial Lesson →
        </button>
      </div>

      <div class="flex items-center md:hidden">
        <button id="mobileMenuBtn" type="button" aria-label="Toggle Menu" class="w-10 h-10 rounded-xl bg-stone-100 hover:bg-stone-200 text-slate-800 flex items-center justify-center font-bold transition cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- STICKY SCORE TRACKER -->
  <div class="sticky top-20 z-30 bg-white/90 backdrop-blur-md border-b border-stone-200/80 py-3.5 shadow-xs">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm font-bold text-center sm:text-left font-brand">
      <div class="flex flex-wrap items-center justify-center gap-3">
        <span class="text-stone-400 uppercase text-xs tracking-wider font-extrabold">Dialect Track:</span>
        <div class="inline-flex p-1 rounded-xl bg-stone-100 border border-stone-200">
          <button id="btnSelectNorth" type="button" class="px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold bg-slate-900 text-white shadow-xs transition cursor-pointer">🇻🇳 Northern (Hanoi)</button>
          <button id="btnSelectSouth" type="button" class="px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold text-stone-600 hover:text-slate-900 transition cursor-pointer">🇻🇳 Southern (Saigon)</button>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 text-stone-700 text-sm">
        <span class="px-3 py-1 rounded-lg bg-stone-100">P1: <strong id="scoreP1" class="text-red-600 font-mono">0</strong>/20</span>
        <span class="px-3 py-1 rounded-lg bg-stone-100">P2: <strong id="scoreP2" class="text-red-600 font-mono">0</strong>/20</span>
        <span class="px-3 py-1 rounded-lg bg-stone-100">P3: <strong id="scoreP3" class="text-red-600 font-mono font-bold">0</strong>/20</span>
        <span class="px-3 py-1 rounded-lg bg-stone-100">P4: <strong id="scoreP4" class="text-red-600 font-mono font-bold">0</strong>/20</span>
        <div class="pl-3 border-l border-stone-200 font-black text-slate-900">
          Total: <span id="scoreTotal" class="text-red-600 font-mono text-base font-black">0</span>/80
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN CONTAINER (TĂNG WIDTH LÊN MAX-W-4XL CHO THOÁNG) -->
  <main class="flex-grow py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-5 sm:px-8 space-y-12">
      
      <!-- HERO INTRO -->
      <div class="text-center max-w-2xl mx-auto space-y-3.5">
        <span class="text-xs font-extrabold text-red-600 uppercase tracking-widest bg-red-50 px-4 py-1.5 rounded-full border border-red-200 inline-block shadow-2xs font-brand">Placement Assessment</span>
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight font-brand">
          Vietnamese <span class="curved-underline text-red-600">Proficiency Test.</span>
        </h1>
        <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
          Choose your target dialect track, complete all sections below, and submit your test to get an instant evaluation summary and detailed answer review.
        </p>
      </div>

      <!-- TEST SECTIONS CONTAINER -->
      <div id="testSectionsContainer" class="space-y-10"></div>

      <!-- PART 5: SPEAKING -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-stone-200/90 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-stone-100 pb-4">
          <div>
            <span class="text-xs font-black uppercase tracking-wider text-stone-700 bg-stone-100 px-3 py-1 rounded-md font-brand">Section 5</span>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 font-brand mt-2">Part 5: Speaking Evaluation</h2>
          </div>
          <span class="text-xs font-bold text-stone-500 bg-stone-50 px-3.5 py-1.5 rounded-xl border border-stone-200 font-brand">Teacher Evaluated</span>
        </div>
        <div class="space-y-5" id="containerP5"></div>
        <div class="pt-2 text-center font-brand">
          <button type="button" class="open-modal-trigger inline-flex items-center justify-center px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-2xl text-sm sm:text-base transition shadow-md shadow-red-600/20 cursor-pointer w-full sm:w-auto">
            🎙️ Book Speaking Evaluation with Hang (Free 25-Min Trial) →
          </button>
        </div>
      </section>

      <!-- SUBMIT TEST BUTTON -->
      <div class="text-center pt-4 font-brand">
        <button id="btnFinalSubmit" type="button" class="w-full sm:w-auto px-12 py-5 bg-slate-900 hover:bg-slate-800 text-white font-black text-base sm:text-lg rounded-2xl shadow-xl transition-all hover:-translate-y-0.5 cursor-pointer">
          🏁 Submit Test & View Placement Summary →
        </button>
      </div>

    </div>
  </main>

  <!-- RESULT POPUP MODAL -->
  <div id="resultModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-10 max-w-lg w-full shadow-2xl border border-stone-200 text-center space-y-6">
      <div id="modalBadge" class="w-16 h-16 mx-auto rounded-2xl flex items-center justify-center text-3xl shadow-inner bg-red-50 text-red-600">🎯</div>
      <div>
        <span class="text-xs font-extrabold uppercase tracking-widest text-stone-400 font-brand">Diagnostic Placement Result</span>
        <h3 id="modalLevelTitle" class="text-2xl sm:text-3xl font-black text-slate-900 font-brand mt-1">Estimated Level</h3>
        <p id="modalDesc" class="text-sm sm:text-base text-stone-500 mt-2 leading-relaxed">Evaluation message.</p>
      </div>

      <div class="bg-[#fffaf5] p-5 rounded-2xl border border-stone-200/80 space-y-2.5 text-left">
        <div class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-2 font-brand"><span>📚 Recommended Study Plan</span></div>
        <ul id="modalRecList" class="space-y-2 text-xs sm:text-sm text-stone-700 font-medium"></ul>
      </div>

      <div class="bg-white p-4 rounded-xl border border-stone-200 flex items-center justify-between text-sm sm:text-base font-bold text-stone-600 font-brand">
        <span>Auto-Graded Score:</span>
        <span class="text-red-600 font-mono text-lg font-black" id="modalTotal">0/80</span>
      </div>

      <div class="space-y-3 pt-2 font-brand">
        <button type="button" class="open-modal-trigger block w-full py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl text-sm shadow-md transition cursor-pointer">
          Schedule Free 25-Min Speaking Evaluation →
        </button>
        <button id="btnCloseModal" type="button" class="block w-full py-3 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl text-sm transition cursor-pointer">
          🔍 Review My Answers & Mistakes
        </button>
      </div>
    </div>
  </div>

  <!-- CONSULTATION MODAL -->
  <div id="consultModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-stone-200 space-y-6 text-left">
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="text-xs font-black text-red-600 uppercase tracking-widest bg-red-50 px-3 py-1 rounded-lg border border-red-200 font-brand">1-ON-1 LESSONS</span>
          <h3 class="text-2xl font-black text-slate-900 font-brand mt-1.5">Book 25-Min Trial Lesson</h3>
        </div>
        <button id="closeConsultModalBtn" type="button" class="w-9 h-9 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold flex items-center justify-center text-sm cursor-pointer">✕</button>
      </div>

      <form id="consultForm" class="space-y-4 text-sm">
        <div>
          <label class="block font-bold text-slate-800 mb-1 text-sm">Full Name / Tên của bạn *</label>
          <input type="text" id="cName" required placeholder="e.g. Alex Smith" class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-sm" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-800 mb-1 text-sm">Country / Quốc gia *</label>
            <input type="text" id="cCountry" required placeholder="e.g. Germany, USA" class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-sm" />
          </div>
          <div>
            <label class="block font-bold text-slate-800 mb-1 text-sm">Phone / SĐT</label>
            <input type="tel" id="cPhone" placeholder="e.g. +49..." class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-sm" />
          </div>
        </div>
        <div>
          <label class="block font-bold text-slate-800 mb-1 text-sm">Email Address *</label>
          <input type="email" id="cEmail" required placeholder="name@example.com" class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-sm" />
        </div>
        <div>
          <label class="block font-bold text-slate-800 mb-1 text-sm">Learning Goals / Mục tiêu học tập *</label>
          <textarea id="cGoals" rows="3" required placeholder="Current level, target dialect, goals..." class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 resize-none text-sm"></textarea>
        </div>
        <button type="submit" class="w-full py-4 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-sm shadow-md transition cursor-pointer mt-2">Submit Request to Hang →</button>
      </form>

      <div id="successMessage" class="hidden text-center py-6 space-y-3">
        <div class="text-4xl">🎉</div>
        <h4 class="font-black text-slate-900 text-lg font-brand">Request Sent Successfully!</h4>
        <p class="text-stone-600 text-sm leading-relaxed">Thank you! Hang has received your details. She will reach out via email within 24 hours.</p>
        <button id="btnCloseSuccess" type="button" class="px-6 py-3 bg-slate-900 text-white font-bold rounded-xl text-xs cursor-pointer">Close Window</button>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="bg-[#fffaf5] text-stone-600 py-10 border-t border-stone-200/80">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left text-sm">
      <div class="flex items-center justify-center gap-2.5 font-brand">
        <span class="font-black text-slate-900 tracking-wider text-base">HAVIE</span>
        <span class="text-stone-300">•</span>
        <span class="text-stone-500">Learn Vietnamese with Hang</span>
      </div>
      <div class="flex items-center gap-6 font-semibold text-stone-700 flex-wrap justify-center font-brand">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/resources" class="hover:text-red-600 transition">Resources</a>
        <a href="/student" class="hover:text-red-600 transition">Student Portal</a>
        <a href="/test" class="text-red-600 font-bold transition">Level Test</a>
      </div>
    </div>
  </footer>

  <!-- SCRIPT LOGIC WITH REVIEW & CODE COMPRESSION -->
  <script is:inline>
    let activeDialect = 'north';
    let isSubmitted = false;

    const testDatabases = {
      north: {
        p1: [
          { id: "n_p1_1", audioFile: "/audio/level-test/tra-n.mp3", numberLabel: "1.", options: ["trà", "tra", "trã", "trạ"], correct: 0 },
          { id: "n_p1_2", audioFile: "/audio/level-test/gio-n.mp3", numberLabel: "2.", options: ["giỏ", "gio", "gió", "giò"], correct: 2 },
          { id: "n_p1_3", audioFile: "/audio/level-test/co-n.mp3", numberLabel: "3.", options: ["cộ", "cô", "cố", "cổ"], correct: 2 },
          { id: "n_p1_4", audioFile: "/audio/level-test/nang-n.mp3", numberLabel: "4.", options: ["nẵng", "năng", "nặng", "nẳng"], correct: 2 }
        ],
        p2: [
          { id: "n_p2_1", numberLabel: "1.", dialoguePrompt: "Cháu đi đâu đấy?", options: ["Không có gì đâu cô.", "Cháu đi chợ ạ.", "Cháu đi một mình.", "Tôi đang đi bộ."], correct: 1 },
          { id: "n_p2_2", numberLabel: "2.", dialoguePrompt: "Anh uống cà phê nhiều đường hay ít đường ạ?", options: ["Cà phê ngọt lắm em ơi.", "Cho anh ít đường thôi nhé.", "Cho anh cốc trà nóng nhé.", "Anh chưa uống bao giờ đâu."], correct: 1 },
          { id: "n_p2_3", numberLabel: "3.", dialoguePrompt: "Anh ơi, anh đứng ở chỗ nào toà nhà đấy?", options: ["Toà nhà này cao lắm anh ơi.", "Em đứng cạnh bạn em nhé.", "Em đứng ngay sảnh toà nhà, áo đen anh nha.", "Em đi xe máy đến rồi đây."], correct: 2 },
          { id: "n_p2_4", numberLabel: "4.", dialoguePrompt: "Tan làm đi uống cốc bia hơi nhé?", options: ["Hôm nay em bận mất rồi, để hôm khác anh nhé!", "Bia hơi ở đây không ngon đâu.", "Vâng, em không thích uống bia.", "Đi về nhà luôn thôi anh."], correct: 0 }
        ],
        p3: [
          { id: "n_p3_1", question: "1. Cho em <span style=\"display: inline-block; min-width: 70px; border-bottom: 3px solid #dc2626; margin: 0 4px; background: rgba(220,38,38,0.06);\"></span> bát phở bò.", options: ["thứ ba", "những", "ba", "các"], correct: 2 },
          { id: "n_p3_2", question: "2. Anh Nam <span style=\"display: inline-block; min-width: 70px; border-bottom: 3px solid #dc2626; margin: 0 4px; background: rgba(220,38,38,0.06);\"></span> làm việc ở văn phòng, lát nữa mới về.", options: ["sẽ", "đã", "vừa", "đang"], correct: 3 },
          { id: "n_p3_3", question: "3. Hôm nay em mệt <span style=\"display: inline-block; min-width: 70px; border-bottom: 3px solid #dc2626; margin: 0 4px; background: rgba(220,38,38,0.06);\"></span> em nghỉ làm.", options: ["nên", "nhưng", "vì", "tuy"], correct: 0 },
          { id: "n_p3_4", question: "4. Mặc dù việc rất nhiều <span style=\"display: inline-block; min-width: 70px; border-bottom: 3px solid #dc2626; margin: 0 4px; background: rgba(220,38,38,0.06);\"></span> chị ấy vẫn về đúng giờ.", options: ["tại", "nên", "vì", "nhưng"], correct: 3 }
        ],
        p4: [
          { id: "n_p4_1", contextText: "Nam: 'Tối nay qua nhà tớ ăn lẩu nhé?'\nLan: 'Tối nay tớ bận họp rồi. Mai nha!'", question: "Why can't Lan go tonight?", options: ["She is going out of town", "She doesn't like hot pot", "She is busy with a meeting", "She is too tired"], correct: 2 },
          { id: "n_p4_2", contextText: "Thông báo: Quán tạm nghỉ sửa chữa từ 15/10 đến hết 18/10. Quán sẽ mở cửa đón khách trở lại vào sáng thứ Sáu, 19/10.", question: "When can customers return to the restaurant?", options: ["On Friday, October 19th", "On October 16th", "One week after October 19th", "On October 18th"], correct: 0 },
          { id: "n_p4_3", contextText: "Sếp ơi, chiều thứ Tư em xin nghỉ nửa ngày đi khám sức khỏe định kỳ nhé. Công việc em đã bàn giao hết cho Mai rồi ạ.", question: "Why is the employee asking for time off?", options: ["For a family emergency", "For a medical check-up", "To go on a trip", "Because of sudden illness"], correct: 1 },
          { id: "n_p4_4", contextText: "Đăng ký lưu trú: Mọi trường hợp khách ở lại qua đêm tại căn hộ từ 2 đêm trở lên, chủ hộ có trách nhiệm khai báo với bảo vệ tòa nhà trước 21h.", question: "What is this regulation about?", options: ["Regulations on registering overnight guests at the apartment", "Rules for parking vehicles overnight in the building", "Instructions on paying monthly management fees", "Procedures for booking the building's meeting room"], correct: 0 }
        ],
        p5: [
          { title: "Prompt 1", text: "Hãy giới thiệu bản thân: Tên, tuổi, quốc tịch, công việc hiện tại, món ăn yêu thích và sở thích cá nhân.", en: "Introduce yourself: name, age, nationality, current job, favorite food, and personal hobby." },
          { title: "Prompt 2", text: "Anh/Chị thích ăn đồ ăn đường phố hay ăn ở quán ăn / nhà hàng? Vì sao?", en: "Do you prefer eating street food or dining in restaurants? Why?" }
        ]
      },
      south: {
        p1: [
          { id: "s_p1_1", audioFile: "/audio/level-test/tra-s.mp3", numberLabel: "1.", options: ["trà", "tra", "trã", "trạ"], correct: 1 },
          { id: "s_p1_2", audioFile: "/audio/level-test/gio-s.mp3", numberLabel: "2.", options: ["gió", "gio", "giỏ", "giò"], correct: 0 },
          { id: "s_p1_3", audioFile: "/audio/level-test/co-s.mp3", numberLabel: "3.", options: ["cộ", "cô", "cố", "cổ"], correct: 2 },
          { id: "s_p1_4", audioFile: "/audio/level-test/nang-s.mp3", numberLabel: "4.", options: ["năng", "nẵng", "nẳng", "nặng"], correct: 3 }
        ],
        p2: [
          { id: "s_p2_1", numberLabel: "1.", dialoguePrompt: "Con đi đâu đó?", options: ["Hổng có gì đâu cô.", "Con đi một mình.", "Dạ con đi chợ.", "Tôi đang đi bộ."], correct: 2 },
          { id: "s_p2_2", numberLabel: "2.", dialoguePrompt: "Bạc xỉu uống ngọt nhiều hay ít ngọt vậy anh?", options: ["Cho em ít sữa thôi nha.", "Cho em ly trà đá nha chị.", "Cà phê này đắng quá em ơi.", "Em uống gì cũng được hết á."], correct: 0 },
          { id: "s_p2_3", numberLabel: "3.", dialoguePrompt: "Anh ơi, anh đứng ở chỗ nào toà nhà đấy?", options: ["Toà nhà này cao lắm anh ơi.", "Em đứng ngay sảnh toà nhà, áo đen anh nha.", "Em đứng cạnh bạn em nhé.", "Em đi xe máy đến rồi đây."], correct: 1 },
          { id: "s_p2_4", numberLabel: "4.", dialoguePrompt: "Tan làm đi uống ly bia nha anh?", options: ["Bữa nay anh bận mất rồi, để bữa khác nha em!", "Bia ở đây dở lắm em ơi.", "Dạ, anh hổng thích uống bia.", "Đi về nhà luôn thôi em."], correct: 0 }
        ],
        p3: [
          { id: "s_p3_1", question: "1. Cho em <span style=\"display: inline-block; min-width: 70px; border-bottom: 3px solid #dc2626; margin: 0 4px; background: rgba(220,38,38,0.06);\"></span> tô hủ tiếu nha.", options: ["thứ ba", "ba", "những", "các"], correct: 1 },
          { id: "s_p3_2", question: "2. Anh Nam <span style=\"display: inline-block; min-width: 70px; border-bottom: 3px solid #dc2626; margin: 0 4px; background: rgba(220,38,38,0.06);\"></span> làm việc ở văn phòng, chút nữa mới về.", options: ["sẽ", "vừa", "đang", "đã"], correct: 2 },
          { id: "s_p3_3", question: "3. Bữa nay em mệt <span style=\"display: inline-block; min-width: 70px; border-bottom: 3px solid #dc2626; margin: 0 4px; background: rgba(220,38,38,0.06);\"></span> em nghỉ làm.", options: ["nhưng", "nên", "vì", "tuy"], correct: 1 },
          { id: "s_p3_4", question: "4. Mặc dù việc nhiều dữ lắm <span style=\"display: inline-block; min-width: 70px; border-bottom: 3px solid #dc2626; margin: 0 4px; background: rgba(220,38,38,0.06);\"></span> chị ấy vẫn về đúng giờ.", options: ["tại", "vì", "nên", "nhưng"], correct: 3 }
        ],
        p4: [
          { id: "s_p4_1", contextText: "Nam: 'Tối nay qua nhà tớ ăn lẩu nhé?'\nLan: 'Tối nay tớ bận họp rồi. Mai nha!'", question: "Why can't Lan go tonight?", options: ["She doesn't like hot pot", "She is busy with a meeting", "She is going out of town", "She is too tired"], correct: 1 },
          { id: "s_p4_2", contextText: "Thông báo: Quán tạm nghỉ sửa chữa từ 15/10 đến hết 18/10. Quán sẽ mở cửa đón khách trở lại vào sáng thứ Sáu, 19/10.", question: "When can customers return to the restaurant?", options: ["On October 16th", "On Friday, October 19th", "One week after October 19th", "On October 18th"], correct: 1 },
          { id: "s_p4_3", contextText: "Sếp ơi, chiều thứ Tư em xin nghỉ nửa ngày đi khám sức khỏe định kỳ nhé. Công việc em đã bàn giao hết cho Mai rồi ạ.", question: "Why is the employee asking for time off?", options: ["To go on a trip", "For a family emergency", "For a medical check-up", "Because of sudden illness"], correct: 2 },
          { id: "s_p4_4", contextText: "Đăng ký lưu trú: Mọi trường hợp khách ở lại qua đêm tại căn hộ từ 2 đêm trở lên, chủ hộ có trách nhiệm khai báo với bảo vệ tòa nhà trước 21h.", question: "What is this regulation about?", options: ["Rules for parking vehicles overnight in the building", "Instructions on paying monthly management fees", "Regulations on registering overnight guests at the apartment", "Procedures for booking the building's meeting room"], correct: 2 }
        ],
        p5: [
          { title: "Prompt 1", text: "Hãy giới thiệu bản thân: Tên, tuổi, quốc tịch, công việc hiện tại, món ăn yêu thích và sở thích cá nhân.", en: "Introduce yourself: name, age, nationality, current job, favorite food, and personal hobby." },
          { title: "Prompt 2", text: "Anh/Chị thích ăn đồ ăn đường phố hay ăn ở quán ăn / nhà hàng? Vì sao?", en: "Do you prefer eating street food or dining in restaurants? Why?" }
        ]
      }
    };

    const sectionScores = { p1: 0, p2: 0, p3: 0, p4: 0 };

    function renderSection(sectionKey, title, subtitle, dataList) {
      const container = document.getElementById('testSectionsContainer');
      const secDiv = document.createElement('section');
      secDiv.className = 'bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-stone-200/90 space-y-6';
      secDiv.id = `sec_${sectionKey}`;

      let html = `
        <div class="border-b border-stone-100 pb-4 flex items-center justify-between">
          <div>
            <span class="text-xs font-black uppercase tracking-wider text-red-600 bg-red-50 px-3 py-1 rounded-md font-brand">${title}</span>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 font-brand mt-2">${subtitle}</h2>
          </div>
          <span class="text-xs font-bold text-stone-400 font-mono">20 Points</span>
        </div>
        <div class="space-y-5" id="list_${sectionKey}"></div>
      `;
      secDiv.innerHTML = html;
      container.appendChild(secDiv);

      const listContainer = document.getElementById(`list_${sectionKey}`);
      dataList.forEach((q, idx) => {
        const qCard = document.createElement('div');
        qCard.className = 'p-5 sm:p-6 rounded-2xl bg-[#fffaf5] border border-stone-200/80 space-y-4 text-sm sm:text-base';
        qCard.id = `card_${q.id}`;

        let topContent = '';
        if (sectionKey === 'p1') {
          topContent = `
            <div class="flex items-center gap-3.5">
              <span class="font-bold text-slate-950 text-base">${q.numberLabel}</span>
              <audio id="audio_${q.id}" src="${q.audioFile}"></audio>
              <button type="button" class="play-audio-btn px-4 py-2 bg-white border border-stone-200 rounded-xl font-bold text-stone-700 hover:text-red-600 transition cursor-pointer flex items-center gap-1.5 shadow-2xs text-xs sm:text-sm" data-audio-id="audio_${q.id}">
                <span>🔊</span> <span>Listen</span>
              </button>
            </div>`;
        } else if (sectionKey === 'p2') {
          topContent = `<div class="font-bold text-slate-950 text-base sm:text-lg font-brand">${q.numberLabel} "${q.dialoguePrompt}"</div>`;
        } else if (sectionKey === 'p3') {
          topContent = `<div class="font-bold text-slate-950 text-base sm:text-lg leading-relaxed">${q.question}</div>`;
        } else if (sectionKey === 'p4') {
          topContent = `
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-stone-200/90 shadow-2xs mb-3">
              <p class="text-slate-900 font-medium text-sm sm:text-base leading-relaxed whitespace-pre-line font-sans">"${q.contextText}"</p>
            </div>
            <div class="font-bold text-slate-950 text-base sm:text-lg pt-1">${idx+1}. ${q.question}</div>`;
        }

        let optsHtml = `<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">`;
        q.options.forEach((opt, oIdx) => {
          optsHtml += `
            <label class="flex items-center gap-3 p-3.5 rounded-xl border bg-white border-stone-200 cursor-pointer hover:border-red-400 font-semibold text-slate-800 text-sm sm:text-base shadow-2xs transition">
              <input type="radio" name="${q.id}" value="${oIdx}" class="accent-red-600 w-4 h-4" />
              <span>${opt}</span>
            </label>`;
        });
        optsHtml += `</div>`;

        let reviewHtml = `<div id="rev_${q.id}" class="hidden mt-3 p-3.5 rounded-xl text-xs sm:text-sm font-bold flex items-center justify-between"></div>`;

        qCard.innerHTML = topContent + optsHtml + reviewHtml;
        listContainer.appendChild(qCard);
      });
    }

    function renderTest() {
      const container = document.getElementById('testSectionsContainer');
      container.innerHTML = '';
      const data = testDatabases[activeDialect];

      renderSection('p1', 'Section 1', 'Part 1: Tones Discrimination', data.p1);
      renderSection('p2', 'Section 2', 'Part 2: Quick Responses', data.p2);
      renderSection('p3', 'Section 3', 'Part 3: Grammar & Context', data.p3);
      renderSection('p4', 'Section 4', 'Part 4: Real-World Reading Comprehension', data.p4);

      // Render P5
      const cP5 = document.getElementById('containerP5');
      cP5.innerHTML = '';
      data.p5.forEach(q => {
        const div = document.createElement('div');
        div.className = 'p-5 sm:p-6 rounded-2xl bg-[#fffaf5] border border-stone-200/80 space-y-2 text-sm sm:text-base';
        div.innerHTML = `
          <span class="text-xs font-bold text-stone-400 uppercase tracking-wider font-brand">${q.title}</span>
          <p class="font-bold text-slate-900 text-base sm:text-lg">${q.text}</p>
          <p class="text-stone-500 italic text-xs sm:text-sm">${q.en}</p>
        `;
        cP5.appendChild(div);
      });

      // Attach Audio events
      document.querySelectorAll('.play-audio-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const audioEl = document.getElementById(btn.getAttribute('data-audio-id'));
          if (audioEl) { audioEl.currentTime = 0; audioEl.play().catch(e => {}); }
        });
      });

      if (isSubmitted) applyReviewMode();
      updateHeaderScores();
    }

    function updateHeaderScores() {
      document.getElementById('scoreP1').textContent = sectionScores.p1;
      document.getElementById('scoreP2').textContent = sectionScores.p2;
      document.getElementById('scoreP3').textContent = sectionScores.p3;
      document.getElementById('scoreP4').textContent = sectionScores.p4;
      document.getElementById('scoreTotal').textContent = sectionScores.p1 + sectionScores.p2 + sectionScores.p3 + sectionScores.p4;
    }

    // Dialect switch
    document.getElementById('btnSelectNorth').addEventListener('click', () => {
      activeDialect = 'north'; isSubmitted = false;
      document.getElementById('btnSelectNorth').className = 'px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold bg-slate-900 text-white shadow-xs cursor-pointer';
      document.getElementById('btnSelectSouth').className = 'px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold text-stone-600 hover:text-slate-900 cursor-pointer';
      renderTest();
    });

    document.getElementById('btnSelectSouth').addEventListener('click', () => {
      activeDialect = 'south'; isSubmitted = false;
      document.getElementById('btnSelectSouth').className = 'px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold bg-red-600 text-white shadow-xs cursor-pointer';
      document.getElementById('btnSelectNorth').className = 'px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold text-stone-600 hover:text-slate-900 cursor-pointer';
      renderTest();
    });

    function calculateScores() {
      const db = testDatabases[activeDialect];
      let calcScore = (pArr) => {
        let sc = 0;
        pArr.forEach(q => {
          const sel = document.querySelector(`input[name="${q.id}"]:checked`);
          if (sel && parseInt(sel.value) === q.correct) sc += 5;
        });
        return sc;
      };
      sectionScores.p1 = calcScore(db.p1);
      sectionScores.p2 = calcScore(db.p2);
      sectionScores.p3 = calcScore(db.p3);
      sectionScores.p4 = calcScore(db.p4);
      updateHeaderScores();
    }

    function applyReviewMode() {
      const db = testDatabases[activeDialect];
      const allParts = [...db.p1, ...db.p2, ...db.p3, ...db.p4];

      allParts.forEach(q => {
        const sel = document.querySelector(`input[name="${q.id}"]:checked`);
        const userVal = sel ? parseInt(sel.value) : null;
        const revBox = document.getElementById(`rev_${q.id}`);
        revBox.classList.remove('hidden');

        if (userVal === q.correct) {
          revBox.className = "mt-3 p-3.5 rounded-xl text-xs sm:text-sm font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 flex items-center justify-between";
          revBox.innerHTML = `<span>✅ Correct! The right answer is: "${q.options[q.correct]}"</span>`;
        } else {
          revBox.className = "mt-3 p-3.5 rounded-xl text-xs sm:text-sm font-bold bg-red-50 text-red-800 border border-red-200 flex items-center justify-between";
          const chosenText = userVal !== null ? q.options[userVal] : "Not answered";
          revBox.innerHTML = `<span>❌ Your choice: "${chosenText}" — <strong>Correct answer: "${q.options[q.correct]}"</strong></span>`;
        }
      });
    }

    // Submit & Modals
    const btnFinalSubmit = document.getElementById('btnFinalSubmit');
    const resultModal = document.getElementById('resultModal');
    const btnCloseModal = document.getElementById('btnCloseModal');

    btnFinalSubmit.addEventListener('click', () => {
      calculateScores();
      isSubmitted = true;
      applyReviewMode();

      const total = sectionScores.p1 + sectionScores.p2 + sectionScores.p3 + sectionScores.p4;
      document.getElementById('modalTotal').textContent = `${total}/80`;

      const badgeEl = document.getElementById('modalBadge');
      const titleEl = document.getElementById('modalLevelTitle');
      const descEl = document.getElementById('modalDesc');
      const recListEl = document.getElementById('modalRecList');

      let recs = [];
      if (total >= 70) {
        badgeEl.textContent = "💎"; titleEl.textContent = "Advanced (C1-C2)";
        descEl.textContent = "Exceptional reading comprehension & subtle register control.";
        recs = ["🔹 Master advanced idioms and professional pitching.", "🔹 Decode implicit cultural metaphors."];
      } else if (total >= 50) {
        badgeEl.textContent = "🌟"; titleEl.textContent = "Intermediate (B1-B2)";
        descEl.textContent = "Handles practical daily scenarios smoothly.";
        recs = ["🔹 Perfect complex transition words.", "🔹 Shift pronouns naturally across generations."];
      } else if (total >= 30) {
        badgeEl.textContent = "🌱"; titleEl.textContent = "Elementary (A2)";
        descEl.textContent = "Manages survival basics well.";
        recs = ["🔹 Solidify fundamental sentence structures.", "🔹 Practice filling administrative forms."];
      } else {
        badgeEl.textContent = "🎯"; titleEl.textContent = "Beginner (A1)";
        descEl.textContent = "Great starting point for the 6 tones.";
        recs = ["🔹 Focus heavily on pitch contours.", "🔹 Build survival vocabulary."];
      }
      recListEl.innerHTML = recs.map(r => `<li>${r}</li>`).join('');
      resultModal.classList.remove('hidden');
    });

    btnCloseModal.addEventListener('click', () => {
      resultModal.classList.add('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Mobile Menu
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    if(mobileMenuBtn) {
      mobileMenuBtn.addEventListener('click', () => {
        // Toggle action if needed
      });
    }

    // Consult Modal Controls
    const consultModal = document.getElementById('consultModal');
    document.querySelectorAll('.open-modal-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        resultModal.classList.add('hidden');
        consultModal.classList.remove('hidden');
      });
    });
    document.getElementById('closeConsultModalBtn').addEventListener('click', () => consultModal.classList.add('hidden'));
    document.getElementById('btnCloseSuccess').addEventListener('click', () => consultModal.classList.add('hidden'));

    consultForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      document.getElementById('consultForm').classList.add('hidden');
      document.getElementById('successMessage').classList.remove('hidden');
    });

    renderTest();
  </script>
</body>
</html>