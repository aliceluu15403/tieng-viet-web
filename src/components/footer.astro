<footer class="bg-[#fffaf5] text-stone-600 py-10 border-t border-stone-200/80">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
    
    <!-- CỘT TRÁI: LOGO & MÔ TẢ -->
    <div class="flex items-center justify-center gap-2.5">
      <span class="font-brand font-black text-slate-900 tracking-wider text-base sm:text-lg">HAVIE</span>
      <span class="text-stone-300">•</span>
      <span class="text-xs sm:text-sm font-medium text-stone-500">Learn Vietnamese with Hang</span>
    </div>

    <!-- CỘT PHẢI: COPYRIGHT & EMAIL GỘP CHUNG MỘT DÒNG, TO RÕ, SANG TRỌNG -->
    <div class="flex items-center gap-3 text-xs sm:text-sm text-stone-500 font-medium flex-wrap justify-center">
      <span>© 2026 Havie. All rights reserved.</span>
      <span class="text-stone-300 hidden sm:inline">•</span>
      <span>Contact: <a href="mailto:support@havie.vn" class="font-bold text-slate-800 hover:text-red-600 transition">support@havie.vn</a></span>
