---
// src/pages/resources/tones.astro - Havie Vietnamese Tones Studio
const TONES = [
  { 
    id: 'ngang', 
    num: '1', 
    name: 'Ngang', 
    type: 'Flat', 
    word: 'ma', 
    en: 'Ghost', 
    path: 'M 10,25 L 110,25', 
    color: '#10b981', 
    bg: 'hover:border-emerald-400',
    mechanic: 'Keep pitch steady at mid level. Relax your jaw and vocal cords, like humming.'
  },
  { 
    id: 'sac',   
    num: '2', 
    name: 'Sắc', 
    type: 'Up', 
    word: 'má', 
    en: 'Mother', 
    path: 'M 10,38 L 110,12', 
    color: '#e52b27', 
    bg: 'hover:border-red-400',
    mechanic: 'Start at mid pitch and shoot sharply upward. Tighten cords quickly, like asking: "WHAT?!".'
  },
  { 
    id: 'huyen', 
    num: '3', 
    name: 'Huyền', 
    type: 'Down', 
    word: 'mà', 
    en: 'But', 
    path: 'M 10,15 L 110,38', 
    color: '#3b82f6', 
    bg: 'hover:border-blue-400',
    mechanic: 'Start at lower-mid pitch and glide down gently. Drop chin like a relaxed sigh: "Ahhh".'
  },
  { 
    id: 'hoi',   
    num: '4', 
    name: 'Hỏi', 
    type: 'Question Mark', 
    word: 'mả', 
    en: 'Tomb', 
    path: 'M 10,18 Q 60,44 110,20', 
    color: '#d97706', 
    bg: 'hover:border-amber-400',
    mechanic: 'Dip deep into low pitch, then scoop upward with a questioning curve: "Reaaally?".'
  },
  { 
    id: 'nga',   
    num: '5', 
    name: 'Ngã', 
    type: 'Wave', 
    word: 'mã', 
    en: 'Horse', 
    path: 'M 10,28 L 50,32 M 70,24 L 110,10', 
    color: '#8b5cf6', 
    bg: 'hover:border-purple-400',
    mechanic: 'High rising pitch broken midway by a brief throat stop before rising: "Uh-oh!".'
  },
  { 
    id: 'nang',  
    num: '6', 
    name: 'Nặng', 
    type: 'Dot', 
    word: 'mạ', 
    en: 'Seedling', 
    path: 'M 10,18 L 85,38', 
    dot: true, 
    color: '#ea580c', 
    bg: 'hover:border-orange-400',
    mechanic: 'Drop pitch immediately to the bottom and cut airflow dead short, like a blunt "Yup!".'
  },
];
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vietnamese Tones Studio — Havie</title>
  <meta name="description" content="Master 6 Vietnamese tones with native audio, vocal mechanics, dialect switcher, and interactive ear workout." />

  <!-- FAVICON & MOBILE TOUCH ICONS -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #fffaf5;
      --navy: #0f172a;
      --brand-red: #dc2626;
      --orange: #ef7218;
    }

    html {
      scroll-padding-top: 85px;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--cream);
      color: var(--navy);
    }

    .font-brand {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .font-tone {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .curved-underline {
      position: relative;
    }
    .curved-underline::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 100%;
      height: 6px;
      border-bottom: 3px solid var(--orange);
      border-radius: 50%;
      transform: rotate(-1.5deg);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-red-600 selection:text-white relative overflow-x-hidden">

  <!-- BACKGROUND GLOW -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute top-0 right-[15%] w-[450px] h-[450px] bg-gradient-to-br from-amber-400/20 via-red-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute top-40 left-[10%] w-[380px] h-[380px] bg-gradient-to-tr from-amber-200/30 to-transparent rounded-full blur-3xl"></div>
  </div>

  <!-- NAVBAR -->
  <header class="sticky top-0 z-40 bg-[#fffaf5]/90 backdrop-blur-md border-b border-stone-200/80 h-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 h-full flex items-center justify-between">
      
      <!-- LOGO -->
      <a href="/" class="group flex flex-col select-none text-left">
        <div class="h-6 sm:h-7 flex items-center">
          <svg class="h-6 sm:h-7 w-auto overflow-visible" viewBox="0 0 175 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 2H6V12H18V2H24V28H18V17H6V28H0V2Z" fill="#dc2626"/>
            <path d="M41 2L52 28H45.5L43.2 22H33.8L31.5 28H25L36 2H41ZM38.5 8.5L35.2 17.5H41.8L38.5 8.5Z" fill="#dc2626"/>
            <path d="M53 2H59.5L67 21L74.5 2H81L70.5 28H63.5L53 2Z" fill="#dc2626"/>
            <path d="M86 2H92V28H86V2Z" fill="#dc2626"/>
            <path d="M98 2H117V7.5H104V12H115V17H104V22.5H117V28H98V2Z" fill="#dc2626"/>
          </svg>
        </div>
        <span class="text-[9px] sm:text-[9.5px] font-bold tracking-[0.2em] sm:tracking-[0.24em] text-stone-400 uppercase mt-1 pl-0.5 leading-none">
          Learn Vietnamese Online
        </span>
      </a>

      <!-- Desktop Menu Links -->
      <nav class="hidden md:flex items-center space-x-6 lg:space-x-7 text-sm font-semibold text-slate-700">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/#reviews" class="hover:text-red-600 transition">Student Stories</a>
        <a href="/resources" class="text-red-600 font-bold transition">Resources</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        <a href="/#faq" class="hover:text-red-600 transition">FAQ</a>
      </nav>

      <!-- Desktop CTA & Mobile Toggle Button -->
      <div class="flex items-center gap-3">
        <button
          type="button"
          class="open-modal-trigger hidden sm:inline-flex items-center justify-center px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-lg shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>

        <!-- Mobile Menu Hamburger Button -->
        <button 
          id="mobileMenuBtn" 
          type="button" 
          aria-label="Toggle Menu"
          class="md:hidden w-10 h-10 rounded-xl bg-stone-100 hover:bg-stone-200 text-slate-800 flex items-center justify-center font-bold transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobileMenu" class="hidden md:hidden absolute top-20 left-0 w-full bg-[#fffaf5] border-b border-stone-200 shadow-xl px-6 py-5 space-y-4 font-semibold text-slate-700 text-sm">
      <a href="/#about" class="mobile-link block hover:text-red-600 transition">About Me</a>
      <a href="/#curriculum" class="mobile-link block hover:text-red-600 transition">Learning Tracks</a>
      <a href="/#reviews" class="mobile-link block hover:text-red-600 transition">Student Stories</a>
      <a href="/resources" class="mobile-link block text-red-600 font-bold">Resources</a>
      <a href="/test" class="mobile-link block hover:text-red-600 transition">Level Test</a>
      <a href="/#faq" class="mobile-link block hover:text-red-600 transition">FAQ</a>
      <div class="pt-3 border-t border-stone-200">
        <button
          type="button"
          class="open-modal-trigger w-full py-3 text-xs font-bold text-white bg-red-600 rounded-xl text-center shadow-md cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>
    </div>
  </header>

  <main class="flex-grow py-10 lg:py-14">
    
    <!-- HEADER & DIALECT SWITCHER -->
    <section class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 mb-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-extrabold text-red-600 uppercase tracking-widest bg-red-50 px-4 py-1.5 rounded-full border border-red-200 inline-block shadow-2xs">
            Tones Studio
          </span>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight font-brand whitespace-nowrap pt-1">
            Master the 6 <span class="curved-underline text-red-600">Vietnamese Tones.</span>
          </h1>
          <p class="text-stone-600 text-sm sm:text-base leading-relaxed pt-2">
            Select your accent first, click any tone card to hear native pronunciation, and <a href="#workout" class="text-red-600 font-bold underline underline-offset-4 decoration-red-300 hover:decoration-red-600 transition cursor-pointer">practice</a> ↓.
          </p>
        </div>

        <!-- ACCENT SWITCHER -->
        <div class="inline-flex items-center p-1.5 bg-white rounded-2xl border border-stone-200 shadow-xs shrink-0 self-start md:self-auto">
          <button 
            id="btn-north" 
            onclick="setDialect('north')" 
            class="px-4 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs sm:text-sm transition shadow-xs cursor-pointer"
          >
            🇻🇳 Northern (Hanoi)
          </button>
          <button 
            id="btn-south" 
            onclick="setDialect('south')" 
            class="px-4 py-2.5 rounded-xl text-stone-500 hover:text-slate-900 font-bold text-xs sm:text-sm transition cursor-pointer"
          >
            🇻🇳 Southern (Saigon)
          </button>
        </div>
      </div>
    </section>

    <!-- 6 TONE CARDS GRID -->
    <section class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {TONES.map(t => (
          <div 
            onclick={`playTone('${t.id}')`}
            class={`group bg-white rounded-3xl p-6 lg:p-7 border border-stone-200/90 ${t.bg} shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 cursor-pointer flex flex-col justify-between relative select-none`}
          >
            <div class="relative z-10">
              <!-- Top Info -->
              <div class="flex items-center justify-between pb-4 border-b border-stone-100">
                <span class="font-mono font-extrabold text-xs text-stone-400 uppercase tracking-widest">TONE {t.num}</span>
                <span id={`tone-badge-${t.id}`} class="font-bold text-xs text-slate-800 bg-stone-100/90 px-3 py-1 rounded-full border border-stone-200/60">
                  {t.name} • {t.type}
                </span>
              </div>

              <!-- Main Word & SVG Graph -->
              <div class="py-5 flex items-center justify-between gap-4">
                <div>
                  <span class="text-4xl sm:text-5xl font-black font-tone text-slate-900 group-hover:text-red-600 transition-colors leading-none block">
                    {t.word}
                  </span>
                  <span id={`tone-en-${t.id}`} class="text-xs sm:text-sm font-bold text-stone-400 mt-1.5 block">
                    {t.en}
                  </span>
                </div>

                <div class="w-24 h-12 flex items-center justify-center bg-stone-50/80 rounded-2xl p-2 border border-stone-100">
                  <svg id={`svg-graph-${t.id}`} class="w-full h-full" viewBox="0 0 120 50">
                    <path class="tone-path" d={t.path} fill="none" stroke={t.color} stroke-width="5" stroke-linecap="round" />
                    {t.dot && <circle class="tone-dot" cx="102" cy="38" r="5" fill={t.color} />}
                  </svg>
                </div>
              </div>

              <!-- Vocal Mechanic Tip -->
              <p id={`tone-mechanic-${t.id}`} class="text-xs sm:text-sm text-stone-600 leading-relaxed pt-1">
                {t.mechanic}
              </p>
            </div>

            <!-- Footer Audio Trigger -->
            <div class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between text-xs font-bold text-stone-400 group-hover:text-red-600 transition-colors relative z-10">
              <span>Click to listen & repeat</span>
              <div class="w-8 h-8 rounded-full bg-stone-100 group-hover:bg-red-600 group-hover:text-white flex items-center justify-center transition-colors text-xs shadow-2xs">
                🔊
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- PRACTICE WORKOUT SECTION -->
    <section id="workout" class="max-w-5xl mx-auto px-5 sm:px-8 lg:px-12 pt-6 scroll-mt-28">
      <div class="bg-white rounded-3xl p-6 sm:p-10 border border-stone-200/95 shadow-md relative overflow-hidden">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-stone-100">
          <div>
            <span id="practiceSubtitle" class="text-xs font-extrabold text-red-600 uppercase tracking-widest block mb-1">Practice • 6 Questions</span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900">Which Tone Did You Hear?</h2>
            <p class="text-stone-500 text-xs sm:text-sm mt-1">Play the audio and test your ear by selecting the exact tone match below.</p>
          </div>
          <div class="flex items-center gap-4 bg-stone-50 px-5 py-2.5 rounded-2xl border border-stone-200 shrink-0 text-sm font-bold self-start sm:self-auto">
            <span id="quizRound" class="text-slate-900 font-mono font-extrabold">1 / 6</span>
            <span class="text-stone-300">|</span>
            <span class="text-stone-500">Score: <strong id="quizScore" class="text-red-600 font-mono font-extrabold">0</strong></span>
          </div>
        </div>

        <div id="quizPlayArea" class="pt-6">
          <div class="py-8 text-center space-y-3">
            <button 
              id="btnPlayQuiz" 
              onclick="playCurrentQuestionAudio()" 
              class="px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-2xl text-sm sm:text-base shadow-md shadow-red-600/20 transition active:scale-95 inline-flex items-center gap-2.5 cursor-pointer"
            >
              <span class="text-lg">🔊</span> 
              <span id="quizBtnText">Listen Audio</span>
            </button>
            <div id="quizPromptHint" class="text-xs text-stone-400 font-medium italic">Click to play sound, then pick the right choice below.</div>
          </div>

          <div id="quizChoicesGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto"></div>
          
          <div id="quizFeedback" class="hidden mt-6 p-4.5 rounded-2xl text-xs sm:text-sm font-semibold text-center max-w-2xl mx-auto"></div>

          <div id="nextButtonArea" class="hidden mt-6 text-center">
            <button 
              onclick="goToNextQuestion()" 
              class="px-8 py-3 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl text-xs sm:text-sm transition shadow-sm cursor-pointer"
            >
              Next Question →
            </button>
          </div>
        </div>

        <!-- SUMMARY -->
        <div id="quizSummaryArea" class="hidden py-12 text-center space-y-4">
          <div class="w-16 h-16 rounded-3xl bg-amber-100 text-amber-700 flex items-center justify-center text-3xl mx-auto shadow-xs">🏆</div>
          <h3 class="text-3xl font-black text-slate-900">Workout Completed!</h3>
          <p id="quizFinalResultText" class="text-stone-600 text-sm sm:text-base max-w-md mx-auto leading-relaxed"></p>
          <div class="pt-4 flex justify-center gap-4">
            <button type="button" class="open-modal-trigger px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl text-xs sm:text-sm shadow-md transition cursor-pointer">Book Trial Lesson →</button>
            <button onclick="restartQuiz()" class="px-6 py-3 bg-stone-100 hover:bg-stone-200 text-slate-900 font-bold rounded-xl text-xs sm:text-sm transition cursor-pointer">Practice Again ↺</button>
          </div>
        </div>

      </div>

      <!-- BANNER TRIAL -->
      <div class="mt-10 rounded-3xl bg-gradient-to-r from-red-50 via-white to-amber-50 border border-red-200/80 p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
        <div class="space-y-1 text-center md:text-left">
          <span class="text-xs font-bold uppercase tracking-wider text-red-600">Personalized Coaching</span>
          <h3 class="text-xl font-extrabold text-slate-900">Want to fix your pronunciation with Hang Luu?</h3>
          <p class="text-xs sm:text-sm text-stone-600">Let's figure out where you're getting stuck and practice together in a 25-minute trial session.</p>
        </div>
        <button 
          type="button"
          class="open-modal-trigger shrink-0 px-6 py-3.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl text-xs shadow-md shadow-red-600/20 transition hover:-translate-y-0.5 cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="bg-[#fffaf5] text-stone-600 py-8 text-xs border-t border-stone-200/80">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex items-center justify-center gap-2.5">
        <span class="font-brand font-black text-slate-900 tracking-widest text-sm">HAVIE.</span>
        <span class="text-stone-400">•</span>
        <span class="font-medium">Learn Vietnamese with Hang</span>
      </div>
      <div class="flex items-center gap-4 sm:gap-6 font-semibold text-stone-700 flex-wrap justify-center">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/#reviews" class="hover:text-red-600 transition">Student Stories</a>
        <a href="/resources" class="text-red-600 transition font-bold">Resources</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        <button type="button" class="open-modal-trigger text-red-600 font-bold hover:underline cursor-pointer">Book Trial</button>
      </div>
    </div>
  </footer>

  <!-- CONSULTATION / BOOKING MODAL -->
  <div id="consultModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-stone-200 space-y-5 text-left">
      
      <div class="flex items-center justify-between border-b border-stone-100 pb-3">
        <div>
          <span class="text-[10px] font-black text-red-600 uppercase tracking-widest bg-red-50 px-2.5 py-0.5 rounded border border-red-200">1-on-1 Coaching</span>
          <h3 class="text-xl font-black text-slate-900 font-brand mt-1">Book 25-Min Trial Lesson</h3>
        </div>
        <button id="closeModalBtn" type="button" class="w-8 h-8 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-600 font-bold flex items-center justify-center cursor-pointer">
          ✕
        </button>
      </div>

      <form id="consultForm" class="space-y-3.5 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Full Name / Tên của bạn *</label>
          <input type="text" id="cName" required placeholder="e.g. Alex Smith" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Country / Quốc gia *</label>
            <input type="text" id="cCountry" required placeholder="e.g. Germany, USA" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Phone / SĐT</label>
            <input type="tel" id="cPhone" placeholder="e.g. +49..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Email Address *</label>
          <input type="email" id="cEmail" required placeholder="name@example.com" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Learning Goals / Mục tiêu học tập *</label>
          <textarea id="cGoals" rows="3" required placeholder="Current level, target dialect (Hanoi/Saigon), goals..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50 resize-none"></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3.5 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-xs sm:text-sm shadow-md transition cursor-pointer mt-2"
        >
          Submit Request to Hang →
        </button>
      </form>

      <div id="successMessage" class="hidden text-center py-6 space-y-3">
        <div class="text-3xl">🎉</div>
        <h4 class="font-black text-slate-900 text-base font-brand">Request Sent Successfully!</h4>
        <p class="text-stone-600 text-xs leading-relaxed">Thank you! Hang has received your details and goals. She will reach out via email within 24 hours.</p>
        <button id="btnCloseSuccess" type="button" class="px-6 py-2.5 bg-slate-900 text-white font-bold rounded-xl text-xs cursor-pointer">
          Close Window
        </button>
      </div>

    </div>
  </div>

  <!-- SCRIPT LOGIC -->
  <script is:inline>
    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });
    }

    const TONE_NAMES = { 
      ngang: 'Tone 1 (Flat)', 
      sac:   'Tone 2 (Up)', 
      huyen: 'Tone 3 (Down)', 
      hoi:   'Tone 4 (Question Mark)', 
      nga:   'Tone 5 (Wave)', 
      nang:  'Tone 6 (Dot)' 
    };
    
    // Miền Bắc: 6 câu
    const QUIZ_ROUNDS_NORTH = [
      { correctIndex: 2, choices: [{ word: 'ca', tone: 'ngang' }, { word: 'cà', tone: 'huyen' }, { word: 'cá', tone: 'sac' }, { word: 'cả', tone: 'hoi' }] },
      { correctIndex: 2, choices: [{ word: 'sưa', tone: 'ngang' }, { word: 'sừa', tone: 'huyen' }, { word: 'sữa', tone: 'sac' }, { word: 'sửa', tone: 'hoi' }] },
      { correctIndex: 3, choices: [{ word: 'phơ', tone: 'ngang' }, { word: 'phờ', tone: 'huyen' }, { word: 'phớ', tone: 'sac' }, { word: 'phở', tone: 'hoi' }] },
      { correctIndex: 3, choices: [{ word: 'la', tone: 'ngang' }, { word: 'là', tone: 'huyen' }, { word: 'lá', tone: 'sac' }, { word: 'lạ', tone: 'nang' }] },
      { correctIndex: 0, choices: [{ word: 'to', tone: 'ngang' }, { word: 'tò', tone: 'huyen' }, { word: 'tỏ', tone: 'hoi' }, { word: 'tọ', tone: 'nang' }] },
      { correctIndex: 1, choices: [{ word: 'ga', tone: 'ngang' }, { word: 'gà', tone: 'huyen' }, { word: 'gá', tone: 'sac' }, { word: 'gả', tone: 'hoi' }] }
    ];

    // Miền Nam: 5 câu (bỏ câu sữa)
    const QUIZ_ROUNDS_SOUTH = [
      { correctIndex: 2, choices: [{ word: 'ca', tone: 'ngang' }, { word: 'cà', tone: 'huyen' }, { word: 'cá', tone: 'sac' }, { word: 'cả', tone: 'hoi' }] },
      { correctIndex: 3, choices: [{ word: 'phơ', tone: 'ngang' }, { word: 'phờ', tone: 'huyen' }, { word: 'phớ', tone: 'sac' }, { word: 'phở', tone: 'hoi' }] },
      { correctIndex: 3, choices: [{ word: 'la', tone: 'ngang' }, { word: 'là', tone: 'huyen' }, { word: 'lá', tone: 'sac' }, { word: 'lạ', tone: 'nang' }] },
      { correctIndex: 0, choices: [{ word: 'to', tone: 'ngang' }, { word: 'tò', tone: 'huyen' }, { word: 'tỏ', tone: 'hoi' }, { word: 'tọ', tone: 'nang' }] },
      { correctIndex: 1, choices: [{ word: 'ga', tone: 'ngang' }, { word: 'gà', tone: 'huyen' }, { word: 'gá', tone: 'sac' }, { word: 'gả', tone: 'hoi' }] }
    ];

    let currentDialect = 'north';
    let currentRoundIndex = 0;
    let score = 0;
    let hasAnsweredCurrentRound = false;

    function getActiveQuizRounds() {
      return currentDialect === 'north' ? QUIZ_ROUNDS_NORTH : QUIZ_ROUNDS_SOUTH;
    }

    function setDialect(d) {
      currentDialect = d;
      currentRoundIndex = 0;
      score = 0;
      document.getElementById('quizScore').innerText = 0;

      document.getElementById('btn-north').className = d === 'north' ? 'px-4 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs sm:text-sm transition shadow-xs cursor-pointer' : 'px-4 py-2.5 rounded-xl text-stone-500 hover:text-slate-900 font-bold text-xs sm:text-sm transition cursor-pointer';
      document.getElementById('btn-south').className = d === 'south' ? 'px-4 py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs sm:text-sm transition shadow-xs cursor-pointer' : 'px-4 py-2.5 rounded-xl text-stone-500 hover:text-slate-900 font-bold text-xs sm:text-sm transition cursor-pointer';

      // Cập nhật tên type (Flat, Up, Down...) cho tất cả các thẻ Tone
      const typeBadges = {
        ngang: 'Flat',
        sac:   'Up',
        huyen: 'Down',
        hoi:   'Question Mark',
        nga:   'Wave',
        nang:  'Dot'
      };

      const toneNames = {
        ngang: 'Ngang',
        sac:   'Sắc',
        huyen: 'Huyền',
        hoi:   'Hỏi',
        nga:   'Ngã',
        nang:  'Nặng'
      };

      ['ngang', 'sac', 'huyen', 'hoi', 'nga', 'nang'].forEach(id => {
        const badge = document.getElementById(`tone-badge-${id}`);
        if (badge) {
          badge.innerText = `${toneNames[id]} • ${typeBadges[id]}`;
        }
      });

      // Xử lý riêng đồ thị và mô tả cho Tone 5 (Ngã - giữ tên Ngã nhưng đồ thị giống Hỏi) và Tone 6 (Nặng) ở miền Nam
      const ngaGraph = document.querySelector('#svg-graph-nga .tone-path');
      const ngaMechanic = document.getElementById('tone-mechanic-nga');

      const nangMechanic = document.getElementById('tone-mechanic-nang');

      if (d === 'south') {
        if (ngaGraph) ngaGraph.setAttribute('d', 'M 10,18 Q 60,44 110,20'); // Đồ thị dạng dấu Hỏi
        if (ngaMechanic) ngaMechanic.innerText = 'Dip deep into low pitch, then scoop upward with a questioning curve: "Reaaally?".';

        if (nangMechanic) nangMechanic.innerText = 'Drop pitch immediately to the bottom and cut airflow dead short, but held slightly longer than in Northern accent.';
      } else {
        if (ngaGraph) ngaGraph.setAttribute('d', 'M 10,28 L 50,32 M 70,24 L 110,10'); // Miền Bắc chuẩn (Wave)
        if (ngaMechanic) ngaMechanic.innerText = 'High rising pitch broken midway by a brief throat stop before rising: "Uh-oh!".';

        if (nangMechanic) nangMechanic.innerText = 'Drop pitch immediately to the bottom and cut airflow dead short, like a blunt "Yup!".';
      }

      document.getElementById('quizSummaryArea').classList.add('hidden');
      document.getElementById('quizPlayArea').classList.remove('hidden');
      renderCurrentQuestion();
    }

    // --- SETUP AUDIO CHO CARDS VÀ PRACTICE ---
    const northAudio = new Audio('/audio/tones/ma-all.m4a');
    const southAudio = new Audio('/audio/tones/ma-south.m4a');
    const practiceNorthAudio = new Audio('/audio/tones/practice - north.m4a');
    const practiceSouthAudio = new Audio('/audio/tones/practice - south.m4a');

    const cardTimestamps = {
      ngang: { start: 0.6, end: 1.4 },
      sac:   { start: 1.9, end: 2.7 },
      huyen: { start: 2.9, end: 3.7 },
      hoi:   { start: 4.6, end: 5.4 },
      nga:   { start: 5.9, end: 6.7 },
      nang:  { start: 7.2, end: 8.0 }
    };

    // Mốc 6 câu miền Bắc (practice - north.m4a)
    const practiceNorthTimestamps = [
      { start: 0.6, end: 1.2 }, // cá
      { start: 2.1, end: 2.8 }, // sữa
      { start: 3.6, end: 4.3 }, // phở
      { start: 4.9, end: 5.5 }, // lạ
      { start: 6.2, end: 6.9 }, // to
      { start: 7.5, end: 8.2 }  // gà
    ];

    // Mốc 5 câu miền Nam (practice - south.m4a)
    const practiceSouthTimestamps = [
      { start: 0.9, end: 1.5 }, // cá
      { start: 2.5, end: 3.1 }, // phở
      { start: 3.9, end: 4.5 }, // lạ
      { start: 5.1, end: 5.7 }, // to
      { start: 6.1, end: 6.8 }  // gà
    ];

    function playTone(toneKey) {
      northAudio.pause();
      southAudio.pause();
      practiceNorthAudio.pause();
      practiceSouthAudio.pause();

      let activeAudio = northAudio;
      let range = cardTimestamps[toneKey];

      if (currentDialect === 'north') {
        if (toneKey === 'huyen') {
          activeAudio = southAudio;
          range = { start: 2.9, end: 3.7 };
        }
      } else {
        if (toneKey === 'huyen' || toneKey === 'nang') {
          activeAudio = southAudio;
        }
      }
      
      if (!range) return;

      activeAudio.currentTime = range.start;
      activeAudio.play().catch(err => console.log("Audio play error:", err));

      const checkTime = () => {
        if (activeAudio.currentTime >= range.end) {
          activeAudio.pause();
          activeAudio.removeEventListener('timeupdate', checkTime);
        }
      };
      
      activeAudio.addEventListener('timeupdate', checkTime);
    }

    function playCurrentQuestionAudio() {
      northAudio.pause();
      southAudio.pause();
      practiceNorthAudio.pause();
      practiceSouthAudio.pause();

      let activeAudio;
      let range;

      if (currentDialect === 'north') {
        activeAudio = practiceNorthAudio;
        range = practiceNorthTimestamps[currentRoundIndex];
      } else {
        activeAudio = practiceSouthAudio;
        range = practiceSouthTimestamps[currentRoundIndex];
      }

      if (!range) return;

      activeAudio.currentTime = range.start;
      activeAudio.play().catch(err => console.log("Audio play error:", err));

      const checkTime = () => {
        if (activeAudio.currentTime >= range.end) {
          activeAudio.pause();
          activeAudio.removeEventListener('timeupdate', checkTime);
        }
      };

      activeAudio.addEventListener('timeupdate', checkTime);
      document.getElementById('quizBtnText').innerText = 'Listen Again ↺';
    }

    function renderCurrentQuestion() {
      hasAnsweredCurrentRound = false;
      const rounds = getActiveQuizRounds();
      const roundData = rounds[currentRoundIndex];
      const totalRounds = rounds.length;

      document.getElementById('quizRound').innerText = `${currentRoundIndex + 1} / ${totalRounds}`;
      document.getElementById('practiceSubtitle').innerText = `Practice • ${totalRounds} Questions`;
      document.getElementById('quizBtnText').innerText = 'Listen Audio';
      document.getElementById('quizPromptHint').innerText = 'Click to play sound, then pick the right choice below.';
      document.getElementById('quizFeedback').classList.add('hidden');
      document.getElementById('nextButtonArea').classList.add('hidden');

      const container = document.getElementById('quizChoicesGrid');
      container.innerHTML = '';

      roundData.choices.forEach((choice, idx) => {
        const btn = document.createElement('button');
        btn.className = 'quiz-opt-btn p-5 rounded-2xl border border-stone-200/90 hover:border-slate-800 bg-[#fffaf6] text-center transition active:scale-95 group shadow-2xs cursor-pointer';
        btn.innerHTML = `
          <span class="block text-3xl sm:text-4xl font-black font-tone text-slate-900 group-hover:text-red-600 transition-colors leading-tight">${choice.word}</span>
        `;
        btn.onclick = () => selectAnswer(idx, btn);
        container.appendChild(btn);
      });
    }

    function selectAnswer(selectedIndex, btnEl) {
      if (hasAnsweredCurrentRound) return;
      hasAnsweredCurrentRound = true;

      const rounds = getActiveQuizRounds();
      const roundData = rounds[currentRoundIndex];
      const correctObj = roundData.choices[roundData.correctIndex];
      const selectedObj = roundData.choices[selectedIndex];

      const fb = document.getElementById('quizFeedback');
      fb.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-900', 'border-emerald-200', 'bg-red-50', 'text-red-900', 'border-red-200');

      document.querySelectorAll('.quiz-opt-btn').forEach(btn => {
        btn.classList.remove('hover:border-slate-800', 'active:scale-95');
        btn.classList.add('cursor-default');
      });

      if (selectedIndex === roundData.correctIndex) {
        score += 10;
        btnEl.classList.add('border-emerald-500', 'bg-emerald-50');
        fb.classList.add('bg-emerald-50', 'text-emerald-900', 'border', 'border-emerald-200');
        fb.innerHTML = `Correct! The word was <strong class="font-tone">“${correctObj.word}”</strong>.`;
      } else {
        btnEl.classList.add('border-red-400', 'bg-red-50');
        document.querySelectorAll('.quiz-opt-btn')[roundData.correctIndex].classList.add('border-emerald-500', 'bg-emerald-50');
        fb.classList.add('bg-red-50', 'text-red-900', 'border', 'border-red-200');
        fb.innerHTML = `Not quite! You selected <strong>“${selectedObj.word}”</strong>. The correct word was <strong class="font-tone">“${correctObj.word}”</strong>.`;
      }

      document.getElementById('quizScore').innerText = score;
      document.getElementById('nextButtonArea').classList.remove('hidden');
    }

    function goToNextQuestion() {
      const rounds = getActiveQuizRounds();
      if (currentRoundIndex < rounds.length - 1) {
        currentRoundIndex++;
        renderCurrentQuestion();
      } else {
        document.getElementById('quizPlayArea').classList.add('hidden');
        document.getElementById('quizSummaryArea').classList.remove('hidden');
        const maxScore = rounds.length * 10;
        document.getElementById('quizFinalResultText').innerHTML = 
          `You scored <strong>${score} / ${maxScore} points</strong>! Keep practicing regularly to make Vietnamese tones instinctive.`;
      }
    }

    function restartQuiz() {
      currentRoundIndex = 0;
      score = 0;
      document.getElementById('quizScore').innerText = 0;
      document.getElementById('quizSummaryArea').classList.add('hidden');
      document.getElementById('quizPlayArea').classList.remove('hidden');
      renderCurrentQuestion();
    }

    // Modal Control Script
    const modal = document.getElementById('consultModal');
    const openTriggers = document.querySelectorAll('.open-modal-trigger');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const consultForm = document.getElementById('consultForm');
    const successMessage = document.getElementById('successMessage');
    const btnCloseSuccess = document.getElementById('btnCloseSuccess');

    openTriggers.forEach(btn => {
      if (btn) {
        btn.addEventListener('click', () => {
          modal.classList.remove('hidden');
          consultForm.classList.remove('hidden');
          successMessage.classList.add('hidden');
          if (mobileMenu) mobileMenu.classList.add('hidden');
        });
      }
    });

    const hideModal = () => modal.classList.add('hidden');
    if (closeModalBtn) closeModalBtn.addEventListener('click', hideModal);
    if (btnCloseSuccess) closeModalBtn.addEventListener('click', hideModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) hideModal(); });

    consultForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = {
        name: document.getElementById('cName').value,
        country: document.getElementById('cCountry').value,
        phone: document.getElementById('cPhone').value,
        email: document.getElementById('cEmail').value,
        goals: document.getElementById('cGoals').value,
      };
      console.log("Consultation Booking Submitted:", formData);

      consultForm.classList.add('hidden');
      successMessage.classList.remove('hidden');
      consultForm.reset();
    });

    window.addEventListener('DOMContentLoaded', () => {
      renderCurrentQuestion();
    });
  </script>
</body>
</html>