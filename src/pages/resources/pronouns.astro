---
// src/pages/resources/pronouns.astro - Havie Pronoun Matrix
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pronouns — Havie</title>
  <meta name="description" content="Interactive Vietnamese pronoun matrix calculator. Determine whether to use Anh, Chị, Em, or Cô/Chú based on age and social context." />

  <!-- FAVICON & MOBILE TOUCH ICONS -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Inter & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #fffaf5;
      --navy: #0f172a;
      --brand-red: #dc2626;
      --orange: #ef7218;
    }

    html {
      scroll-padding-top: 85px;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--cream);
      color: var(--navy);
    }

    .font-brand {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .curved-underline {
      position: relative;
    }
    .curved-underline::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 100%;
      height: 6px;
      border-bottom: 3px solid var(--orange);
      border-radius: 50%;
      transform: rotate(-1.5deg);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-red-600 selection:text-white relative overflow-x-hidden">

  <!-- BACKGROUND GLOW -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute top-0 right-[15%] w-[450px] h-[450px] bg-gradient-to-br from-amber-400/20 via-red-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute top-40 left-[10%] w-[380px] h-[380px] bg-gradient-to-tr from-amber-200/30 to-transparent rounded-full blur-3xl"></div>
  </div>

  <!-- NAVBAR -->
  <header class="sticky top-0 z-40 bg-[#fffaf5]/90 backdrop-blur-md border-b border-stone-200/80 h-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 h-full flex items-center justify-between">
      
      <!-- LOGO -->
      <a href="/" class="group flex flex-col select-none text-left">
        <div class="h-6 sm:h-7 flex items-center">
          <svg class="h-6 sm:h-7 w-auto overflow-visible" viewBox="0 0 175 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 2H6V12H18V2H24V28H18V17H6V28H0V2Z" fill="#dc2626"/>
            <path d="M41 2L52 28H45.5L43.2 22H33.8L31.5 28H25L36 2H41ZM38.5 8.5L35.2 17.5H41.8L38.5 8.5Z" fill="#dc2626"/>
            <path d="M53 2H59.5L67 21L74.5 2H81L70.5 28H63.5L53 2Z" fill="#dc2626"/>
            <path d="M86 2H92V28H86V2Z" fill="#dc2626"/>
            <path d="M98 2H117V7.5H104V12H115V17H104V22.5H117V28H98V2Z" fill="#dc2626"/>
          </svg>
        </div>
        <span class="text-[9px] sm:text-[9.5px] font-bold tracking-[0.2em] sm:tracking-[0.24em] text-stone-400 uppercase mt-1 pl-0.5 leading-none">
          Learn Vietnamese Online
        </span>
      </a>

      <!-- Desktop Menu Links -->
      <nav class="hidden md:flex items-center space-x-6 lg:space-x-7 text-sm font-semibold text-slate-700">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/#reviews" class="hover:text-red-600 transition">Student Stories</a>
        <a href="/resources" class="text-red-600 font-bold transition">Resources</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        <a href="/#faq" class="hover:text-red-600 transition">FAQ</a>
      </nav>

      <!-- Desktop CTA & Mobile Toggle Button -->
      <div class="flex items-center gap-3">
        <button
          type="button"
          class="open-modal-trigger hidden sm:inline-flex items-center justify-center px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-lg shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>

        <!-- Mobile Menu Hamburger Button -->
        <button 
          id="mobileMenuBtn" 
          type="button" 
          aria-label="Toggle Menu"
          class="md:hidden w-10 h-10 rounded-xl bg-stone-100 hover:bg-stone-200 text-slate-800 flex items-center justify-center font-bold transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobileMenu" class="hidden md:hidden absolute top-20 left-0 w-full bg-[#fffaf5] border-b border-stone-200 shadow-xl px-6 py-5 space-y-4 font-semibold text-slate-700 text-sm">
      <a href="/#about" class="mobile-link block hover:text-red-600 transition">About Me</a>
      <a href="/#curriculum" class="mobile-link block hover:text-red-600 transition">Learning Tracks</a>
      <a href="/#reviews" class="mobile-link block hover:text-red-600 transition">Student Stories</a>
      <a href="/resources" class="mobile-link block text-red-600 font-bold">Resources</a>
      <a href="/test" class="mobile-link block hover:text-red-600 transition">Level Test</a>
      <a href="/#faq" class="mobile-link block hover:text-red-600 transition">FAQ</a>
      <div class="pt-3 border-t border-stone-200">
        <button
          type="button"
          class="open-modal-trigger w-full py-3 text-xs font-bold text-white bg-red-600 rounded-xl text-center shadow-md cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>
    </div>
  </header>

  <main class="flex-grow py-10 lg:py-14">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-12">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
        <span class="text-xs font-extrabold text-red-600 uppercase tracking-widest bg-red-50 px-4 py-1.5 rounded-full border border-red-200 inline-block shadow-2xs">
          Pronoun Matrix
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 mt-3 tracking-tight font-brand">
          Vietnamese <span class="curved-underline text-red-600">Pronoun Calculator.</span>
        </h1>
        <p class="text-stone-600 text-sm sm:text-base mt-4 leading-relaxed max-w-xl mx-auto">
          Avoid default translation words like <em class="text-slate-900 font-semibold">Tôi / Bạn</em> in daily speech. Proper relational honorifics build instant emotional connection and cultural warmth.
        </p>
      </div>

      <!-- Main Tool Box -->
      <div class="bg-white rounded-3xl p-6 sm:p-10 lg:p-12 shadow-md border border-stone-200/90 relative space-y-8">
        
        <!-- STEP 1: SOCIAL CONTEXT -->
        <div class="pb-8 border-b border-stone-100">
          <label class="block text-xs font-bold uppercase tracking-wider text-stone-400 mb-3">
            Step 1: Choose Your Social Setting
          </label>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <button 
              type="button" 
              data-context-btn="street"
              class="context-card active p-5 rounded-2xl border text-left transition cursor-pointer border-red-600 bg-red-50/60 shadow-2xs flex flex-col justify-between"
            >
              <div>
                <span class="block text-lg mb-1.5">☕</span>
                <span class="block text-sm sm:text-base font-extrabold text-slate-900 leading-snug">Casual / Street / Cafe</span>
              </div>
              <span class="block text-xs sm:text-sm text-stone-500 mt-2 font-medium">Cafes, restaurants, street vendors, peers</span>
            </button>
            <button 
              type="button" 
              data-context-btn="work"
              class="context-card p-5 rounded-2xl border text-left transition cursor-pointer border-stone-200 bg-white hover:border-stone-300 flex flex-col justify-between"
            >
              <div>
                <span class="block text-lg mb-1.5">💼</span>
                <span class="block text-sm sm:text-base font-extrabold text-slate-800 leading-snug">Workplace / Professional</span>
              </div>
              <span class="block text-xs sm:text-sm text-stone-500 mt-2 font-medium">Colleagues, managers, meetings</span>
            </button>
            <button 
              type="button" 
              data-context-btn="family"
              class="context-card p-5 rounded-2xl border text-left transition cursor-pointer border-stone-200 bg-white hover:border-stone-300 flex flex-col justify-between"
            >
              <div>
                <span class="block text-lg mb-1.5">🏡</span>
                <span class="block text-sm sm:text-base font-extrabold text-slate-800 leading-snug">Partner’s Family (In-Laws)</span>
              </div>
              <span class="block text-xs sm:text-sm text-stone-500 mt-2 font-medium">Complex family trees & relatives</span>
            </button>
          </div>
        </div>

        <!-- STEP 2: CALCULATOR INTERACTIVE AREA -->
        <div id="calculatorInteractiveArea" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
          
          <!-- Controls Column -->
          <div class="lg:col-span-5 flex flex-col justify-between space-y-6 lg:border-r lg:border-stone-100 lg:pr-8 bg-stone-50/40 p-6 rounded-3xl border border-stone-200/80">
            
            <div class="text-xs font-bold uppercase tracking-wider text-stone-400">
              Step 2: Set Ages & Genders
            </div>

            <!-- Speaker Profile -->
            <div class="space-y-3.5">
              <div class="flex items-center justify-between text-sm font-bold text-slate-900">
                <span class="whitespace-nowrap">Your Age <span class="text-stone-400 font-normal text-xs">(Speaker)</span></span>
                <span id="ageDisplay" class="px-3 py-1 rounded-xl bg-red-50 text-red-600 font-mono text-sm font-extrabold border border-red-100 shadow-2xs min-w-[85px] text-center whitespace-nowrap">28 yrs</span>
              </div>
              <input 
                id="userAge" 
                type="range" 
                min="10" 
                max="85" 
                value="28" 
                class="w-full accent-red-600 h-2.5 bg-stone-200/70 rounded-lg cursor-pointer"
              />
              
              <div class="pt-1">
                <span class="block text-xs font-bold text-slate-800 mb-2">Your Gender</span>
                <div class="grid grid-cols-2 gap-3">
                  <button 
                    type="button" 
                    data-my-gender="male"
                    class="my-gender-btn active px-4 py-3 rounded-xl border text-sm font-bold text-center transition flex items-center justify-center gap-2 border-red-600 bg-red-50 text-red-600 cursor-pointer shadow-2xs"
                  >
                    <span>👨 Male</span>
                  </button>
                  <button 
                    type="button" 
                    data-my-gender="female"
                    class="my-gender-btn px-4 py-3 rounded-xl border text-sm font-bold text-center transition flex items-center justify-center gap-2 border-stone-200 bg-white text-stone-600 hover:border-stone-300 cursor-pointer"
                  >
                    <span>👩 Female</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Listener Profile -->
            <div class="space-y-3.5 pt-4 border-t border-stone-200/60">
              <div class="flex items-center justify-between text-sm font-bold text-slate-900">
                <span class="whitespace-nowrap">Their Age <span class="text-stone-400 font-normal text-xs">(Listener)</span></span>
                <span id="theirAgeDisplay" class="px-3 py-1 rounded-xl bg-slate-100 text-slate-800 font-mono text-sm font-extrabold border border-stone-200 shadow-2xs min-w-[85px] text-center whitespace-nowrap">35 yrs</span>
              </div>
              <input 
                id="theirAge" 
                type="range" 
                min="5" 
                max="85" 
                value="35" 
                class="w-full accent-slate-800 h-2.5 bg-stone-200/70 rounded-lg cursor-pointer"
              />

              <div class="pt-1">
                <span class="block text-xs font-bold text-slate-800 mb-2">Their Gender</span>
                <div class="grid grid-cols-2 gap-3">
                  <button 
                    type="button" 
                    data-their-gender="male"
                    class="their-gender-btn active px-4 py-3 rounded-xl border text-sm font-bold text-center transition flex items-center justify-center gap-2 border-slate-900 bg-slate-100 text-slate-900 cursor-pointer shadow-2xs"
                  >
                    <span>👨 Male</span>
                  </button>
                  <button 
                    type="button" 
                    data-their-gender="female"
                    class="their-gender-btn px-4 py-3 rounded-xl border text-sm font-bold text-center transition flex items-center justify-center gap-2 border-stone-200 bg-white text-stone-600 hover:border-stone-300 cursor-pointer"
                  >
                    <span>👩 Female</span>
                  </button>
                </div>
              </div>
            </div>

          </div>

          <!-- Result Column (Đã khôi phục lại cấu trúc nguyên bản hiển thị giải thích bằng lời cho từng trường hợp) -->
          <div id="calculatorResultCol" class="lg:col-span-7 flex flex-col justify-between space-y-6 bg-stone-50/60 p-6 sm:p-8 rounded-3xl border border-stone-200/80">
            <div class="space-y-5">
              <div class="flex items-center justify-between pb-3 border-b border-stone-200/60">
                <span class="text-xs font-extrabold uppercase tracking-widest text-stone-500">Recommended Pronoun Pair</span>
              </div>

              <!-- Pair Display Grid -->
              <div class="grid grid-cols-2 gap-5 items-stretch pt-2">
                <!-- Self -->
                <div class="p-6 sm:p-8 rounded-2xl bg-white border border-stone-200/90 text-center flex flex-col justify-center shadow-xs">
                  <span class="text-[11px] uppercase font-extrabold tracking-wider text-stone-400 block mb-3">
                    I Call Myself ("I")
                  </span>
                  <span id="selfPronoun" class="text-3xl sm:text-4xl lg:text-5xl font-black font-brand text-slate-900 block break-words tracking-tight">
                    Em
                  </span>
                </div>

                <!-- Them -->
                <div class="p-6 sm:p-8 rounded-2xl bg-red-50 border border-red-200 text-center flex flex-col justify-center shadow-xs">
                  <span class="text-[11px] uppercase font-extrabold tracking-wider text-red-600/80 block mb-3">
                    I Address Them ("You")
                  </span>
                  <span id="themPronoun" class="text-3xl sm:text-4xl lg:text-5xl font-black font-brand text-red-600 block break-words tracking-tight">
                    Anh
                  </span>
                </div>
              </div>
            </div>

            <!-- Context Tip -->
            <div class="bg-white rounded-2xl p-4.5 sm:p-5 border border-stone-200/90 flex items-start gap-3.5 shadow-2xs">
              <span class="text-xl shrink-0 mt-0.5">💡</span>
              <p id="pairExplanation" class="text-xs sm:text-sm text-stone-700 leading-relaxed font-medium">
                In casual social settings, whether they are slightly older or the exact same age, out of polite respect you call yourself <strong>Em</strong> and address them as <strong>Anh / Chị</strong>.
              </p>
            </div>
          </div>

          <!-- Family Course Banner -->
          <div id="familyCourseBanner" class="hidden lg:col-span-12 bg-gradient-to-r from-red-50 via-amber-50/40 to-white rounded-3xl p-8 sm:p-12 border border-red-200/80 text-center space-y-4 shadow-sm">
            <span class="text-xs font-black text-red-600 uppercase tracking-widest bg-white px-4 py-1.5 rounded-full border border-red-200 inline-block shadow-2xs">
              🏡 In-Law Family Tree Masterclass
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-brand">
              Navigating Vietnamese Family Titles is Complex!
            </h3>
            <p class="text-stone-600 text-xs sm:text-base max-w-2xl mx-auto leading-relaxed">
              Family trees in Vietnam involve intricate generational ranks, maternal/paternal distinctions (bên nội/bên ngoại), and regional nuances. Don't guess—master it step-by-step with expert lessons.
            </p>
            <div class="pt-2">
              <button
                type="button"
                class="open-modal-trigger px-8 py-3.5 bg-red-600 hover:bg-red-700 text-white font-black rounded-2xl text-xs sm:text-sm shadow-md transition hover:-translate-y-0.5 cursor-pointer inline-flex items-center gap-2"
              >
                <span>Book Lessons to Master Family Tree</span>
                <span>→</span>
              </button>
            </div>
          </div>

        </div>

      </div>

      <!-- REFINED CTA SECTION -->
      <div class="mt-12 rounded-3xl bg-white p-8 sm:p-10 border border-stone-200/90 shadow-md flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left max-w-xl">
          <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-red-50 text-red-600 text-xs font-bold tracking-wide border border-red-100">
            <span>🎯 1-on-1 Pronoun & Nuance Mastery</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight font-brand">
            Speak Vietnamese the Way People Actually Do
          </h2>
          <p class="text-stone-600 text-xs sm:text-sm leading-relaxed">
            Vietnamese pronouns change depending on age, gender, relationship, and situation. Learn how to choose the right words — and when to switch them — through real-life conversations and 1-on-1 practice.
          </p>
        </div>
        <div class="shrink-0 w-full md:w-auto text-center">
          <button
            type="button"
            class="open-modal-trigger inline-flex items-center justify-center px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-bold rounded-2xl text-sm shadow-md transition hover:-translate-y-0.5 cursor-pointer whitespace-nowrap"
          >
            Book a Trial Lesson →
          </button>
        </div>
      </div>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="bg-[#fffaf5] text-stone-600 py-8 text-xs border-t border-stone-200/80">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex items-center justify-center gap-2.5">
        <span class="font-brand font-black text-slate-900 tracking-widest text-sm">HAVIE.</span>
        <span class="text-stone-400">•</span>
        <span class="font-medium">Learn Vietnamese with Hang</span>
      </div>
      <div class="flex items-center gap-4 sm:gap-6 font-semibold text-stone-700 flex-wrap justify-center">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/#reviews" class="hover:text-red-600 transition">Student Stories</a>
        <a href="/resources" class="text-red-600 transition font-bold">Resources</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        <button type="button" class="open-modal-trigger text-red-600 font-bold hover:underline cursor-pointer">Book Trial</button>
      </div>
    </div>
  </footer>

  <!-- CONSULTATION / BOOKING MODAL -->
  <div id="consultModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-stone-200 space-y-5 text-left">
      
      <div class="flex items-center justify-between border-b border-stone-100 pb-3">
        <div>
          <span class="text-[10px] font-black text-red-600 uppercase tracking-widest bg-red-50 px-2.5 py-0.5 rounded border border-red-200">1-on-1 Coaching</span>
          <h3 class="text-xl font-black text-slate-900 font-brand mt-1">Book Trial Lessons</h3>
        </div>
        <button id="closeModalBtn" type="button" class="w-8 h-8 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-600 font-bold flex items-center justify-center cursor-pointer">
          ✕
        </button>
      </div>

      <form id="consultForm" class="space-y-3.5 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Full Name / Tên của bạn *</label>
          <input type="text" id="cName" required placeholder="e.g. Alex Smith" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Country / Quốc gia *</label>
            <input type="text" id="cCountry" required placeholder="e.g. Germany, USA" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Phone / SĐT</label>
            <input type="tel" id="cPhone" placeholder="e.g. +49..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Email Address *</label>
          <input type="email" id="cEmail" required placeholder="name@example.com" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Learning Goals / Mục tiêu học tập *</label>
          <textarea id="cGoals" rows="3" required placeholder="Current level, target dialect (Hanoi/Saigon), goals..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 focus:outline-none focus:border-red-500 bg-stone-50/50 resize-none"></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3.5 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-xs sm:text-sm shadow-md transition cursor-pointer mt-2"
        >
          Submit Request to Hang →
        </button>
      </form>

      <div id="successMessage" class="hidden text-center py-6 space-y-3">
        <div class="text-3xl">🎉</div>
        <h4 class="font-black text-slate-900 text-base font-brand">Request Sent Successfully!</h4>
        <p class="text-stone-600 text-xs leading-relaxed">Thank you! Hang has received your details and goals. She will reach out via email within 24 hours.</p>
        <button id="btnCloseSuccess" type="button" class="px-6 py-2.5 bg-slate-900 text-white font-bold rounded-xl text-xs cursor-pointer">
          Close Window
        </button>
      </div>

    </div>
  </div>

  <!-- SCRIPTS -->
  <script is:inline>
    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
      });
    }

    let myGender = 'male';
    let theirGender = 'male';
    let currentContext = 'street';

    const userAgeInput = document.getElementById('userAge');
    const ageDisplay = document.getElementById('ageDisplay');
    const theirAgeInput = document.getElementById('theirAge');
    const theirAgeDisplay = document.getElementById('theirAgeDisplay');

    const selfPronounEl = document.getElementById('selfPronoun');
    const themPronounEl = document.getElementById('themPronoun');
    const pairExplanationEl = document.getElementById('pairExplanation');

    const controlsCol = document.getElementById('calculatorInteractiveArea').children[0];
    const resultCol = document.getElementById('calculatorResultCol');
    const familyBanner = document.getElementById('familyCourseBanner');

    // 1. Social Context Filter Buttons
    document.querySelectorAll('[data-context-btn]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-context-btn]').forEach(b => {
          b.classList.remove('active', 'border-red-600', 'bg-red-50/60');
          b.classList.add('border-stone-200', 'bg-white');
        });
        btn.classList.add('active', 'border-red-600', 'bg-red-50/60');
        btn.classList.remove('border-stone-200', 'bg-white');
        currentContext = btn.getAttribute('data-context-btn');

        if (currentContext === 'family') {
          controlsCol.classList.add('hidden');
          resultCol.classList.add('hidden');
          familyBanner.classList.remove('hidden');
        } else {
          controlsCol.classList.remove('hidden');
          resultCol.classList.remove('hidden');
          familyBanner.classList.add('hidden');
          calculatePronouns();
        }
      });
    });

    // 2. My Gender buttons
    document.querySelectorAll('.my-gender-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.my-gender-btn').forEach(b => {
          b.classList.remove('active', 'border-red-600', 'bg-red-50', 'text-red-600');
          b.classList.add('border-stone-200', 'bg-white', 'text-stone-600');
        });
        btn.classList.add('active', 'border-red-600', 'bg-red-50', 'text-red-600');
        btn.classList.remove('border-stone-200', 'bg-white', 'text-stone-600');
        myGender = btn.getAttribute('data-my-gender');
        calculatePronouns();
      });
    });

    // 3. Their Gender buttons
    document.querySelectorAll('.their-gender-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.their-gender-btn').forEach(b => {
          b.classList.remove('active', 'border-slate-900', 'bg-slate-100', 'text-slate-900');
          b.classList.add('border-stone-200', 'bg-white', 'text-stone-600');
        });
        btn.classList.add('active', 'border-slate-900', 'bg-slate-100', 'text-slate-900');
        btn.classList.remove('border-stone-200', 'bg-white', 'text-stone-600');
        theirGender = btn.getAttribute('data-their-gender');
        calculatePronouns();
      });
    });

    // Sliders Listeners
    if (userAgeInput) {
      userAgeInput.addEventListener('input', (e) => {
        ageDisplay.textContent = `${e.target.value} yrs`;
        calculatePronouns();
      });
    }

    if (theirAgeInput) {
      theirAgeInput.addEventListener('input', (e) => {
        theirAgeDisplay.textContent = `${e.target.value} yrs`;
        calculatePronouns();
      });
    }

    // ENGINE TÍNH TOÁN XƯNG HÔ ĐÃ HOÀN THIỆN VÀ KHÓA CHẶT:
    function calculatePronouns() {
      const myAge = parseInt(userAgeInput.value, 10);
      const theirAge = parseInt(theirAgeInput.value, 10);
      const diff = theirAge - myAge; // >0: họ lớn tuổi hơn mình; <0: họ nhỏ tuổi hơn mình; =0: bằng tuổi

      let self = "Em";
      let them = "Anh";
      let explanation = "";

      const conNote = ` Note: "Con" is used naturally across both North and South Vietnam, while "Cháu" is primarily used in the North.`;

      // ==========================================
      // 1. WORKPLACE CONTEXT
      // ==========================================
      if (currentContext === 'work') {
        if ((theirAge >= 70 && diff >= 45) || diff >= 45) {
          self = "Con";
          them = theirGender === 'male' ? "Ông" : "Bà";
          explanation = `For elderly senior figures in a professional setting with a large age gap, address them as <strong>${them}</strong> and call yourself <strong>Con</strong>.${conNote}`;
        } else if (myAge >= 70 && diff <= -45) {
          self = myGender === 'male' ? "Ông" : "Bà";
          them = "Con";
          explanation = `In the workplace, when an elderly senior speaks to a staff member who is younger than you by 45+ years, call yourself <strong>Ông</strong> (or <strong>Bà</strong>) and address them as <strong>Con</strong>.${conNote}`;
        } else if (diff >= 31) {
          self = "Con";
          them = theirGender === 'male' ? "Chú" : "Cô";
          explanation = `In the workplace, if someone is older by 31+ years, professional standards dictate addressing them as <strong>Chú / Cô</strong> and calling yourself <strong>Con</strong>.${conNote}`;
        } else if (diff <= -31) {
          self = myGender === 'male' ? "Chú" : "Cô";
          them = "Con";
          explanation = `In the workplace, when speaking to a junior staff member who is younger than you by 31+ years, call yourself <strong>Chú / Cô</strong> and address them as <strong>Con</strong>.${conNote}`;
        } else {
          if (diff >= 1) {
            self = "Em";
            them = theirGender === 'male' ? "Anh" : "Chị";
            explanation = `In the workplace, for colleagues older than you by up to 30 years, it is standard to call yourself <strong>Em</strong> and address them as <strong>Anh / Chị</strong>.`;
          } else if (diff === 0) {
            self = "Em";
            them = theirGender === 'male' ? "Anh" : "Chị";
            explanation = `When meeting someone of the exact same age in a professional setting, out of polite respect, address them as <strong>Anh / Chị</strong> and call yourself <strong>Em</strong>.`;
          } else {
            self = myGender === 'male' ? "Anh" : "Chị";
            them = "Em";
            explanation = `For younger colleagues within a 30-year age gap, call yourself <strong>Anh / Chị</strong> and address them as <strong>Em</strong> (or call them by name).`;
          }
        }
      }
      // ==========================================
      // 2. CASUAL / STREET CONTEXT
      // ==========================================
      else {
        if (theirAge >= 70 && diff >= 45) {
          self = "Con";
          them = theirGender === 'male' ? "Ông" : "Bà";
          explanation = `For elderly seniors (age 70+ and 45+ years older, like your grandparents), address them as <strong>Ông / Bà</strong> and call yourself <strong>Con</strong>.${conNote}`;
        } 
        else if (myAge >= 70 && diff <= -45) {
          self = myGender === 'male' ? "Ông" : "Bà";
          them = "Con";
          explanation = `When an elderly senior speaks to a much younger person (such as a 45+ year age gap), address them as <strong>Con</strong> and call yourself <strong>Ông</strong> (or <strong>Bà</strong>).${conNote}`;
        }
        else if (diff >= 20) {
          self = "Con";
          them = theirGender === 'male' ? "Chú" : "Cô";
          explanation = `For adults of your parents' age (older by 20–44 years), address them as <strong>Chú</strong> or <strong>Cô</strong> and call yourself <strong>Con</strong>.${conNote}`;
        } 
        else if (myAge >= 50 && diff <= -30) {
          self = myGender === 'male' ? "Ông" : "Bà";
          them = "Con";
          explanation = `When an elderly adult speaks to a young child in casual settings, address them as <strong>Con</strong> and call yourself <strong>Ông</strong> (or <strong>Bà</strong> based on your gender).${conNote}`;
        }
        else if (diff >= 0) {
          self = "Em";
          them = theirGender === 'male' ? "Anh" : "Chị";
          explanation = `In casual social settings, whether they are slightly older or the exact same age, out of polite respect you call yourself <strong>Em</strong> and address them as <strong>Anh / Chị</strong>. (If you become close friends later, you can switch to <em>Bạn / Mình</em> or call each other by name).`;
        } 
        else if (diff > -20) {
          self = myGender === 'male' ? "Anh" : "Chị";
          them = "Em";
          explanation = `For someone younger than you by up to 19 years, call yourself <strong>Anh / Chị</strong> and address them as <strong>Em</strong> (or call them by their name).`;
        } 
        else {
          self = myGender === 'male' ? "Chú" : "Cô";
          them = "Con";
          explanation = `For children or young individuals much younger than you (by 20+ years, like your children), call yourself <strong>Chú / Cô</strong> and address them as <strong>Con</strong> (or by name).${conNote}`;
        }
      }

      selfPronounEl.textContent = self;
      themPronounEl.textContent = them;
      pairExplanationEl.innerHTML = explanation;
    }

    // Run initial calculation
    calculatePronouns();
  </script>
</body>
</html>