    function initSandboxMenus() {
      Object.keys(sandboxVocab).forEach(key => {
        const menuEl = document.getElementById(`menu-${key}`);
        if (!menuEl) return;
        menuEl.innerHTML = '';

        sandboxVocab[key].forEach((item, index) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'w-full text-left px-3 py-2 rounded-xl text-xs font-semibold hover:bg-stone-100 transition flex items-center justify-between text-slate-800 cursor-pointer';
          btn.innerHTML = `<span>${item.label}</span>`;

          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            currentSandbox[key] = index;
            closeAllMenus();
            updateSandboxDisplay();
          });

          menuEl.appendChild(btn);
        });
      });
    }

    document.querySelectorAll('.block-trigger-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const blockName = btn.getAttribute('data-block');
        const targetMenu = document.getElementById(`menu-${blockName}`);
        const isAlreadyOpen = !targetMenu.classList.contains('hidden');
        closeAllMenus();
        if (!isAlreadyOpen) {
          targetMenu.classList.remove('hidden');
        }
      });
    });

    function closeAllMenus() {
      document.querySelectorAll('.block-menu').forEach(m => m.classList.add('hidden'));
    }
