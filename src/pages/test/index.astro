---
// src/pages/test/index.astro - Official Vietnamese Proficiency Placement Test (A1 - C2)
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vietnamese Proficiency Placement Test — HAVIE</title>
  <meta name="description" content="Take our comprehensive Vietnamese level test with Northern and Southern dialect tracks, audio tone discrimination, and real-time feedback." />

  <!-- CANONICAL URL -->
  <link rel="canonical" href="https://havielearn.com/test" />

  <!-- FAVICON NHÚNG TRỰC TIẾP -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 512 512%22><rect width=%22512%22 height=%22512%22 rx=%22110%22 fill=%22%23dc2626%22/><path d=%22M136 116h68v110h104V116h68v280h-68V290H204v106h-68V116z%22 fill=%22%23ffffff%22/></svg>" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: DM Sans & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #fffaf5;
      --navy: #0f172a;
      --brand-red: #dc2626;
    }
    html {
      scroll-padding-top: 100px;
    }
    body {
      font-family: 'DM Sans', sans-serif;
      background-color: var(--cream);
      color: var(--navy);
    }
    .font-brand {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .hero-glow {
      background: radial-gradient(circle, rgba(220, 38, 38, 0.12) 0%, rgba(245, 158, 11, 0.06) 50%, transparent 80%);
    }
  </style>
</head>
<body class="selection:bg-red-600 selection:text-white min-h-screen flex flex-col antialiased relative overflow-x-hidden">

  <!-- NAVBAR -->
  <header class="sticky top-0 z-40 bg-[#fffaf5]/90 backdrop-blur-md border-b border-stone-200/80 h-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 h-full flex items-center justify-between">
      
      <!-- LOGO BÊN TRÁI -->
      <a href="/" class="group flex flex-col select-none text-left shrink-0">
        <div class="h-7 sm:h-8 flex items-center">
          <svg class="h-7 sm:h-8 w-auto overflow-visible" viewBox="0 0 175 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 2H6V12H18V2H24V28H18V17H6V28H0V2Z" fill="#dc2626"/>
            <path d="M41 2L52 28H45.5L43.2 22H33.8L31.5 28H25L36 2H41ZM38.5 8.5L35.2 17.5H41.8L38.5 8.5Z" fill="#dc2626"/>
            <path d="M53 2H59.5L67 21L74.5 2H81L70.5 28H63.5L53 2Z" fill="#dc2626"/>
            <path d="M86 2H92V28H86V2Z" fill="#dc2626"/>
            <path d="M98 2H117V7.5H104V12H115V17H104V22.5H117V28H98V2Z" fill="#dc2626"/>
          </svg>
        </div>
        <span class="text-[9.5px] sm:text-[10px] font-bold tracking-[0.22em] sm:tracking-[0.26em] text-stone-400 uppercase mt-1 pl-0.5 leading-none">
          Learn Vietnamese Online
        </span>
      </a>

      <!-- CỤM PHẢI: MENU -->
      <div class="hidden md:flex items-center gap-7 lg:gap-8 ml-auto mr-4">
        <nav class="flex items-center space-x-7 lg:space-x-8 text-base font-bold text-slate-800 tracking-normal font-[inherit]">
          <a href="/#about" class="hover:text-red-600 transition text-base font-bold text-slate-800">About Me</a>
          <a href="/#curriculum" class="hover:text-red-600 transition text-base font-bold text-slate-800">Learning Tracks</a>
          <a href="/resources" class="hover:text-red-600 transition text-base font-bold text-slate-800">Resources</a>
          <a href="/student" class="hover:text-red-600 transition text-base font-bold text-slate-800">Student Portal</a>
          <a href="/test" class="text-red-600 font-bold transition">Level Test</a>
        </nav>
      </div>

      <!-- DESKTOP CTA & MOBILE TOGGLE -->
      <div class="flex items-center gap-3 shrink-0">
        <button
          type="button"
          class="open-modal-trigger hidden sm:inline-flex items-center justify-center px-5 py-3 text-sm font-extrabold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-lg shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>

        <!-- Mobile Menu Hamburger Button -->
        <button 
          id="mobileMenuBtn" 
          type="button" 
          aria-label="Toggle Menu"
          class="md:hidden w-10 h-10 rounded-xl bg-stone-100 hover:bg-stone-200 text-slate-800 flex items-center justify-center font-bold transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobileMenu" class="hidden md:hidden absolute top-20 left-0 w-full bg-[#fffaf5] border-b border-stone-200 shadow-xl px-6 py-5 space-y-4 font-semibold text-slate-800 text-base">
      <a href="/#about" class="mobile-link block hover:text-red-600 transition">About Me</a>
      <a href="/#curriculum" class="mobile-link block hover:text-red-600 transition">Learning Tracks</a>
      <a href="/resources" class="mobile-link block hover:text-red-600 transition">Resources</a>
      <a href="/student" class="mobile-link block hover:text-red-600 transition">Student Portal</a>
      <a href="/test" class="mobile-link block text-red-600 font-bold">Level Test</a>
      <div class="pt-3 border-t border-stone-200">
        <button
          type="button"
          class="open-modal-trigger w-full py-3.5 text-sm font-bold text-white bg-red-600 rounded-xl text-center shadow-md cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>
    </div>
  </header>

  <!-- STICKY SCORE TRACKER -->
  <div class="sticky top-20 z-30 bg-white/95 backdrop-blur-md border-b border-stone-200/90 py-3.5 shadow-xs">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm font-bold text-center sm:text-left">
      <div class="flex flex-wrap items-center justify-center gap-3">
        <span class="text-stone-400 uppercase text-xs tracking-wider font-extrabold">Dialect Track:</span>
        <div class="inline-flex p-1 rounded-xl bg-stone-100 border border-stone-200">
          <button id="btnSelectNorth" type="button" class="px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold bg-slate-900 text-white shadow-xs transition cursor-pointer">
            Northern (Hanoi)
          </button>
          <button id="btnSelectSouth" type="button" class="px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold text-stone-600 hover:text-slate-900 transition cursor-pointer">
            Southern (Saigon)
          </button>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-5 text-stone-700 text-xs sm:text-sm">
        <div>P1: <span id="scoreP1" class="text-red-600 font-mono font-bold">0</span>/20</div>
        <div>P2: <span id="scoreP2" class="text-red-600 font-mono font-bold">0</span>/20</div>
        <div>P3: <span id="scoreP3" class="text-red-600 font-mono font-bold">0</span>/20</div>
        <div>P4: <span id="scoreP4" class="text-red-600 font-mono font-bold">0</span>/20</div>
        <div class="pl-2 sm:pl-4 border-l border-stone-300 font-black text-slate-900">
          Auto Total: <span id="scoreTotal" class="text-red-600 font-mono text-base font-black">0</span>/80
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN CONTAINER -->
  <main class="flex-grow py-12 lg:py-16">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 space-y-12">
      
      <!-- HERO INTRO -->
      <div class="text-center max-w-3xl mx-auto space-y-3.5">
        <div class="inline-block bg-red-50 border border-red-200 px-5 py-2 rounded-2xl">
          <span class="text-xs sm:text-sm font-extrabold text-red-600 uppercase tracking-widest">
            Placement Assessment • Comprehensive Test
          </span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight font-brand">
          Vietnamese Proficiency Test
        </h1>
        <p class="text-stone-600 text-sm sm:text-base leading-relaxed pt-1">
          Select your target dialect track above. Complete all parts below, then submit your test at the bottom for instant evaluation.
        </p>
      </div>

      <!-- PART 1: TONES (20 PTS) -->
      <section class="bg-white rounded-3xl p-6 sm:p-12 shadow-lg shadow-stone-200/50 border border-stone-200/90 space-y-8">
        <div class="border-b border-stone-100 pb-5">
          <span class="text-xs font-black uppercase tracking-wider text-red-700 bg-red-50 px-3 py-1.5 rounded-lg border border-red-200">Section 1</span>
          <h2 class="text-2xl font-bold text-slate-900 font-brand mt-2">Part 1: Tones</h2>
          <p class="text-xs sm:text-base text-stone-500 mt-1">Listen to the audio syllable and choose the exact word you hear (20 pts).</p>
        </div>

        <div class="space-y-6" id="containerP1"></div>
      </section>

      <!-- PART 2: QUICK RESPONSES (20 PTS) -->
      <section class="bg-white rounded-3xl p-6 sm:p-12 shadow-lg shadow-stone-200/50 border border-stone-200/90 space-y-8">
        <div class="border-b border-stone-100 pb-5">
          <span class="text-xs font-black uppercase tracking-wider text-red-700 bg-red-50 px-3 py-1.5 rounded-lg border border-red-200">Section 2</span>
          <h2 class="text-2xl font-bold text-slate-900 font-brand mt-2">Part 2: Quick Responses</h2>
          <p class="text-xs sm:text-base text-stone-500 mt-1">Choose the most natural reply to complete each everyday exchange (20 pts).</p>
        </div>

        <div class="space-y-8" id="containerP2"></div>
      </section>

      <!-- PART 3: GRAMMAR & CONTEXT (20 PTS) -->
      <section class="bg-white rounded-3xl p-6 sm:p-12 shadow-lg shadow-stone-200/50 border border-stone-200/90 space-y-8">
        <div class="border-b border-stone-100 pb-5">
          <span class="text-xs font-black uppercase tracking-wider text-red-700 bg-red-50 px-3 py-1.5 rounded-lg border border-red-200">Section 3</span>
          <h2 class="text-2xl font-bold text-slate-900 font-brand mt-2">Part 3: Grammar & Context</h2>
          <p class="text-xs sm:text-base text-stone-500 mt-1">Choose the correct option to complete each sentence (20 pts).</p>
        </div>

        <div class="space-y-8" id="containerP3"></div>
      </section>

      <!-- PART 4: REAL-WORLD READING COMPREHENSION (20 PTS) -->
      <section class="bg-white rounded-3xl p-6 sm:p-12 shadow-lg shadow-stone-200/50 border border-stone-200/90 space-y-8">
        <div class="border-b border-stone-100 pb-5">
          <span class="text-xs font-black uppercase tracking-wider text-red-700 bg-red-50 px-3 py-1.5 rounded-lg border border-red-200">Section 4</span>
          <h2 class="text-2xl font-bold text-slate-900 font-brand mt-2">Part 4: Real-World Reading Comprehension</h2>
          <p class="text-xs sm:text-base text-stone-500 mt-1">Read real contexts and answer questions (20 pts).</p>
        </div>

        <div class="space-y-10" id="containerP4"></div>
      </section>

      <!-- PART 5: SPEAKING -->
      <section class="bg-white rounded-3xl p-6 sm:p-12 shadow-lg shadow-stone-200/50 border border-stone-200/90 space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-stone-100 pb-5">
          <div>
            <span class="text-xs font-black uppercase tracking-wider text-stone-700 bg-stone-100 px-3 py-1.5 rounded-lg border border-stone-200">Section 5</span>
            <h2 class="text-2xl font-bold text-slate-900 font-brand mt-2">Part 5: Speaking</h2>
          </div>
          <span class="text-sm font-bold text-stone-600 italic bg-stone-50 px-3.5 py-1.5 rounded-xl border border-stone-200">Teacher Evaluated</span>
        </div>

        <div class="p-5 sm:p-6 rounded-2xl bg-[#fffaf5] border border-stone-200 text-sm sm:text-base text-stone-700 leading-relaxed shadow-2xs">
          💡 Want direct pronunciation corrections? Prepare your responses below, then book a complimentary 25-minute 1-on-1 session with Hang to get live feedback.
        </div>

        <div class="space-y-6 text-base" id="containerP5"></div>

        <div class="pt-4 text-center">
          <button
            type="button"
            class="open-modal-trigger inline-flex items-center justify-center px-6 sm:px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-2xl text-xs sm:text-base transition shadow-lg shadow-red-600/25 cursor-pointer w-full sm:w-auto"
          >
            🎙️ Book Speaking Evaluation with Hang (Free 25-Min Trial) →
          </button>
        </div>
      </section>

      <!-- SUBMIT TEST BUTTON -->
      <div class="text-center py-8">
        <button
          id="btnFinalSubmit"
          type="button"
          class="w-full sm:w-auto px-10 sm:px-14 py-5 bg-slate-950 hover:bg-slate-900 text-white font-black text-base sm:text-lg rounded-2xl shadow-2xl transition-all hover:-translate-y-1 cursor-pointer"
        >
          🏁 Submit Test & View Placement Summary
        </button>
      </div>

    </div>
  </main>

  <!-- RESULT POPUP MODAL -->
  <div id="resultModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-10 max-w-lg w-full shadow-2xl border border-stone-200 text-center space-y-6">
      
      <div id="modalBadge" class="w-16 h-16 mx-auto rounded-full flex items-center justify-center text-3xl shadow-inner bg-red-100 text-red-600">
        🎯
      </div>

      <div>
        <span class="text-xs font-extrabold uppercase tracking-widest text-stone-400">Diagnostic Placement Result</span>
        <h3 id="modalLevelTitle" class="text-2xl sm:text-3xl font-black text-slate-900 font-brand mt-1">Estimated Level</h3>
        <p id="modalDesc" class="text-sm sm:text-base text-stone-500 mt-2 leading-relaxed">Evaluation message.</p>
      </div>

      <!-- RECOMMENDATION BOX -->
      <div class="bg-[#fffaf5] p-5 rounded-2xl border border-stone-200/80 space-y-3 text-left">
        <div class="text-sm font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
          <span>📚 Recommended Study Plan</span>
        </div>
        <ul id="modalRecList" class="space-y-2 text-xs sm:text-sm text-stone-700 font-medium"></ul>
      </div>

      <div class="bg-white p-4 rounded-xl border border-stone-200 flex items-center justify-between text-sm sm:text-base font-bold text-stone-600 shadow-2xs">
        <span>Auto-Graded Score:</span>
        <span class="text-red-600 font-mono text-lg font-black" id="modalTotal">0/80</span>
      </div>

      <div class="space-y-3 pt-2">
        <button
          type="button"
          class="open-modal-trigger block w-full py-3.5 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-xl text-xs sm:text-sm shadow-lg shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer"
        >
          Schedule Free 25-Min Speaking Evaluation →
        </button>
        <button
          id="btnCloseModal"
          type="button"
          class="block w-full py-3 bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold rounded-xl text-xs sm:text-sm transition cursor-pointer"
        >
          Review My Answers
        </button>
      </div>

    </div>
  </div>

  <!-- CONSULTATION / BOOKING MODAL -->
  <div id="consultModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-stone-200 space-y-6 text-left">
      
      <div class="flex items-center justify-between border-b border-stone-100 pb-4">
        <div>
          <span class="text-xs sm:text-sm font-black text-red-600 uppercase tracking-widest bg-red-50 px-3.5 py-1.5 rounded-lg border border-red-200 inline-block font-brand">1-ON-1 LESSONS</span>
          <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-brand mt-1.5">Book 25-Min Trial Lesson</h3>
        </div>
        <button id="closeConsultModalBtn" type="button" class="w-10 h-10 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold flex items-center justify-center text-lg cursor-pointer">
          ✕
        </button>
      </div>

      <form id="consultForm" class="space-y-4 text-sm">
        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Full Name / Tên của bạn *</label>
          <input type="text" id="cName" required placeholder="e.g. Alex Smith" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-800 mb-1.5 text-base">Country / Quốc gia *</label>
            <input type="text" id="cCountry" required placeholder="e.g. Germany, USA" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
          </div>
          <div>
            <label class="block font-bold text-slate-800 mb-1.5 text-base">Phone / SĐT</label>
            <input type="tel" id="cPhone" placeholder="e.g. +49..." class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Email Address *</label>
          <input type="email" id="cEmail" required placeholder="name@example.com" class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 text-base" />
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1.5 text-base">Learning Goals / Mục tiêu học tập *</label>
          <textarea id="cGoals" rows="3" required placeholder="Current level, target dialect (Hanoi/Saigon), goals..." class="w-full px-4 py-3.5 rounded-xl border border-stone-300 focus:outline-none focus:border-red-500 bg-stone-50/50 resize-none text-base"></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-base shadow-md transition cursor-pointer mt-3"
        >
          Submit Request to Hang →
        </button>
      </form>

      <div id="successMessage" class="hidden text-center py-6 space-y-3">
        <div class="text-4xl">🎉</div>
        <h4 class="font-black text-slate-900 text-lg font-brand">Request Sent Successfully!</h4>
        <p class="text-stone-600 text-sm leading-relaxed">Thank you! Hang has received your details and goals. She will reach out via email within 24 hours.</p>
        <button id="btnCloseSuccess" type="button" class="px-6 py-3 bg-slate-900 text-white font-bold rounded-xl text-sm cursor-pointer">
          Close Window
        </button>
      </div>

    </div>
  </div>

  <!-- FOOTER -->
  <footer class="bg-[#fffaf5] text-stone-600 py-10 border-t border-stone-200/80">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div class="flex items-center justify-center gap-2.5">
        <span class="font-brand font-black text-slate-900 tracking-wider text-base sm:text-lg">HAVIE</span>
        <span class="text-stone-300">•</span>
        <span class="text-xs sm:text-sm font-medium text-stone-500">Learn Vietnamese with Hang</span>
      </div>
      <div class="flex items-center gap-5 sm:gap-7 font-semibold text-xs sm:text-sm text-stone-700 flex-wrap justify-center">
        <a href="/#about" class="hover:text-red-600 transition">About Me</a>
        <a href="/#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/resources" class="hover:text-red-600 transition">Resources</a>
        <a href="/student" class="hover:text-red-600 transition">Student Portal</a>
        <a href="/test" class="text-red-600 font-bold transition">Level Test</a>
        <button type="button" class="open-modal-trigger text-red-600 font-bold hover:underline cursor-pointer">Book Trial</button>
      </div>
    </div>
  </footer>

  <!-- SCRIPT LOGIC -->
  <script is:inline>
    let activeDialect = 'north';

    const testDatabases = {
      north: {
        p1: [
          { id: "n_p1_1", audioText: "ca", soundTarget: "ca", numberLabel: "1.", options: ["ca", "cà", "cá", "cả"], correct: 0 },
          { id: "n_p1_2", audioText: "gió", soundTarget: "gió", numberLabel: "2.", options: ["gio", "gió", "giỏ", "giò"], correct: 1 },
          { id: "n_p1_3", audioText: "má", soundTarget: "má", numberLabel: "3.", options: ["ma", "má", "mả", "mã"], correct: 1 },
          { id: "n_p1_4", audioText: "nặng", soundTarget: "nặng", numberLabel: "4.", options: ["năng", "nẵng", "nẳng", "nặng"], correct: 3 }
        ],
        p2: [
          {
            id: "n_p2_1",
            numberLabel: "1.",
            dialoguePrompt: "Cháu đi đâu đấy?",
            options: [
              "Cháu đi chợ ạ.",
              "Cháu đi một mình.",
              "Không có gì đâu cô.",
              "Tôi đang đi bộ."
            ],
            correct: 0
          },
          {
            id: "n_p2_2",
            numberLabel: "2.",
            dialoguePrompt: "Anh uống nâu đá nhiều đường hay ít đường ạ?",
            options: [
              "Cho anh cốc trà nóng nhé.",
              "Cho anh ít đường thôi nhé.",
              "Cà phê ngọt lắm em ơi.",
              "Anh chưa uống bao giờ đâu."
            ],
            correct: 1
          },
          {
            id: "n_p2_3",
            numberLabel: "3.",
            dialoguePrompt: "Anh ơi, anh đứng ở chỗ nào toà nhà đấy?",
