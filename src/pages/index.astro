---
// src/pages/index.astro - Havie Landing Page
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Havie | Learn Vietnamese Online</title>
  <meta name="description" content="Personalized 1-on-1 online Vietnamese lessons with Hang Luu. Real conversations, pronunciation mastery, and cultural depth." />

  <!-- FAVICON & MOBILE TOUCH ICONS -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: DM Sans & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --cream: #fffaf5;
      --navy: #0f172a;
      --brand-red: #dc2626;
    }

    html {
      scroll-padding-top: 85px;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background-color: var(--cream);
      color: var(--navy);
    }

    .font-brand {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .curved-underline {
      position: relative;
    }
    .curved-underline::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 100%;
      height: 6px;
      border-bottom: 3px solid var(--brand-red);
      border-radius: 50%;
      transform: rotate(-1.5deg);
    }

    .hero-glow {
      background: radial-gradient(circle, rgba(220, 38, 38, 0.12) 0%, rgba(245, 158, 11, 0.06) 50%, transparent 80%);
    }
  </style>
</head>
<body class="selection:bg-red-600 selection:text-white min-h-screen flex flex-col antialiased relative overflow-x-hidden">

  <!-- NAVBAR (Đã mở rộng khung container lên max-w-[1400px] để dịch sát sang trái) -->
  <header class="sticky top-0 z-40 bg-[#fffaf5]/90 backdrop-blur-md border-b border-stone-200/80 h-20">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16 h-full flex items-center justify-between">
      
      <!-- LOGO -->
      <a href="/" class="group flex flex-col select-none text-left shrink-0">
        <div class="h-6 sm:h-7 flex items-center">
          <svg class="h-6 sm:h-7 w-auto overflow-visible" viewBox="0 0 175 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 2H6V12H18V2H24V28H18V17H6V28H0V2Z" fill="#dc2626"/>
            <path d="M41 2L52 28H45.5L43.2 22H33.8L31.5 28H25L36 2H41ZM38.5 8.5L35.2 17.5H41.8L38.5 8.5Z" fill="#dc2626"/>
            <path d="M53 2H59.5L67 21L74.5 2H81L70.5 28H63.5L53 2Z" fill="#dc2626"/>
            <path d="M86 2H92V28H86V2Z" fill="#dc2626"/>
            <path d="M98 2H117V7.5H104V12H115V17H104V22.5H117V28H98V2Z" fill="#dc2626"/>
          </svg>
        </div>
        <span class="text-[9px] sm:text-[9.5px] font-bold tracking-[0.2em] sm:tracking-[0.24em] text-stone-400 uppercase mt-1 pl-0.5 leading-none">
          Learn Vietnamese Online
        </span>
      </a>

      <!-- CỤM ĐIỀU HƯỚNG & NÚT BẤM -->
      <div class="hidden lg:flex items-center space-x-7 text-sm font-semibold text-slate-700">
        <a href="#about" class="hover:text-red-600 transition">About Me</a>
        <a href="#curriculum" class="hover:text-red-600 transition">Learning Tracks</a>
        <a href="/resources" class="hover:text-red-600 transition">Resources</a>
        <a href="/student" class="hover:text-red-600 transition">Student Portal</a>
        <a href="/test" class="hover:text-red-600 transition">Level Test</a>
        
        <div class="flex items-center pl-2">
          <button
            type="button"
            class="open-modal-trigger inline-flex items-center justify-center px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-lg shadow-red-600/25 transition hover:-translate-y-0.5 cursor-pointer"
          >
            Book 25-Min Trial Lesson →
          </button>
        </div>
      </div>

      <!-- Mobile Menu Hamburger Button -->
      <button 
        id="mobileMenuBtn" 
        type="button" 
        aria-label="Toggle Menu"
        class="lg:hidden w-10 h-10 rounded-xl bg-stone-100 hover:bg-stone-200 text-slate-800 flex items-center justify-center font-bold transition cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobileMenu" class="hidden lg:hidden absolute top-20 left-0 w-full bg-[#fffaf5] border-b border-stone-200 shadow-xl px-6 py-5 space-y-3 font-semibold text-slate-700 text-sm">
      <a href="#about" class="mobile-link block hover:text-red-600 transition py-1">About Me</a>
      <a href="#curriculum" class="mobile-link block hover:text-red-600 transition py-1">Learning Tracks</a>
      <a href="/resources" class="mobile-link block hover:text-red-600 transition py-1">Resources</a>
      <a href="/student" class="mobile-link block hover:text-red-600 transition py-1">Student Portal</a>
      <a href="/test" class="mobile-link block hover:text-red-600 transition py-1">Level Test</a>
      <div class="pt-3 border-t border-stone-200">
        <button
          type="button"
          class="open-modal-trigger w-full py-3 text-xs font-bold text-white bg-red-600 rounded-xl text-center shadow-md cursor-pointer"
        >
          Book 25-Min Trial Lesson →
        </button>
      </div>
    </div>
  </header>

  <main class="flex-grow">
    <!-- HERO SECTION -->
    <section class="relative flex items-center overflow-hidden py-12 sm:py-16 lg:py-24 min-h-[calc(100vh-80px)] lg:min-h-[82vh]">
      <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
        <div class="absolute top-5 right-[10%] w-[350px] sm:w-[500px] h-[350px] sm:h-[500px] hero-glow rounded-full blur-3xl"></div>
      </div>

      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16 w-full">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          
          <!-- CỘT BÊN TRÁI -->
          <div class="lg:col-span-7 text-center lg:text-left space-y-5 sm:space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-stone-200/90 text-xs sm:text-sm font-semibold text-slate-800 shadow-2xs">
              <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
              <span>Native Tutor</span>
              <span class="text-stone-300">•</span>
              <span>Northern & Southern Accents</span>
            </div>

            <h1 class="font-extrabold text-slate-900 tracking-tight font-brand text-3xl sm:text-4xl lg:text-5xl xl:text-6xl leading-[1.15]">
              <span>Vietnamese isn’t hard.</span>
              <span class="block mt-1 sm:mt-2">
                You just need <span class="text-red-600">the right</span>
              </span>
              <span class="block mt-1">
                <span class="curved-underline text-red-600">approach.</span>
              </span>
            </h1>

            <p class="text-stone-600 text-sm sm:text-base lg:text-lg max-w-xl mx-auto lg:mx-0 leading-relaxed">
              Personalized, 1-on-1 online coaching tailored for beginners, expats, and heritage learners. No robotic textbook phrases — just real everyday conversations and precise pronunciation.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
              <button
                type="button"
                class="open-modal-trigger w-full sm:w-auto px-7 py-3.5 sm:py-4 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-2xl text-xs sm:text-sm shadow-xl shadow-red-600/25 transition hover:-translate-y-0.5 text-center flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>📅</span>
                <span>Book 25-Min Trial Lesson →</span>
              </button>
              <a
                href="/test"
                class="w-full sm:w-auto px-6 py-3.5 sm:py-4 bg-white hover:bg-stone-50 text-slate-900 font-bold rounded-2xl text-xs sm:text-sm border border-stone-200/90 transition text-center shadow-2xs flex items-center justify-center gap-2"
              >
                <span>Take Level Test</span>
                <span>📝</span>
              </a>
            </div>

            <div class="pt-5 border-t border-stone-200/80 flex flex-wrap items-center justify-center lg:justify-start gap-x-5 gap-y-2 text-[11px] sm:text-xs text-stone-600 font-medium">
              <div class="flex items-center gap-1.5"><span class="text-emerald-600 font-bold text-sm">✓</span> 1,200+ Hours Taught</div>
              <div class="flex items-center gap-1.5"><span class="text-emerald-600 font-bold text-sm">✓</span> Beginners & Expats</div>
              <div class="flex items-center gap-1.5"><span class="text-emerald-600 font-bold text-sm">✓</span> Slides & Audio Included</div>
            </div>
          </div>

          <!-- CỘT BÊN PHẢI: SUPER CARD -->
          <div class="lg:col-span-5 flex justify-center">
            <div class="w-full max-w-[420px] sm:max-w-[460px] bg-white rounded-[32px] p-7 sm:p-9 shadow-2xl shadow-stone-300/60 border border-stone-200/90 space-y-6 relative">
              
              <!-- Profile Header -->
              <div class="flex items-center gap-5 pb-5 border-b border-stone-100">
                <div class="w-18 sm:w-20 h-18 sm:h-20 rounded-2xl overflow-hidden shadow-md ring-2 ring-red-500/20 shrink-0 bg-stone-100">
                  <img 
                    src="/hang.jpg" 
                    alt="Hang Luu" 
                    class="w-full h-full object-cover"
                    onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center text-3xl\'>👩🏻‍🏫</div>';"
                  />
                </div>
                <div>
                  <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 leading-tight">Hang Luu</h2>
                  <p class="text-xs sm:text-sm text-stone-500 font-medium mt-0.5">Professional Vietnamese Tutor</p>
                  <div class="flex items-center gap-1 text-amber-500 text-xs sm:text-sm mt-1">
                    <span>★★★★★</span>
                    <span class="text-slate-900 font-bold font-mono ml-1">5.0</span>
                    <span class="text-stone-400 font-medium">(48 Reviews)</span>
                  </div>
                </div>
              </div>

              <!-- WHY TONES MATTER -->
              <div class="bg-stone-50/90 rounded-2xl p-4 sm:p-5 border border-stone-200/80 space-y-3">
                <div class="text-[11px] font-extrabold uppercase tracking-wider text-stone-400">Why Vietnamese Tones Matter:</div>
                <div class="grid grid-cols-3 gap-2.5 text-center">
                  <button onclick="playHeroAudio('ngang')" type="button" class="bg-white p-3.5 sm:p-4 rounded-2xl border border-stone-200/90 hover:border-red-500 hover:shadow-md transition cursor-pointer group">
                    <div class="text-sm sm:text-base font-extrabold text-red-600 font-brand group-hover:scale-105 transition-transform flex items-center justify-center gap-1">
                      <span>ma</span>
                      <span class="text-xs">🔊</span>
                    </div>
                    <div class="text-[11px] text-stone-500 mt-1 font-medium">Ghost 👻</div>
                  </button>
                  <button onclick="playHeroAudio('sac')" type="button" class="bg-white p-3.5 sm:p-4 rounded-2xl border border-stone-200/90 hover:border-red-500 hover:shadow-md transition cursor-pointer group">
                    <div class="text-sm sm:text-base font-extrabold text-red-600 font-brand group-hover:scale-105 transition-transform flex items-center justify-center gap-1">
                      <span>má</span>
                      <span class="text-xs">🔊</span>
                    </div>
                    <div class="text-[11px] text-stone-500 mt-1 font-medium">Mother 👩🏻</div>
                  </button>
                  <button onclick="playHeroAudio('hoi')" type="button" class="bg-white p-3.5 sm:p-4 rounded-2xl border border-stone-200/90 hover:border-red-500 hover:shadow-md transition cursor-pointer group">
                    <div class="text-sm sm:text-base font-extrabold text-red-600 font-brand group-hover:scale-105 transition-transform flex items-center justify-center gap-1">
                      <span>mả</span>
                      <span class="text-xs">🔊</span>
                    </div>
                    <div class="text-[11px] text-stone-500 mt-1 font-medium">Tomb ⚰️</div>
                  </button>
                </div>
              </div>

              <!-- EXPLORE FREE RESOURCES HUB -->
              <a
                href="/resources"
                class="flex items-center justify-between p-4 sm:p-4.5 rounded-2xl bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 transition text-white group cursor-pointer shadow-lg shadow-red-600/25"
              >
                <div class="flex items-center gap-3.5">
                  <span class="text-2xl">🎁</span>
                  <div class="text-left pt-0.5">
                    <div class="text-xs sm:text-sm font-bold leading-tight">Explore Free Resources Hub</div>
                    <div class="text-[11px] text-red-100 font-medium mt-0.5">Tones, Pronouns & Conversation Labs</div>
                  </div>
                </div>
                <span class="text-base font-bold text-white group-hover:translate-x-1 transition">→</span>
              </a>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ABOUT ME SECTION -->
    <section id="about" class="py-14 sm:py-20 bg-white">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
          
          <div class="lg:col-span-5 space-y-5">
            <div>
              <span class="text-xs font-extrabold text-red-600 uppercase tracking-widest bg-red-50 px-3 py-1 rounded-md border border-red-200 inline-block">About Me</span>
              <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-brand mt-2.5">
                Hi, I'm Hang!
              </h2>
            </div>

            <div class="relative w-full aspect-video rounded-3xl overflow-hidden shadow-xl border border-stone-200/90 bg-stone-900 ring-2 ring-stone-100">
              <iframe 
                src="https://player.vimeo.com/video/1156028562?badge=0&autopause=0&player_id=0&app_id=58479&title=0&byline=0&portrait=0" 
                class="absolute inset-0 w-full h-full border-0" 
                allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media" 
                title="Hang Luu - Preply Intro Video">
              </iframe>
            </div>
          </div>

          <div class="lg:col-span-7 space-y-4 sm:space-y-5 text-stone-600 text-sm sm:text-base leading-relaxed">
            
            <h3 class="text-base sm:text-xl font-extrabold text-slate-900 tracking-tight font-brand italic leading-snug bg-[#fffaf5] p-4 sm:p-5 rounded-2xl border border-stone-200/80 shadow-2xs">
              "This video helped me reach 100 students worldwide in just 7 months!"
            </h3>
            
            <p>
              Over 3 years of teaching Vietnamese, every lesson has been refined through hands-on experience, blending practical insights with 100% tailor-made materials.
            </p>

            <div class="pt-1">
              <p class="font-extrabold text-slate-900 mb-2.5 text-xs uppercase tracking-wider text-red-600">Perfect for:</p>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm text-stone-700">
                <li class="flex items-start gap-2.5 p-3 rounded-xl bg-stone-50 border border-stone-100">
                  <span class="text-red-600 font-bold shrink-0 mt-0.5">✓</span>
                  <span><strong class="text-slate-900 font-bold block">Absolute beginners</strong> starting from zero</span>
                </li>
                <li class="flex items-start gap-2.5 p-3 rounded-xl bg-stone-50 border border-stone-100">
                  <span class="text-red-600 font-bold shrink-0 mt-0.5">✓</span>
                  <span><strong class="text-slate-900 font-bold block">Heritage speakers</strong> reconnecting with roots</span>
                </li>
                <li class="flex items-start gap-2.5 p-3 rounded-xl bg-stone-50 border border-stone-100">
                  <span class="text-red-600 font-bold shrink-0 mt-0.5">✓</span>
                  <span><strong class="text-slate-900 font-bold block">Expats in Vietnam</strong> navigating daily work & life</span>
                </li>
                <li class="flex items-start gap-2.5 p-3 rounded-xl bg-stone-50 border border-stone-100">
                  <span class="text-red-600 font-bold shrink-0 mt-0.5">✓</span>
                  <span><strong class="text-slate-900 font-bold block">Partners & in-laws</strong> connecting deeply with Vietnamese spouses and family</span>
                </li>
              </ul>
            </div>

            <div class="relative overflow-hidden bg-gradient-to-r from-red-50/90 to-[#fffaf5] p-4 sm:p-5 rounded-2xl border-l-4 border-red-600 border-y border-r border-stone-200/80 shadow-xs mt-3">
              <p class="text-sm sm:text-lg font-extrabold text-slate-900 tracking-tight font-brand italic text-red-600">
                Let's speak real Vietnamese from Day 1!
              </p>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- LEARNING TRACKS -->
    <section id="curriculum" class="py-14 sm:py-20 bg-white">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16">
        <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
          <span class="text-xs font-bold text-red-600 uppercase tracking-widest">Tailored Programs</span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-2.5 tracking-tight font-brand">
            Find the Path That Fits Your Goals
          </h2>
          <p class="text-xs sm:text-base text-stone-600 mt-2 sm:mt-3 leading-relaxed">
            No generic syllabus. Every session is designed around your daily lifestyle, regional dialect (Northern or Southern), and natural pace.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch">
          
          <!-- Track 01 -->
          <div class="bg-[#fffaf5] rounded-3xl p-6 sm:p-8 border border-stone-200/90 shadow-2xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="inline-block text-[11px] font-bold text-slate-700 bg-stone-100 px-3 py-1 rounded-lg uppercase tracking-wider">
                Track 01 • 5–10 Sessions
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 mt-3.5 mb-2 font-brand">
                Pronunciation - Tones + Alphabet
              </h3>
              <p class="text-xs sm:text-sm text-stone-600 leading-relaxed mb-5">
                Master the foundations. Learn exact mouth and tongue mechanics for vowels, consonants, and the 6 tones from day one.
              </p>
              <ul class="space-y-3 text-xs sm:text-sm text-stone-700">
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold shrink-0 mt-0.5">✓</span>
                  <span>Step-by-step guidance on mouth, jaw, and lip positioning</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold shrink-0 mt-0.5">✓</span>
                  <span>Concrete real-world examples and interactive drills</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold shrink-0 mt-0.5">✓</span>
                  <span>Custom practice audio exercises included for every session</span>
                </li>
              </ul>
            </div>
            <div class="mt-8 pt-6 border-t border-stone-100">
              <button
                type="button"
                class="open-modal-trigger block w-full text-center py-3.5 bg-stone-100 hover:bg-stone-200 text-slate-900 font-bold rounded-xl text-xs transition cursor-pointer"
              >
                Book 25-Min Trial Lesson →
              </button>
            </div>
          </div>

          <!-- Track 02 (Featured) -->
          <div class="bg-[#fffaf5] rounded-3xl p-6 sm:p-8 border-2 border-red-600 shadow-xl relative flex flex-col justify-between md:-translate-y-3">
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-red-600 text-white text-[11px] font-extrabold px-4 py-1 rounded-full uppercase tracking-wider shadow-md whitespace-nowrap">
              🔥 Most Popular for Expats
            </div>
            <div>
              <div class="inline-block text-[11px] font-bold text-red-600 bg-red-50 px-3 py-1 rounded-lg border border-red-200 uppercase tracking-wider">
                Track 02 • 10–20 Sessions
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 mt-3.5 mb-2 font-brand">
                Real-World Street Vietnamese
              </h3>
              <p class="text-xs sm:text-sm text-stone-600 leading-relaxed mb-5">
                Cut through textbook stiffness. Speak natural, conversational Vietnamese for daily life, social settings, and travel.
              </p>
              <ul class="space-y-3 text-xs sm:text-sm text-stone-700">
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold shrink-0 mt-0.5">✓</span>
                  <span>Order food and refreshing drinks seamlessly at local spots</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold shrink-0 mt-0.5">✓</span>
                  <span>Communicate smoothly with ride-hailing drivers, delivery couriers, and neighbors</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold shrink-0 mt-0.5">✓</span>
                  <span>Master marketplace bargaining, checking costs, and everyday shopping</span>
                </li>
              </ul>
            </div>
            <div class="mt-8 pt-6 border-t border-stone-100">
              <button
                type="button"
                class="open-modal-trigger block w-full text-center py-3.5 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-xl text-xs transition shadow-lg shadow-red-600/20 hover:-translate-y-0.5 cursor-pointer"
              >
                Book 25-Min Trial Lesson →
              </button>
            </div>
          </div>

          <!-- Track 03 -->
          <div class="bg-[#fffaf5] rounded-3xl p-6 sm:p-8 border border-stone-200/90 shadow-2xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="inline-block text-[11px] font-bold text-slate-700 bg-stone-100 px-3 py-1 rounded-lg uppercase tracking-wider">
                Track 03 • Flexible / Ongoing
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 mt-3.5 mb-2 font-brand">
                Family & Heritage Roots
