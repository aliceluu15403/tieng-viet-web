---
// src/pages/conversation.astro - Dynamic Interactive Exercise Room
import Layout from '../layout.astro';
---

<Layout 
  title="Interactive Roleplay Conversations | Havie"
description="Interactive real-life Vietnamese roleplay conversations."
  canonical="https://havielearn.com/conversation"
>
  <Fragment slot="head">
    <style>
      #chatBox::-webkit-scrollbar {
        width: 6px;
      }
      #chatBox::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
      }
      #chatBox::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
      }
      #chatBox::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
      }
    </style>
  </Fragment>

  <!-- MAIN CONTENT -->
  <main class="flex-grow flex items-center justify-center py-12 sm:py-16 px-5 sm:px-8 relative">
    <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute top-1/2 left-[25%] -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] hero-glow rounded-full blur-3xl"></div>
    </div>

    <!-- KHUNG CHỌN GIỚI TÍNH -->
    <div id="roleSelectScreen" class="w-full max-w-lg bg-white rounded-[32px] p-8 sm:p-10 shadow-2xl border border-stone-200/90 text-center space-y-6">
      <div class="w-16 h-16 bg-red-50 text-red-600 rounded-2xl mx-auto flex items-center justify-center text-2xl shadow-inner border border-red-100">
        👤
      </div>
      <div class="space-y-2 font-brand">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-red-600 bg-red-50 px-3.5 py-1.5 rounded-full border border-red-200 inline-block">Roleplay Mode</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Choose Your Gender</h2>
        <p class="text-stone-500 text-xs sm:text-sm font-medium">
          How will the restaurant staff address you?
        </p>
      </div>

      <div class="grid grid-cols-1 gap-3.5 font-brand">
        <button type="button" onclick="setRole('anh')" class="p-4 rounded-2xl bg-stone-50 hover:bg-red-50 border border-stone-200 hover:border-red-300 font-bold text-sm text-slate-700 hover:text-red-600 transition cursor-pointer text-left flex items-center justify-between">
          <span>👨 I am Male ➔ Staff calls you <strong>"anh"</strong></span>
          <span>→</span>
        </button>
        <button type="button" onclick="setRole('chị')" class="p-4 rounded-2xl bg-stone-50 hover:bg-red-50 border border-stone-200 hover:border-red-300 font-bold text-sm text-slate-700 hover:text-red-600 transition cursor-pointer text-left flex items-center justify-between">
          <span>👩 I am Female ➔ Staff calls you <strong>"chị"</strong></span>
          <span>→</span>
        </button>
      </div>
    </div>

    <!-- KHUNG BÀI TẬP CHÍNH -->
    <div id="lessonScreen" class="hidden w-full max-w-3xl">
      <div class="bg-white rounded-[32px] p-8 sm:p-12 shadow-2xl border border-stone-200/90 space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-stone-100 font-brand">
          <div>
            <div class="flex items-center gap-2">
              <span id="lessonCategory" class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-md bg-stone-100 text-stone-700"></span>
              <span id="currentRoleBadge" class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-md bg-red-50 text-red-600 border border-red-200"></span>
            </div>
            <h2 id="lessonHeaderTitle" class="text-xl sm:text-2xl font-extrabold text-slate-900 font-brand mt-1"></h2>
          </div>
          <button id="resetTopBtn" type="button" class="text-xs font-bold text-stone-500 hover:text-red-600 transition bg-stone-50 px-4 py-2 rounded-xl border border-stone-200 cursor-pointer flex items-center gap-1.5">
            <span>Change Role / Restart</span> 🔄
          </button>
        </div>

        <!-- Khung chat -->
        <div id="chatBox" class="space-y-4 min-h-[120px] max-h-[380px] overflow-y-auto pr-2 flex flex-col"></div>

        <!-- Khung chọn câu trả lời -->
        <div id="choiceArea" class="pt-3 border-t border-stone-100"></div>
      </div>
    </div>
  </main>

  <!-- SCRIPT LOGIC -->
  <script is:inline>
    // Kiểm tra mã bảo mật URL
    const urlParams = new URLSearchParams(window.location.search);
    const rawCode = urlParams.get('code');
    const validCodes = ["FLN01", "FLN02", "FLS01", "WLN01", "WLS01", "SLN01", "SLS01", "FCS01", "AVB01", "KVN01", "KVS01"];
    const lessonCode = (rawCode || '').replace(/[\u200B-\u200D\uFEFF]/g, '').trim().toUpperCase();

    if (!validCodes.includes(lessonCode)) {
      window.location.href = '/student';
      throw new Error("Unauthorized access");
    }

    let userRole = {
      name: "anh",       
      selfCall: "anh"    
    };

    const exerciseDatabase = {
      "FCS01": {
        topic: "SOUTHERN RESTAURANT CONVERSATION",
        title: "Exercise: Ordering Food at a Restaurant (Southern accent)",
        getStep: function(state, role) {
          let capitalizedSelf = role.selfCall.charAt(0).toUpperCase() + role.selfCall.slice(1);
          let capitalizedName = role.name.charAt(0).toUpperCase() + role.name.slice(1);

          if (state.step === 0) {
            return {
              npc: `Dạ chào ${role.name}, mình đi mấy người ạ?`,
              choices: [
                { text: `${capitalizedSelf} đi 1 người`, count: 1 },
                { text: `${capitalizedSelf} đi 2 người`, count: 2 },
                { text: `${capitalizedSelf} đi 3 người`, count: 3 },
                { text: `${capitalizedSelf} đi 4 người`, count: 4 }
              ]
            };
          } else if (state.step === 1) {
            return {
              npc: `Dạ vâng, 1 bàn ${state.partyCount} người. Quán em có bánh mì, phở với cơm, ${role.name} muốn ăn gì ạ?`,
              choices: [
                { text: `Cho ${role.selfCall} bánh mì`, main: "bánh mì", type: "banhmi" },
                { text: `Cho ${role.selfCall} phở`, main: "phở", type: "pho" },
                { text: `Cho ${role.selfCall} cơm`, main: "cơm", type: "com" }
              ]
            };
          } else if (state.step === 2) {
            if (state.dishType === "pho") {
              return {
                npc: `Dạ, ${role.name} muốn ăn phở bò hay phở gà ạ?`,
                choices: [
                  { text: `Phở bò`, meat: "bò" },
                  { text: `Phở gà`, meat: "gà" }
                ]
              };
            } else {
              return {
                npc: `Dạ, ${role.name} muốn ăn bò hay gà ạ?`,
                choices: [
                  { text: `Thịt bò`, meat: "bò" },
                  { text: `Thịt gà`, meat: "gà" },
                ]
              };
            }
          } else if (state.step === 3) {
            if (state.dishType === "pho") {
              return {
                npc: `${capitalizedName} có ăn hành lá không ạ?`,
                choices: [
                  { text: "Có", detail: "có hành" },
                  { text: "Không", detail: "không hành" }
                ]
              };
            } else if (state.dishType === "banhmi") {
              return {
                npc: `${capitalizedName} có ăn rau ớt đầy đủ không ạ?`,
                choices: [
                  { text: "Không rau", detail: "không rau" },
                  { text: "Không ớt", detail: "không ớt" },
                  { text: "Không đồ chua", detail: "không đồ chua" },
                  { text: "Đầy đủ", detail: "đầy đủ rau ớt" }
                ]
              };
            } else {
              return {
                npc: `${capitalizedName} có ăn cay không ạ?`,
                choices: [
                  { text: "Có", detail: "cay" },
                  { text: "Không cay", detail: "không cay" }
                ]
              };
            }
          } else if (state.step === 4) {
            return {
              npc: `${capitalizedName} có muốn uống gì không ạ?`,
              choices: [
                { text: `Cho ${role.selfCall} ly coca`, drink: "coca" },
                { text: `Cho ${role.selfCall} ly trà đá`, drink: "trà đá" },
                { text: `Cho ${role.selfCall} ly nước lọc`, drink: "nước lọc" },
                { text: `Không, cảm ơn`, drink: "" }
              ]
            };
          } else if (state.step === 5) {
            let dishName = state.dishType === "pho" ? `phở ${state.selectedMeat}` : `${state.selectedMain} ${state.selectedMeat}`;
            let summary = `Dạ vậy ${role.name} gọi ${dishName}`;
            if (state.selectedDetail) summary += `, ${state.selectedDetail}`;
            if (state.selectedDrink) summary += ` và ${state.selectedDrink}`;

            return {
              npc: summary,
              isConfirm: true
            };
          } else if (state.step === 6) {
            return {
              npc: `Dạ của mình là 60k ạ.`,
              isPayment: true,
              choices: [
                { text: "Đưa tờ 60k (Đúng tiền)", amount: 60 },
                { text: "Đưa tờ 100k", amount: 100 },
                { text: "Đưa tờ 200k", amount: 200 }
              ]
            };
          }
          return null;
        }
      }
    };

    const roleSelectScreen = document.getElementById('roleSelectScreen');
    const lessonScreen = document.getElementById('lessonScreen');
    const lessonCategory = document.getElementById('lessonCategory');
    const currentRoleBadge = document.getElementById('currentRoleBadge');
    const lessonHeaderTitle = document.getElementById('lessonHeaderTitle');
    const chatBox = document.getElementById('chatBox');
    const choiceArea = document.getElementById('choiceArea');
    const resetTopBtn = document.getElementById('resetTopBtn');

    let currentState = {
      step: 0,
      partyCount: 1,
      dishType: "",
      selectedMain: "",
      selectedMeat: "",
      selectedDetail: "",
      selectedDrink: ""
    };

    window.setRole = function(gender) {
      userRole = {
        name: gender,      
        selfCall: gender   
      };

      roleSelectScreen.classList.add('hidden');
      lessonScreen.classList.remove('hidden');
      startLesson();
    };

    function startLesson() {
      currentState = { step: 0, partyCount: 1, dishType: "", selectedMain: "", selectedMeat: "", selectedDetail: "", selectedDrink: "" };
      chatBox.innerHTML = "";

      const lesson = exerciseDatabase[lessonCode] || exerciseDatabase["FCS01"];
      lessonCategory.textContent = lesson.topic;
      currentRoleBadge.textContent = `Role: ${userRole.name}`;
      lessonHeaderTitle.textContent = lesson.title;
      renderCurrentStep();
    }

    function scrollToBottom() {
      setTimeout(() => {
        chatBox.scrollTop = chatBox.scrollHeight;
      }, 50);
    }

    function renderCurrentStep() {
      const lesson = exerciseDatabase[lessonCode] || exerciseDatabase["FCS01"];
      const stepData = lesson.getStep(currentState, userRole);

      let npcBubble = document.createElement('div');
      npcBubble.className = "flex items-center gap-3 shrink-0";
      npcBubble.innerHTML = `
        <div class="w-9 h-9 rounded-full bg-red-100 text-red-600 flex items-center justify-center font-bold text-sm shrink-0">👩🏻‍🍳</div>
        <div class="p-4 rounded-2xl bg-stone-100 text-slate-800 text-sm sm:text-base max-w-[85%] leading-relaxed font-medium">
          ${stepData.npc}
        </div>
      `;
      chatBox.appendChild(npcBubble);
      scrollToBottom();

      if (stepData.isConfirm) {
        choiceArea.innerHTML = `
          <div class="space-y-3 font-brand">
            <div class="text-xs sm:text-sm font-bold text-slate-700">💡 How to say: <span class="text-red-600 font-extrabold">"I want to pay"</span>?</div>
            <div>
              <button type="button" id="hintBtn" class="w-full py-4 px-5 bg-red-50 hover:bg-red-100 text-red-600 font-bold rounded-2xl text-xs sm:text-sm transition border border-red-200 cursor-pointer flex items-center justify-center gap-2">
                <span>Need hint</span> 🔍
              </button>
            </div>
            <div id="hintOptions" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <button type="button" class="pay-option p-4 rounded-2xl bg-stone-50 hover:bg-red-50 border border-stone-200 text-xs sm:text-sm font-bold text-slate-700 text-center transition cursor-pointer" data-text="Em ơi, tính tiền!">
                <span>Em ơi, tính tiền!</span>
              </button>
              <button type="button" class="pay-option p-4 rounded-2xl bg-stone-50 hover:bg-red-50 border border-stone-200 text-xs sm:text-sm font-bold text-slate-700 text-center transition cursor-pointer" data-text="Cho ${userRole.selfCall} xin cái hóa đơn!">
                <span>Cho ${userRole.selfCall} xin cái hóa đơn!</span>
              </button>
            </div>
          </div>
        `;

        document.getElementById('hintBtn').addEventListener('click', () => {
          document.getElementById('hintOptions').classList.toggle('hidden');
          scrollToBottom();
        });

        document.querySelectorAll('.pay-option').forEach(btn => {
          btn.addEventListener('click', (e) => {
            selectChoice(e.currentTarget.getAttribute('data-text'));
          });
        });
        return;
      }

      choiceArea.innerHTML = `
        <div class="text-xs font-extrabold text-stone-400 uppercase tracking-wider mb-3 font-brand">Choose your response:</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5" id="choiceBtnsContainer"></div>
      `;

      const container = document.getElementById('choiceBtnsContainer');
      stepData.choices.forEach((choice) => {
        let btn = document.createElement('button');
        btn.type = "button";
        btn.className = "p-4 rounded-2xl bg-stone-50 hover:bg-red-50 border border-stone-200 hover:border-red-300 text-center transition cursor-pointer shadow-2xs group font-bold text-xs sm:text-sm text-slate-700 hover:text-red-600 font-brand";
        btn.textContent = choice.text;

        btn.addEventListener('click', () => {
          if (currentState.step === 0) {
            currentState.partyCount = choice.count;
          } else if (currentState.step === 1) {
            currentState.selectedMain = choice.main;
            currentState.dishType = choice.type;
          } else if (currentState.step === 2) {
            currentState.selectedMeat = choice.meat;
          } else if (currentState.step === 3) {
            currentState.selectedDetail = choice.detail;
          } else if (currentState.step === 4) {
            currentState.selectedDrink = choice.drink;
          } else if (currentState.step === 6) {
            handlePayment(choice.amount);
            return;
          }

          appendStudentBubble(choice.text);
          currentState.step++;
          renderCurrentStep();
        });

        container.appendChild(btn);
      });
    }

    function selectChoice(text) {
      appendStudentBubble(text);
      currentState.step++;
      renderCurrentStep();
    }

    function handlePayment(paidAmount) {
      appendStudentBubble(`Đưa tờ ${paidAmount}k`);

      let responseText = "";
      if (paidAmount === 60) {
        responseText = `Dạ em nhận của ${userRole.name} ${paidAmount}k. Em cảm ơn ${userRole.name} ạ!`;
      } else {
        let excess = paidAmount - 60;
        responseText = `Dạ em nhận của ${userRole.name} ${paidAmount}k, em thối lại ${excess}k. Em cảm ơn ${userRole.name} ạ!`;
      }

      setTimeout(() => {
        let npcBubble = document.createElement('div');
        npcBubble.className = "flex items-center gap-3 shrink-0";
        npcBubble.innerHTML = `
          <div class="w-9 h-9 rounded-full bg-red-100 text-red-600 flex items-center justify-center font-bold text-sm shrink-0">👩🏻‍🍳</div>
          <div class="p-4 rounded-2xl bg-stone-100 text-slate-800 text-sm sm:text-base max-w-[85%] leading-relaxed font-medium">
            ${responseText}
          </div>
        `;
        chatBox.appendChild(npcBubble);
        scrollToBottom();

        choiceArea.innerHTML = `
          <div class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-center space-y-3 mt-2 font-brand">
            <div class="text-sm sm:text-base font-bold text-emerald-800">🎉 Excellent! You have completed the conversation.</div>
            <button type="button" id="resetBtn" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs sm:text-sm transition cursor-pointer inline-flex items-center gap-2">
              <span>Start Over</span> 🔄
            </button>
          </div>
        `;
        document.getElementById('resetBtn').addEventListener('click', () => {
          lessonScreen.classList.add('hidden');
          roleSelectScreen.classList.remove('hidden');
        });
      }, 500);
    }

    function appendStudentBubble(text) {
      let studentBubble = document.createElement('div');
      studentBubble.className = "flex items-center justify-end gap-3 shrink-0";
      studentBubble.innerHTML = `
        <div class="p-4 rounded-2xl bg-red-600 text-white text-sm sm:text-base max-w-[85%] leading-relaxed font-medium shadow-sm">
          ${text}
        </div>
        <div class="w-9 h-9 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-sm">🎓</div>
      `;
      chatBox.appendChild(studentBubble);
      scrollToBottom();
    }

    resetTopBtn.addEventListener('click', () => {
      lessonScreen.classList.add('hidden');
      roleSelectScreen.classList.remove('hidden');
    });
  </script>
</Layout>